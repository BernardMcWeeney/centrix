{
	"name": "centrix",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"send_email": [
		{
			"name": "CONTACT_EMAIL",
			"destination_address": "hello@centrix.ie"
		}
	],
	"upload_source_maps": true
}
