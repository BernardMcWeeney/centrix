---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const title = "Blog";
const description = "Insights, tutorials, and news about IT security, Microsoft 365, and enterprise technology.";

const featuredPost = posts[0];
const recentPosts = posts.slice(1, 7);
---

<BaseLayout title={title} description={description}>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container-wide">
      <div class="hero-content">
        <div class="hero-eyebrow">Blog</div>
        <h1 class="hero-title">Insights & Resources</h1>
        <p class="hero-description">
          Expert perspectives on cybersecurity, Microsoft 365, and enterprise IT.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured Post -->
  {featuredPost && (
    <section class="featured-section">
      <div class="container-wide">
        <a href={`/blog/${featuredPost.id}/`} class="featured-card">
          <div class="featured-image">
            {featuredPost.data.heroImage ? (
              <img src={featuredPost.data.heroImage} alt={featuredPost.data.title} loading="eager" />
            ) : (
              <div class="featured-placeholder">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                  <path d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                </svg>
              </div>
            )}
          </div>
          <div class="featured-content">
            <div class="featured-meta">
              <span class="featured-badge">Featured</span>
              <span class="featured-date"><FormattedDate date={featuredPost.data.pubDate} /></span>
            </div>
            <h2 class="featured-title">{featuredPost.data.title}</h2>
            <p class="featured-excerpt">{featuredPost.data.description}</p>
            <span class="featured-link">
              Read article
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- Recent Posts -->
  <section class="posts-section">
    <div class="container-wide">
      <div class="section-header">
        <h2 class="section-title">Recent Articles</h2>
      </div>

      {recentPosts.length > 0 ? (
        <div class="posts-grid">
          {recentPosts.map((post) => (
            <a href={`/blog/${post.id}/`} class="post-card">
              <div class="post-image">
                {post.data.heroImage ? (
                  <img src={post.data.heroImage} alt={post.data.title} loading="lazy" />
                ) : (
                  <div class="post-placeholder">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                      <path d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                    </svg>
                  </div>
                )}
              </div>
              <div class="post-content">
                <span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
                <h3 class="post-title">{post.data.title}</h3>
                <p class="post-excerpt">{post.data.description}</p>
                <span class="post-link">
                  Read more
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <h3 class="empty-title">No articles yet</h3>
          <p class="empty-description">Check back soon for security insights and tutorials.</p>
        </div>
      )}
    </div>
  </section>

  <!-- Newsletter Section -->
  <section class="newsletter-section">
    <div class="container-wide">
      <div class="newsletter-card">
        <div class="newsletter-content">
          <h2 class="newsletter-title">Stay ahead of threats</h2>
          <p class="newsletter-description">Get the latest security insights delivered to your inbox.</p>
        </div>
        <form class="newsletter-form">
          <input type="email" placeholder="Enter your email" class="newsletter-input" required />
          <button type="submit" class="btn btn-primary">
            Subscribe
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding: 8rem 0 4rem;
    background-color: var(--bg-secondary);
    border-bottom: 1px solid var(--border-primary);
  }

  @media (min-width: 768px) {
    .hero { padding: 10rem 0 5rem; }
  }

  .hero-content {
    max-width: 32rem;
  }

  .hero-eyebrow {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--brand-primary);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .hero-title { font-size: 3rem; }
  }

  .hero-description {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  /* Featured */
  .featured-section {
    padding: 3rem 0;
  }

  .featured-card {
    display: grid;
    grid-template-columns: 1fr;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: 0.5rem;
    overflow: hidden;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  @media (min-width: 1024px) {
    .featured-card { grid-template-columns: 1fr 1fr; }
  }

  .featured-card:hover {
    border-color: var(--brand-primary);
    box-shadow: var(--shadow-md);
  }

  .featured-image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--bg-secondary);
  }

  @media (min-width: 1024px) {
    .featured-image { aspect-ratio: auto; min-height: 20rem; }
  }

  .featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .featured-card:hover .featured-image img {
    transform: scale(1.03);
  }

  .featured-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
  }

  .featured-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .featured-content { padding: 2rem; }
  }

  .featured-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .featured-badge {
    padding: 0.125rem 0.5rem;
    background-color: var(--brand-primary);
    color: white;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 9999px;
  }

  .featured-date {
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }

  .featured-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  @media (min-width: 768px) {
    .featured-title { font-size: 1.5rem; }
  }

  .featured-excerpt {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .featured-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--brand-primary);
    transition: gap 0.15s ease;
  }

  .featured-card:hover .featured-link {
    gap: 0.5rem;
  }

  /* Posts */
  .posts-section {
    padding: 4rem 0;
    background-color: var(--bg-secondary);
  }

  @media (min-width: 768px) {
    .posts-section { padding: 5rem 0; }
  }

  .section-header {
    margin-bottom: 2rem;
  }

  .section-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .posts-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .posts-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .post-card {
    background-color: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: 0.5rem;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: all 0.15s ease;
  }

  .post-card:hover {
    border-color: var(--brand-primary);
    box-shadow: var(--shadow-sm);
  }

  .post-image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--bg-secondary);
  }

  .post-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .post-card:hover .post-image img {
    transform: scale(1.03);
  }

  .post-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
  }

  .post-content {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .post-date {
    font-size: 0.6875rem;
    color: var(--text-tertiary);
    margin-bottom: 0.5rem;
  }

  .post-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }

  .post-excerpt {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.75rem;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--brand-primary);
    transition: gap 0.15s ease;
  }

  .post-card:hover .post-link {
    gap: 0.375rem;
  }

  /* Empty State */
  .empty-state {
    text-align: center;
    padding: 3rem 1.5rem;
  }

  .empty-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.375rem;
  }

  .empty-description {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  /* Newsletter */
  .newsletter-section {
    padding: 0 0 4rem;
    background-color: var(--bg-secondary);
  }

  @media (min-width: 768px) {
    .newsletter-section { padding: 0 0 5rem; }
  }

  .newsletter-card {
    background-color: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: 0.5rem;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .newsletter-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 2rem;
    }
  }

  .newsletter-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .newsletter-description {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 480px) {
    .newsletter-form { flex-direction: row; }
  }

  .newsletter-input {
    flex: 1;
    padding: 0.625rem 0.875rem;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: 0.375rem;
    font-size: 0.875rem;
    color: var(--text-primary);
    min-width: 14rem;
  }

  .newsletter-input::placeholder {
    color: var(--text-muted);
  }

  .newsletter-input:focus {
    outline: none;
    border-color: var(--brand-primary);
  }
</style>
