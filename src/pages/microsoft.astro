---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteIcon from '../components/SiteIcon.astro';
import PlatformLogo from '../components/PlatformLogo.astro';

const title = 'Microsoft Cloud Services For Irish Businesses';
const description = 'Microsoft 365, Azure, Intune, Defender, identity, migration, and Copilot readiness services for Irish businesses.';

const services = [
  {
    title: 'Move to Microsoft cloud',
    description: 'Plan and deliver email, file, identity, and device migration to Microsoft 365 and Azure with controlled changeover.',
    href: '/services/microsoft-365/cloud-migration',
    icon: 'cloud',
  },
  {
    title: 'Microsoft 365 security',
    description: 'MFA, Conditional Access, Secure Score improvement, Defender, anti-phishing, audit logging, and tenant hardening.',
    href: '/services/microsoft-365',
    icon: 'lock',
  },
  {
    title: 'Intune device management',
    description: 'Modern endpoint management for Windows, macOS, iOS, and Android with compliance policies and app deployment.',
    href: '/services/intune',
    icon: 'device',
  },
  {
    title: 'Identity and access',
    description: 'Entra ID, MFA rollout, privileged access, break-glass accounts, guest access, and secure sign-in policies.',
    href: '/services/identity',
    icon: 'users',
  },
  {
    title: 'Defender protection',
    description: 'Microsoft Defender for endpoint, email, identity, and cloud apps configured for usable alerts and response.',
    href: '/services/microsoft-365',
    icon: 'shield',
  },
  {
    title: 'Copilot readiness',
    description: 'Prepare SharePoint, permissions, sensitivity labels, and governance before enabling Microsoft 365 Copilot.',
    href: '/services/ai-services/copilot-readiness',
    icon: 'ai',
  },
];

const checklist = [
  'Email and domain migration planning',
  'SharePoint and OneDrive structure',
  'MFA and Conditional Access baseline',
  'Intune enrolment and device compliance',
  'Defender policies and alert tuning',
  'Backup, retention, and recovery review',
  'Admin role and privileged access review',
  'User handover and plain-English documentation',
];
---

<BaseLayout title={title} description={description}>
  <main class="consult-page">
    <section class="consult-subhero">
      <div class="container-wide">
        <div class="consult-subhero-grid">
          <div>
            <div class="consult-eyebrow">Microsoft Cloud</div>
            <h1 class="consult-subhero-title">Move to Microsoft, secure it properly, and manage it with confidence.</h1>
            <p class="consult-lead">
              Centrix helps Irish businesses get practical value from Microsoft 365, Azure, Intune, Defender, Entra ID, and Copilot without leaving security and governance behind.
            </p>
            <div class="consult-actions">
              <a href="/services/microsoft-365/cloud-migration" class="consult-btn consult-btn-primary">
                Plan a cloud move
                <SiteIcon name="arrow-right" size={18} />
              </a>
              <a href="/contact" class="consult-btn consult-btn-secondary">Talk to Centrix</a>
            </div>
          </div>
          <aside class="consult-proof-panel">
            <h2>Common Microsoft needs</h2>
            <ul>
              <li><SiteIcon name="check" size={18} /><span>Move email and files to the cloud</span></li>
              <li><SiteIcon name="check" size={18} /><span>Secure Microsoft 365 after growth or change</span></li>
              <li><SiteIcon name="check" size={18} /><span>Manage laptops and phones with Intune</span></li>
              <li><SiteIcon name="check" size={18} /><span>Prepare safely for Copilot and AI</span></li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    <section class="consult-section compact">
      <div class="container-wide">
        <div class="platform-strip">
          <PlatformLogo name="microsoft" />
          <PlatformLogo name="google" />
          <PlatformLogo name="cloudflare" />
          <PlatformLogo name="microsoft" label="Defender" />
          <PlatformLogo name="microsoft" label="Intune" />
          <PlatformLogo name="microsoft" label="Copilot" />
        </div>
      </div>
    </section>

    <section class="consult-section">
      <div class="container-wide">
        <div class="consult-section-heading">
          <span class="consult-kicker">Microsoft Services</span>
          <h2>Everything your business needs around the Microsoft platform.</h2>
        </div>
        <div class="consult-card-grid three">
          {services.map((service) => (
            <a href={service.href} class="consult-card">
              <div class="consult-card-icon"><SiteIcon name={service.icon} size={24} /></div>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              <span class="consult-card-link">
                View details
                <SiteIcon name="arrow-right" size={16} />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="consult-section consult-section-muted">
      <div class="container-wide">
        <div class="consult-split">
          <div>
            <span class="consult-kicker">Good Cloud Foundations</span>
            <h2>A Microsoft tenant should be useful, secure, and easy to operate.</h2>
            <p>
              We focus on the controls that reduce day-to-day risk: identity, devices, email protection, data structure, backup thinking, and clear admin practices.
            </p>
          </div>
          <div class="consult-check-list">
            {checklist.map((item) => (
              <div class="consult-check-item">
                <SiteIcon name="check" size={18} />
                <span>{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="consult-cta">
      <div class="container-wide">
        <div class="consult-cta-inner">
          <div>
            <span class="consult-kicker">Next Step</span>
            <h2>Start with a cloud migration plan, Microsoft 365 review, or Intune rollout.</h2>
          </div>
          <a href="/contact" class="consult-btn consult-btn-primary">
            Book a Microsoft consultation
            <SiteIcon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
