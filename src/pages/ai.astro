---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteIcon from '../components/SiteIcon.astro';
import PlatformLogo from '../components/PlatformLogo.astro';

const title = 'AI Introduction And Automation Consultancy';
const description = 'Simple business introduction to AI using ChatGPT, Claude, Microsoft Copilot, Cloudflare AI, governance, workflow automation, and safe adoption support.';

const services = [
  {
    title: 'AI introduction workshop',
    description: 'Plain-English introduction to ChatGPT, Claude, Copilot, Cloudflare AI, prompts, risks, and useful business workflows.',
    href: '/services/ai-services/business-ai-automation',
    icon: 'ai',
  },
  {
    title: 'Microsoft Copilot readiness',
    description: 'Check SharePoint permissions, sensitivity labels, guest access, data hygiene, and rollout readiness before Copilot goes live.',
    href: '/services/ai-services/copilot-readiness',
    icon: 'microsoft',
  },
  {
    title: 'AI governance and policy',
    description: 'Create simple rules for staff, data, approved tools, review, and management oversight.',
    href: '/services/ai-services',
    icon: 'compliance',
  },
  {
    title: 'Workflow automation',
    description: 'Use Microsoft 365, Power Platform, and AI-assisted workflows to reduce repetitive admin work.',
    href: '/services/ai-services/business-ai-automation',
    icon: 'settings',
  },
  {
    title: 'AI strategy',
    description: 'Identify realistic use cases, expected value, risks, controls, and a phased implementation roadmap.',
    href: '/services/ai-services/ai-strategy',
    icon: 'ai',
  },
];

const readiness = [
  'Simple introduction to ChatGPT, Claude, and Copilot',
  'Approved AI tools and use cases agreed',
  'SharePoint and Teams permissions reviewed',
  'Sensitive data locations understood',
  'Security and data protection controls included',
  'Prompt guidance for common staff workflows',
  'Cloudflare AI and web security options considered',
  'Management has clear success measures',
];
---

<BaseLayout title={title} description={description}>
  <main class="consult-page">
    <section class="consult-subhero">
      <div class="container-wide">
        <div class="consult-subhero-grid">
          <div>
            <div class="consult-eyebrow">AI & Automation</div>
            <h1 class="consult-subhero-title">A simple, safe introduction to AI for your business.</h1>
            <p class="consult-lead">
              Centrix helps Irish businesses understand ChatGPT, Claude, Microsoft Copilot, Cloudflare AI, and automation tools, then apply them to real work without exposing sensitive data.
            </p>
            <div class="consult-actions">
              <a href="/services/ai-services/business-ai-automation" class="consult-btn consult-btn-primary">
                Book an AI introduction
                <SiteIcon name="arrow-right" size={18} />
              </a>
              <a href="/services/ai-services/copilot-readiness" class="consult-btn consult-btn-secondary">Prepare for Copilot</a>
            </div>
          </div>
          <aside class="consult-proof-panel">
            <h2>AI should be</h2>
            <ul>
              <li><SiteIcon name="check" size={18} /><span>Tied to a clear business workflow</span></li>
              <li><SiteIcon name="check" size={18} /><span>Controlled so sensitive data stays protected</span></li>
              <li><SiteIcon name="check" size={18} /><span>Introduced with staff guidance and ownership</span></li>
              <li><SiteIcon name="check" size={18} /><span>Measured before it is scaled wider</span></li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    <section class="consult-section compact">
      <div class="container-wide">
        <div class="platform-strip">
          <PlatformLogo name="chatgpt" />
          <PlatformLogo name="claude" />
          <PlatformLogo name="microsoft" label="Copilot" />
          <PlatformLogo name="cloudflare" />
          <PlatformLogo name="google" />
          <PlatformLogo name="microsoft" label="Power Platform" />
        </div>
      </div>
    </section>

    <section class="consult-section">
      <div class="container-wide">
        <div class="consult-section-heading">
          <span class="consult-kicker">AI Services</span>
          <h2>Practical AI support without the hype.</h2>
        </div>
        <div class="consult-card-grid four">
          {services.map((service) => (
            <a href={service.href} class="consult-card">
              <div class="consult-card-icon"><SiteIcon name={service.icon} size={24} /></div>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              <span class="consult-card-link">
                View service
                <SiteIcon name="arrow-right" size={16} />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="consult-section consult-section-muted">
      <div class="container-wide">
        <div class="consult-split">
          <div>
            <span class="consult-kicker">Copilot Readiness</span>
            <h2>Before AI sees your data, check what your users and tools can already see.</h2>
            <p>
              AI tools can make existing data, permission, and process problems more visible. We help set sensible rules before staff rely on them.
            </p>
          </div>
          <div class="consult-check-list">
            {readiness.map((item) => (
              <div class="consult-check-item">
                <SiteIcon name="check" size={18} />
                <span>{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="consult-cta">
      <div class="container-wide">
        <div class="consult-cta-inner">
          <div>
            <span class="consult-kicker">Next Step</span>
            <h2>Start with a short AI introduction workshop or Copilot readiness review.</h2>
          </div>
          <a href="/contact" class="consult-btn consult-btn-primary">
            Book an AI consultation
            <SiteIcon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
