---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY_INFO } from '../consts';

const title = "Contact Centrix";
const description = "Message Centrix about Irish business IT consultancy, Microsoft cloud, business networking, VPNs, VoIP, security, compliance readiness, and AI services.";
const turnstileSiteKey = "0x4AAAAAAAWsI1fJREzBYF91";
const canonicalUrl = new URL('/contact/', Astro.site || Astro.url.origin).toString();

const contactMethods = [
  {
    title: "Email Centrix",
    description: "Send a project, support, or consultancy enquiry.",
    value: COMPANY_INFO.email,
    href: `mailto:${COMPANY_INFO.email}`,
    icon: "email",
  },
  {
    title: "Based In",
    description: "Irish business technology consultancy.",
    value: COMPANY_INFO.address,
    icon: "location",
  },
];

const services = [
  "Microsoft Cloud Migration",
  "Microsoft 365 Security",
  "Business Networking",
  "VPN & Remote Access",
  "Backup, DR & Resilience",
  "VoIP & Business Phones",
  "Business Wi-Fi",
  "CCTV & IP Cameras",
  "NIS2 & GDPR Readiness",
  "AI Introduction & Automation",
  "Managed IT Support",
  "Other",
];

const faqs = [
  {
    q: "What should I include in my message?",
    a: "Tell us the business issue, location, number of users or sites, current platforms, and any deadline. A short summary is enough to start.",
  },
  {
    q: "Do you work on site?",
    a: "Yes, especially for networking, VPN, VoIP, Wi-Fi, CCTV, and premises technology projects. Microsoft, security, and AI work can often be delivered remotely.",
  },
  {
    q: "What size businesses do you work with?",
    a: "Centrix works with Irish businesses that need practical technology guidance, secure Microsoft cloud, reliable site networks, or ongoing IT support.",
  },
  {
    q: "How long does implementation typically take?",
    a: "Timelines depend on scope. Small Microsoft reviews can be short, while migrations, networking, VPN, VoIP, Wi-Fi, or CCTV projects need proper survey, planning, and rollout.",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://centrix.ie/#organization",
      "name": COMPANY_INFO.name,
      "url": "https://centrix.ie/",
      "email": COMPANY_INFO.email,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Duleek",
        "addressRegion": "County Meath",
        "addressCountry": "IE"
      },
      "areaServed": {
        "@type": "Country",
        "name": "Ireland"
      }
    },
    {
      "@type": "ContactPage",
      "@id": `${canonicalUrl}#contact-page`,
      "url": canonicalUrl,
      "name": "Contact Centrix",
      "description": description,
      "mainEntity": {
        "@id": "https://centrix.ie/#organization"
      }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    }
  ]
};
---

<BaseLayout title={title} description={description}>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container-wide">
      <div class="hero-content">
        <div class="hero-eyebrow">Contact</div>
        <h1 class="hero-title">Message Centrix</h1>
        <p class="hero-description">
          Send a message about Microsoft cloud, business networking, VPNs, VoIP, Wi-Fi, CCTV, security, compliance readiness, AI, or general business IT consultancy.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="contact-section">
    <div class="container-wide">
      <div class="contact-grid">
        <!-- Contact Form -->
        <div class="form-section">
          <h2 class="form-title">Send a message</h2>
          <form class="contact-form" action="/api/contact" method="POST" data-contact-form data-turnstile-configured="false">
            <div class="form-row">
              <div class="form-group">
                <label for="firstName" class="form-label">First Name</label>
                <input type="text" id="firstName" name="firstName" required class="form-input" placeholder="John" />
              </div>
              <div class="form-group">
                <label for="lastName" class="form-label">Last Name</label>
                <input type="text" id="lastName" name="lastName" required class="form-input" placeholder="Doe" />
              </div>
            </div>

            <div class="form-group">
              <label for="email" class="form-label">Email</label>
              <input type="email" id="email" name="email" required class="form-input" placeholder="john@company.com" />
            </div>

            <div class="form-group">
              <label for="company" class="form-label">Company</label>
              <input type="text" id="company" name="company" class="form-input" placeholder="Company Ltd" />
            </div>

            <div class="form-group">
              <label for="service" class="form-label">Service Interested In</label>
              <select id="service" name="service" class="form-select">
                <option value="">Select a service</option>
                {services.map((service) => (
                  <option value={service}>{service}</option>
                ))}
              </select>
            </div>

            <div class="form-group">
              <label for="message" class="form-label">Message</label>
              <textarea id="message" name="message" rows="4" required class="form-textarea" placeholder="Tell us about the technology issue, project, site, or deadline..."></textarea>
            </div>

            <div class="turnstile-wrap" data-turnstile-wrap>
              <div class="cf-turnstile" data-turnstile-widget data-sitekey={turnstileSiteKey}></div>
              <p class="turnstile-config-warning" data-turnstile-warning hidden>
                Contact form security is not configured yet. Please email <a href={`mailto:${COMPANY_INFO.email}`}>{COMPANY_INFO.email}</a>.
              </p>
            </div>

            <p class="form-status" data-form-status aria-live="polite"></p>

            <button type="submit" class="btn btn-primary btn-lg submit-btn">
              Send Message
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </button>
          </form>
        </div>

        <!-- Contact Info -->
        <div class="info-section">
          <h2 class="info-title">Message details</h2>
          <p class="info-description">Use the form or email Centrix directly with a short summary of the project, issue, location, and deadline.</p>

          <div class="contact-methods">
            {contactMethods.map((method) => (
              <div class="contact-card">
                <div class="contact-icon">
                  {method.icon === "email" && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                    </svg>
                  )}
                  {method.icon === "location" && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                    </svg>
                  )}
                </div>
                <div class="contact-content">
                  <h3 class="contact-title">{method.title}</h3>
                  <p class="contact-description">{method.description}</p>
                  {method.href ? (
                    <a href={method.href} class="contact-link">{method.value}</a>
                  ) : (
                    <span class="contact-value">{method.value}</span>
                  )}
                </div>
              </div>
            ))}
          </div>

          <div class="response-card">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
              <h3 class="response-title">Fast Response Time</h3>
              <p class="response-description">We aim to respond within one business day</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq-section">
    <div class="container-wide">
      <div class="section-header">
        <div class="section-eyebrow">FAQ</div>
        <h2 class="section-title">Frequently Asked Questions</h2>
      </div>

      <div class="faq-grid">
        {faqs.map((faq) => (
          <div class="faq-card">
            <h3 class="faq-question">{faq.q}</h3>
            <p class="faq-answer">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>

<script>
  function initContactForm() {
    const form = document.querySelector('[data-contact-form]') as HTMLFormElement | null;

    if (!form || form.dataset.bound === 'true') {
      return;
    }

    form.dataset.bound = 'true';

    const status = form.querySelector('[data-form-status]') as HTMLElement | null;
    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const defaultButtonHtml = submitButton?.innerHTML || '';
    const turnstileWidget = form.querySelector('[data-turnstile-widget]') as HTMLElement | null;
    const turnstileWarning = form.querySelector('[data-turnstile-warning]') as HTMLElement | null;

    renderTurnstile(form, turnstileWidget, turnstileWarning, status);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (status) {
        status.textContent = '';
        status.className = 'form-status';
      }

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = 'Sending...';
      }

      try {
        if (form.dataset.turnstileConfigured !== 'true') {
          throw new Error('Contact form security is still loading. Please try again in a moment.');
        }

        const turnstileResponse = form.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement | null;
        if (!turnstileResponse?.value) {
          throw new Error('Please complete the security check before sending.');
        }

        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok || !result.success) {
          throw new Error(result.message || 'Something went wrong. Please try again.');
        }

        if (status) {
          status.textContent = result.message || 'Thanks. Your message has been sent.';
          status.classList.add('success');
        }

        form.reset();
        resetTurnstile(turnstileWidget);
      } catch (error) {
        if (status) {
          status.textContent = error instanceof Error ? error.message : 'Something went wrong. Please try again.';
          status.classList.add('error');
        }
        resetTurnstile(turnstileWidget);
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.innerHTML = defaultButtonHtml;
        }
      }
    });
  }

  initContactForm();
  document.addEventListener('astro:after-swap', initContactForm);

  async function renderTurnstile(
    form: HTMLFormElement,
    widget: HTMLElement | null,
    warning: HTMLElement | null,
    status: HTMLElement | null
  ) {
    if (!widget || widget.dataset.rendering === 'true' || widget.dataset.widgetId) {
      return;
    }

    widget.dataset.rendering = 'true';

    try {
      const siteKey = widget.dataset.sitekey;

      if (!siteKey) {
        throw new Error('Turnstile site key is not configured.');
      }

      await waitForTurnstile();

      const widgetId = (window as any).turnstile.render(widget, {
        sitekey: siteKey,
        callback: () => {
          form.dataset.turnstileConfigured = 'true';
        },
        'error-callback': (errorCode: string) => {
          console.error('Turnstile client error:', errorCode);
          form.dataset.turnstileConfigured = 'false';

          if (warning) {
            warning.hidden = false;
          }

          if (status) {
            status.textContent = turnstileErrorMessage(errorCode);
            status.className = 'form-status error';
          }
        },
        'expired-callback': () => {
          form.dataset.turnstileConfigured = 'true';
        },
      });
      widget.dataset.widgetId = String(widgetId);
      form.dataset.turnstileConfigured = 'true';

      if (warning) {
        warning.hidden = true;
      }
    } catch (error) {
      console.error('Turnstile render failed:', error);
      form.dataset.turnstileConfigured = 'false';

      if (warning) {
        warning.hidden = false;
      }
    } finally {
      widget.dataset.rendering = 'false';
    }
  }

  function waitForTurnstile() {
    return new Promise<void>((resolve, reject) => {
      const startedAt = Date.now();
      const timer = window.setInterval(() => {
        if ((window as any).turnstile?.render) {
          window.clearInterval(timer);
          resolve();
          return;
        }

        if (Date.now() - startedAt > 8000) {
          window.clearInterval(timer);
          reject(new Error('Turnstile script did not load.'));
        }
      }, 100);
    });
  }

  function resetTurnstile(widget: HTMLElement | null) {
    const widgetId = widget?.dataset.widgetId;
    const turnstile = (window as any).turnstile;

    if (!turnstile?.reset) {
      return;
    }

    if (widgetId) {
      turnstile.reset(widgetId);
      return;
    }

    turnstile.reset();
  }

  function turnstileErrorMessage(errorCode: string) {
    if (String(errorCode).startsWith('110200')) {
      return 'Contact form security cannot run on this domain. Please open the live site or email hello@centrix.ie.';
    }

    return 'Contact form security could not load. Please refresh the page or email hello@centrix.ie.';
  }
</script>

<style>
  /* Hero */
  .hero {
    padding: 8rem 0 4rem;
    background-color: var(--bg-secondary);
    border-bottom: 1px solid var(--border-primary);
  }

  @media (min-width: 768px) {
    .hero { padding: 10rem 0 5rem; }
  }

  .hero-content {
    max-width: 32rem;
  }

  .hero-eyebrow {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--brand-primary);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .hero-title { font-size: 3rem; }
  }

  .hero-description {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  /* Contact Section */
  .contact-section {
    padding: 5rem 0;
  }

  @media (min-width: 768px) {
    .contact-section { padding: 6rem 0; }
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .contact-grid { grid-template-columns: 1fr 1fr; }
  }

  /* Form */
  .form-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .form-row { grid-template-columns: 1fr 1fr; }
  }

  .form-label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 0.375rem;
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: 0.625rem 0.875rem;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: 0.375rem;
    color: var(--text-primary);
    font-size: 0.875rem;
    transition: border-color 0.15s ease;
  }

  .form-input::placeholder,
  .form-textarea::placeholder {
    color: var(--text-muted);
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--brand-primary);
  }

  .form-textarea {
    resize: none;
  }

  .submit-btn {
    width: 100%;
    margin-top: 0.5rem;
  }

  .submit-btn:disabled {
    cursor: not-allowed;
    opacity: 0.72;
  }

  .turnstile-wrap {
    min-height: 4.25rem;
  }

  .turnstile-config-warning {
    margin: 0;
    padding: 0.75rem;
    border: 1px solid var(--border-primary);
    border-radius: 0.375rem;
    background: var(--bg-secondary);
    color: var(--text-secondary);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .turnstile-config-warning a {
    color: var(--brand-primary);
    font-weight: 800;
    text-decoration: none;
  }

  .turnstile-config-warning a:hover {
    text-decoration: underline;
  }

  .form-status {
    min-height: 1.25rem;
    margin: 0;
    color: var(--text-tertiary);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .form-status.success {
    color: var(--success);
  }

  .form-status.error {
    color: var(--error);
  }

  /* Info */
  .info-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .info-description {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .contact-card {
    display: flex;
    gap: 0.875rem;
    padding: 1rem;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: 0.5rem;
  }

  .contact-icon {
    width: 2.25rem;
    height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--brand-light);
    color: var(--brand-primary);
    border-radius: 0.375rem;
    flex-shrink: 0;
  }

  .contact-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.125rem;
  }

  .contact-description {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    margin-bottom: 0.375rem;
  }

  .contact-link {
    font-size: 0.8125rem;
    color: var(--brand-primary);
    text-decoration: none;
  }

  .contact-link:hover {
    text-decoration: underline;
  }

  .contact-value {
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .response-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    background-color: var(--success-light);
    border: 1px solid var(--border-primary);
    border-radius: 0.5rem;
    color: var(--success);
  }

  .response-title {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .response-description {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  /* FAQ */
  .faq-section {
    padding: 5rem 0;
    background-color: var(--bg-secondary);
  }

  @media (min-width: 768px) {
    .faq-section { padding: 6rem 0; }
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    max-width: 48rem;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .faq-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .faq-card {
    padding: 1.25rem;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: 0.5rem;
  }

  .faq-question {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .faq-answer {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }
</style>
</BaseLayout>
