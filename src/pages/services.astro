---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteIcon from '../components/SiteIcon.astro';

const title = 'IT, Technology, And Consultancy Services';
const description = 'Centrix services across Microsoft cloud, UniFi networks, business networking, Wi-Fi, CCTV, VLANs, VPNs, VoIP, security, compliance readiness, and AI automation for Irish businesses.';

const groups = [
  {
    name: 'Microsoft & Cloud',
    overview: { label: 'Microsoft overview', href: '/microsoft' },
    services: [
      { title: 'Microsoft 365 Security', description: 'MFA, Conditional Access, Defender, and tenant hardening.', href: '/services/microsoft-365', icon: 'lock' },
      { title: 'Microsoft 365 Security Assessment', description: 'Read-only review with a prioritised remediation roadmap.', href: '/services/microsoft-365/security-assessment', icon: 'shield' },
      { title: 'Cloud Migration', description: 'Move email, files, identity, and devices to Microsoft cloud.', href: '/services/microsoft-365/cloud-migration', icon: 'cloud' },
      { title: 'Identity & Access', description: 'Entra ID security, OAuth cleanup, SSO, and governance.', href: '/services/identity', icon: 'lock' },
      { title: 'Intune & Endpoint Management', description: 'Device compliance, baselines, and zero-trust access.', href: '/services/intune', icon: 'device' },
      { title: 'Google Workspace', description: 'Workspace security assessments and managed administration.', href: '/services/google-workspace', icon: 'cloud' },
    ],
  },
  {
    name: 'Networking & Premises',
    overview: { label: 'Networking overview', href: '/networks' },
    services: [
      { title: 'Business Networking', description: 'Routing, switching, VLANs, guest access, and support.', href: '/services/networking/business-networking', icon: 'network' },
      { title: 'UniFi Installer Ireland', description: 'UniFi Wi-Fi, switching, CCTV, guest networks, VLANs, and managed support.', href: '/unifi-installer-ireland', icon: 'network' },
      { title: 'UniFi Network Audit', description: 'Review Wi-Fi, VLANs, cameras, admin access, firmware, backups, and support risk.', href: '/unifi-network-audit', icon: 'compliance' },
      { title: 'Business Wi-Fi', description: 'Reliable, secure wireless coverage across your premises.', href: '/services/networking/business-wifi', icon: 'wifi' },
      { title: 'VPN & Remote Access', description: 'Site-to-site and remote user access, scoped and secure.', href: '/services/networking/vpn-remote-access', icon: 'lock' },
      { title: 'VoIP & Business Phones', description: 'Handsets, call flows, voice VLANs, and support.', href: '/services/networking/voip-business-phones', icon: 'phone' },
      { title: 'CCTV & IP Cameras', description: 'Camera systems with app viewing, recording, and roles.', href: '/services/networking/cctv-ip-cameras', icon: 'camera' },
      { title: 'Backup & Resilience', description: 'Backup connectivity, failover, and recovery readiness.', href: '/services/networking/backup-resilience', icon: 'cloud' },
      { title: 'Managed UniFi Support', description: 'Monitoring, updates, backups, guest Wi-Fi changes, and troubleshooting.', href: '/unifi-network-support-ireland', icon: 'monitor' },
    ],
  },
  {
    name: 'Security & Compliance',
    overview: { label: 'Security overview', href: '/security' },
    services: [
      { title: 'Managed Security', description: 'Ongoing monitoring, hardening, and security management.', href: '/services/managed-security', icon: 'shield' },
      { title: 'Web Security', description: 'OWASP application testing and vulnerability monitoring.', href: '/services/web-security', icon: 'shield' },
      { title: 'Incident Response', description: 'Breach assessment, IR retainers, and tabletop exercises.', href: '/services/incident-response', icon: 'shield' },
      { title: 'Configuration Reviews', description: 'Fast, focused security configuration assessments.', href: '/services/configuration-reviews', icon: 'compliance' },
      { title: 'NIS2 & GDPR Readiness', description: 'Control mapping, evidence, and compliance readiness.', href: '/services/security/nis2-gdpr-readiness', icon: 'compliance' },
    ],
  },
  {
    name: 'AI & Automation',
    overview: { label: 'AI overview', href: '/ai' },
    services: [
      { title: 'AI Services', description: 'Practical, safe AI adoption for business teams.', href: '/services/ai-services', icon: 'ai' },
      { title: 'AI Strategy', description: 'Where AI fits, what to adopt, and how to govern it.', href: '/services/ai-services/ai-strategy', icon: 'ai' },
      { title: 'Business AI Automation', description: 'Automate real workflows that save your team time.', href: '/services/ai-services/business-ai-automation', icon: 'settings' },
      { title: 'Copilot Readiness', description: 'SharePoint permissions and tenant prep for Copilot.', href: '/services/ai-services/copilot-readiness', icon: 'ai' },
    ],
  },
];

const process = [
  { title: 'Scope', description: 'Clarify the business outcome, premises, users, systems, risks, budget, and delivery constraints.' },
  { title: 'Plan', description: 'Produce a clear approach with priorities, dependencies, assumptions, and practical sequencing.' },
  { title: 'Deliver', description: 'Configure, migrate, install, secure, test, and document the agreed solution.' },
  { title: 'Support', description: 'Keep improving through monitoring, reviews, issue response, and ongoing advisory support.' },
];
---

<BaseLayout title={title} description={description}>
  <main class="consult-page">
    <section class="consult-subhero">
      <div class="container-wide">
        <div class="consult-subhero-grid">
          <div>
            <div class="consult-eyebrow">Services</div>
            <h1 class="consult-subhero-title">IT and technology services for Irish businesses.</h1>
            <p class="consult-lead">
              Centrix works across cloud, premises networking, security, compliance readiness, and AI so your technology is easier to manage and safer to rely on.
            </p>
            <div class="consult-actions">
              <a href="/contact" class="consult-btn consult-btn-primary">
                Book a consultation
                <SiteIcon name="arrow-right" size={18} />
              </a>
              <a href="/about" class="consult-btn consult-btn-secondary">About Centrix</a>
            </div>
          </div>
          <aside class="consult-proof-panel">
            <h2>Start with</h2>
            <ul>
              <li><SiteIcon name="check" size={18} /><span>A cloud move or Microsoft review</span></li>
              <li><SiteIcon name="check" size={18} /><span>A UniFi, networking, VPN, VoIP, Wi-Fi, or CCTV site project</span></li>
              <li><SiteIcon name="check" size={18} /><span>A security and compliance readiness review</span></li>
              <li><SiteIcon name="check" size={18} /><span>A ChatGPT, Claude, Copilot, or AI automation workshop</span></li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    {groups.map((group, i) => (
      <section class={`consult-section${i % 2 === 1 ? ' consult-section-muted' : ''}`}>
        <div class="container-wide">
          <div class="consult-section-heading services-group-heading">
            <span class="consult-kicker">{group.name}</span>
            <a class="consult-card-link" href={group.overview.href}>
              {group.overview.label}
              <SiteIcon name="arrow-right" size={16} />
            </a>
          </div>
          <div class="consult-card-grid three">
            {group.services.map((service) => (
              <a href={service.href} class="consult-card">
                <div class="consult-card-icon"><SiteIcon name={service.icon} size={24} /></div>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
                <span class="consult-card-link">
                  View service
                  <SiteIcon name="arrow-right" size={16} />
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))}

    <section class="consult-section consult-section-muted">
      <div class="container-wide">
        <div class="consult-section-heading centered">
          <span class="consult-kicker">Delivery</span>
          <h2>Clear projects, useful documentation, and support after handover.</h2>
        </div>
        <div class="consult-steps">
          {process.map((step, index) => (
            <div class="consult-step">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="consult-cta">
      <div class="container-wide">
        <div class="consult-cta-inner">
          <div>
            <span class="consult-kicker">Next Step</span>
            <h2>Tell us what needs to change and we will shape the right service around it.</h2>
          </div>
          <a href="/contact" class="consult-btn consult-btn-primary">
            Contact Centrix
            <SiteIcon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .services-group-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    max-width: none;
  }
</style>
