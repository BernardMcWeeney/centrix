---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteIcon from '../components/SiteIcon.astro';

const title = 'IT, Technology, And Consultancy Services';
const description = 'Centrix services across Microsoft cloud, business networking, Wi-Fi, CCTV, VPNs, VoIP, security, compliance readiness, and AI automation for Irish businesses.';

const categories = [
  {
    title: 'Microsoft cloud',
    description: 'Microsoft 365, Azure, Intune, Defender, identity, migration, and tenant hardening.',
    href: '/microsoft',
    icon: 'microsoft',
  },
  {
    title: 'Business networking',
    description: 'Wi-Fi, switching, routing, VPNs, backup links, VoIP, CCTV networks, segmentation, and support.',
    href: '/networks',
    icon: 'network',
  },
  {
    title: 'CCTV and IP cameras',
    description: 'Camera systems with simple app and web viewing, local recording, access roles, and support.',
    href: '/services/networking/cctv-ip-cameras',
    icon: 'camera',
  },
  {
    title: 'Security and compliance',
    description: 'Security reviews, managed security, incident readiness, NIS2 readiness, and GDPR support.',
    href: '/security',
    icon: 'shield',
  },
  {
    title: 'Cloud migration',
    description: 'Move email, files, identity, and devices to Microsoft cloud in a controlled way.',
    href: '/services/microsoft-365/cloud-migration',
    icon: 'cloud',
  },
  {
    title: 'AI and automation',
    description: 'ChatGPT, Claude, Copilot, Cloudflare AI, usage policy, workflow automation, and practical AI pilots.',
    href: '/ai',
    icon: 'ai',
  },
];

const process = [
  { title: 'Scope', description: 'Clarify the business outcome, premises, users, systems, risks, budget, and delivery constraints.' },
  { title: 'Plan', description: 'Produce a clear approach with priorities, dependencies, assumptions, and practical sequencing.' },
  { title: 'Deliver', description: 'Configure, migrate, install, secure, test, and document the agreed solution.' },
  { title: 'Support', description: 'Keep improving through monitoring, reviews, issue response, and ongoing advisory support.' },
];
---

<BaseLayout title={title} description={description}>
  <main class="consult-page">
    <section class="consult-subhero">
      <div class="container-wide">
        <div class="consult-subhero-grid">
          <div>
            <div class="consult-eyebrow">Services</div>
            <h1 class="consult-subhero-title">IT and technology services for Irish businesses.</h1>
            <p class="consult-lead">
              Centrix works across cloud, premises networking, security, compliance readiness, and AI so your technology is easier to manage and safer to rely on.
            </p>
            <div class="consult-actions">
              <a href="/contact" class="consult-btn consult-btn-primary">
                Book a consultation
                <SiteIcon name="arrow-right" size={18} />
              </a>
              <a href="/about" class="consult-btn consult-btn-secondary">About Centrix</a>
            </div>
          </div>
          <aside class="consult-proof-panel">
            <h2>Start with</h2>
            <ul>
              <li><SiteIcon name="check" size={18} /><span>A cloud move or Microsoft review</span></li>
              <li><SiteIcon name="check" size={18} /><span>A networking, VPN, VoIP, Wi-Fi, or CCTV site project</span></li>
              <li><SiteIcon name="check" size={18} /><span>A security and compliance readiness review</span></li>
              <li><SiteIcon name="check" size={18} /><span>A ChatGPT, Claude, Copilot, or AI automation workshop</span></li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    <section class="consult-section">
      <div class="container-wide">
        <div class="consult-section-heading">
          <span class="consult-kicker">Catalogue</span>
          <h2>Choose the service area that matches the business problem.</h2>
        </div>
        <div class="consult-card-grid three">
          {categories.map((category) => (
            <a href={category.href} class="consult-card">
              <div class="consult-card-icon"><SiteIcon name={category.icon} size={24} /></div>
              <h3>{category.title}</h3>
              <p>{category.description}</p>
              <span class="consult-card-link">
                View service
                <SiteIcon name="arrow-right" size={16} />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="consult-section consult-section-muted">
      <div class="container-wide">
        <div class="consult-section-heading centered">
          <span class="consult-kicker">Delivery</span>
          <h2>Clear projects, useful documentation, and support after handover.</h2>
        </div>
        <div class="consult-steps">
          {process.map((step, index) => (
            <div class="consult-step">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="consult-cta">
      <div class="container-wide">
        <div class="consult-cta-inner">
          <div>
            <span class="consult-kicker">Next Step</span>
            <h2>Tell us what needs to change and we will shape the right service around it.</h2>
          </div>
          <a href="/contact" class="consult-btn consult-btn-primary">
            Contact Centrix
            <SiteIcon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
