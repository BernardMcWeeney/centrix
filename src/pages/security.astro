---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteIcon from '../components/SiteIcon.astro';

const title = 'Security And Compliance Readiness For Irish Businesses';
const description = 'Security consultancy, Microsoft hardening, vulnerability management, NIS2 readiness, GDPR support, and incident response for Irish businesses.';

const services = [
  {
    title: 'NIS2 and GDPR readiness',
    description: 'Review controls, evidence, incident process, data handling, access management, and technical safeguards.',
    href: '/services/security/nis2-gdpr-readiness',
    icon: 'compliance',
  },
  {
    title: 'Microsoft security review',
    description: 'Assess Microsoft 365 identity, email, Defender, devices, audit logging, and data protection configuration.',
    href: '/services/microsoft-365/security-assessment',
    icon: 'microsoft',
  },
  {
    title: 'Managed security',
    description: 'Practical monitoring, monthly reporting, vulnerability follow-up, and security improvement cadence.',
    href: '/services/managed-security',
    icon: 'monitor',
  },
  {
    title: 'Incident response',
    description: 'Help prepare for security incidents, define response steps, and support containment when something goes wrong.',
    href: '/services/incident-response',
    icon: 'shield',
  },
  {
    title: 'Configuration reviews',
    description: 'Independent review of cloud, firewall, identity, email, endpoint, and network configuration risk.',
    href: '/services/configuration-reviews',
    icon: 'settings',
  },
  {
    title: 'Web and email security',
    description: 'Review website, DNS, email authentication, phishing resilience, and public exposure.',
    href: '/services/web-security',
    icon: 'lock',
  },
];

const controls = [
  'MFA and secure identity policies',
  'Device protection and patch visibility',
  'Email security and phishing controls',
  'Privileged admin access review',
  'Backups and recovery expectations',
  'Network segmentation and remote access',
  'Incident response process and contacts',
  'Security evidence and management reporting',
];
---

<BaseLayout title={title} description={description}>
  <main class="consult-page">
    <section class="consult-subhero">
      <div class="container-wide">
        <div class="consult-subhero-grid">
          <div>
            <div class="consult-eyebrow">Security & Readiness</div>
            <h1 class="consult-subhero-title">Improve security, reduce risk, and prepare for compliance demands.</h1>
            <p class="consult-lead">
              Centrix helps Irish businesses put sensible technical controls in place across Microsoft 365, endpoints, networks, cloud services, users, and incident response.
            </p>
            <div class="consult-actions">
              <a href="/services/security/nis2-gdpr-readiness" class="consult-btn consult-btn-primary">
                View NIS2 and GDPR readiness
                <SiteIcon name="arrow-right" size={18} />
              </a>
              <a href="/contact" class="consult-btn consult-btn-secondary">Discuss security priorities</a>
            </div>
          </div>
          <aside class="consult-proof-panel">
            <h2>Security work should be</h2>
            <ul>
              <li><SiteIcon name="check" size={18} /><span>Specific to your business risk</span></li>
              <li><SiteIcon name="check" size={18} /><span>Clear enough for management decisions</span></li>
              <li><SiteIcon name="check" size={18} /><span>Practical for your staff and budget</span></li>
              <li><SiteIcon name="check" size={18} /><span>Documented for audits, insurance, and suppliers</span></li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    <section class="consult-section">
      <div class="container-wide">
        <div class="consult-section-heading">
          <span class="consult-kicker">Security Services</span>
          <h2>Controls, reviews, and support for real business environments.</h2>
        </div>
        <div class="consult-card-grid three">
          {services.map((service) => (
            <a href={service.href} class="consult-card">
              <div class="consult-card-icon"><SiteIcon name={service.icon} size={24} /></div>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              <span class="consult-card-link">
                View service
                <SiteIcon name="arrow-right" size={16} />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="consult-section consult-section-muted">
      <div class="container-wide">
        <div class="consult-split">
          <div>
            <span class="consult-kicker">Readiness Controls</span>
            <h2>Build evidence and resilience before pressure arrives.</h2>
            <p>
              We help with the technical side of readiness: configuration, access control, logging, documentation, review cadence, and incident preparation.
            </p>
          </div>
          <div class="consult-check-list">
            {controls.map((item) => (
              <div class="consult-check-item">
                <SiteIcon name="check" size={18} />
                <span>{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="consult-cta">
      <div class="container-wide">
        <div class="consult-cta-inner">
          <div>
            <span class="consult-kicker">Next Step</span>
            <h2>Start with a security review or a NIS2/GDPR technical readiness discussion.</h2>
          </div>
          <a href="/contact" class="consult-btn consult-btn-primary">
            Book a security consultation
            <SiteIcon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
