---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteIcon from '../../components/SiteIcon.astro';

const title = 'Microsoft 365 Solutions';
const description = 'Microsoft 365 cloud, security, migration, identity, device management, and Copilot readiness services from Centrix.';
---

<BaseLayout title={title} description={description}>
  <main class="consult-page">
    <section class="consult-subhero">
      <div class="container-wide">
        <div class="consult-subhero-grid">
          <div>
            <div class="consult-eyebrow">Microsoft 365</div>
            <h1 class="consult-subhero-title">Microsoft cloud solutions for Irish business.</h1>
            <p class="consult-lead">
              This legacy solutions route now points to the main Centrix Microsoft service area for cloud migration, security, Intune, Defender, identity, and Copilot readiness.
            </p>
            <div class="consult-actions">
              <a href="/microsoft" class="consult-btn consult-btn-primary">
                View Microsoft services
                <SiteIcon name="arrow-right" size={18} />
              </a>
              <a href="/services/microsoft-365/cloud-migration" class="consult-btn consult-btn-secondary">Plan cloud migration</a>
            </div>
          </div>
          <aside class="consult-proof-panel">
            <h2>Popular routes</h2>
            <ul>
              <li><SiteIcon name="check" size={18} /><span>Microsoft 365 security</span></li>
              <li><SiteIcon name="check" size={18} /><span>Cloud migration</span></li>
              <li><SiteIcon name="check" size={18} /><span>Intune and devices</span></li>
              <li><SiteIcon name="check" size={18} /><span>Copilot readiness</span></li>
            </ul>
          </aside>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
