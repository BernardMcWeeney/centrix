---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteIcon from '../../components/SiteIcon.astro';

const title = 'Networking Solutions';
const description = 'Business networking, Wi-Fi, CCTV, IP cameras, switching, routing, VPNs, VoIP, backup connectivity, and managed network services from Centrix.';
---

<BaseLayout title={title} description={description}>
  <main class="consult-page">
    <section class="consult-subhero">
      <div class="container-wide">
        <div class="consult-subhero-grid">
          <div>
            <div class="consult-eyebrow">Business Networking</div>
            <h1 class="consult-subhero-title">Reliable networking, VPNs, VoIP, Wi-Fi, and CCTV for Irish business premises.</h1>
            <p class="consult-lead">
              This legacy solutions route now points to the main Centrix networking service area.
            </p>
            <div class="consult-actions">
              <a href="/networks" class="consult-btn consult-btn-primary">
                View networking services
                <SiteIcon name="arrow-right" size={18} />
              </a>
              <a href="/services/networking/vpn-remote-access" class="consult-btn consult-btn-secondary">VPN and remote access</a>
            </div>
          </div>
          <aside class="consult-proof-panel">
            <h2>Popular routes</h2>
            <ul>
              <li><SiteIcon name="check" size={18} /><span>Business Wi-Fi</span></li>
              <li><SiteIcon name="check" size={18} /><span>CCTV and IP cameras</span></li>
              <li><SiteIcon name="check" size={18} /><span>VPN and remote access</span></li>
              <li><SiteIcon name="check" size={18} /><span>VoIP and business phones</span></li>
              <li><SiteIcon name="check" size={18} /><span>Managed network support</span></li>
            </ul>
          </aside>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
