---
import BuyerServicePage from '../../../components/BuyerServicePage.astro';

const outcomes = [
  {
    title: 'A secure identity perimeter',
    description: 'Entra ID reviewed and hardened — authentication, authorization, admin roles, and access controls done properly.',
    icon: 'lock',
  },
  {
    title: 'Risky access removed',
    description: 'OAuth app and consent cleanup to remove risky third-party access and lock down what apps can reach.',
    icon: 'shield',
  },
  {
    title: 'Governed, ongoing access',
    description: 'Access reviews, lifecycle policies, and SSO onboarding so the right people keep the right access over time.',
    icon: 'users',
  },
];

const includes = [
  'Entra ID security review and configuration audit',
  'MFA and Conditional Access baseline',
  'Admin roles and privileged access review',
  'OAuth app and consent cleanup',
  'SSO application onboarding (SAML / OIDC)',
  'Identity governance: access reviews and lifecycle policies',
  'Remediation roadmap and handover documentation',
];

const process = [
  { title: 'Assess', description: 'We audit your Entra ID configuration, sign-in risk, admin roles, app consents, and access policies.' },
  { title: 'Prioritise', description: 'Findings are grouped into practical actions based on risk, business impact, and effort.' },
  { title: 'Harden', description: 'We implement agreed controls such as MFA, Conditional Access, consent governance, and SSO.' },
  { title: 'Govern', description: 'Access reviews, lifecycle policies, and reporting keep identity secure as people and apps change.' },
];

const faqs = [
  {
    question: 'Why focus on identity first?',
    answer: 'Most breaches involve compromised identity. Securing Entra ID, MFA, and access controls protects your organisation’s front door before anything else.',
  },
  {
    question: 'Can you do a review without making changes?',
    answer: 'Yes. We can deliver an assessment and roadmap only, or continue into implementation and ongoing identity governance.',
  },
  {
    question: 'Will tightening access disrupt users?',
    answer: 'We stage and test controls like Conditional Access on a pilot group first, so security improves without locking out legitimate users.',
  },
];
---

<BuyerServicePage
  metaTitle="Identity & Access Management | Entra ID Security | Centrix"
  metaDescription="Secure your identity infrastructure with Entra ID security reviews, OAuth cleanup, SSO onboarding, and identity governance. Protect your organisation's front door."
  eyebrow="Identity & Access"
  heading="Your identity is your perimeter — secure it properly"
  lead="Centrix secures Entra ID with security reviews, OAuth cleanup, SSO onboarding, and zero-trust access controls that protect your organisation's front door."
  primaryCta={{ label: 'Start an identity assessment', href: '/contact?service=identity' }}
  secondaryCta={{ label: 'Microsoft 365 security', href: '/services/microsoft-365' }}
  proof={['Entra ID security review', 'MFA and Conditional Access baseline', 'OAuth and consent cleanup', 'Identity governance and access reviews']}
  outcomes={outcomes}
  includes={includes}
  process={process}
  faqs={faqs}
  mediaLabel="Identity & access imagery"
  mediaHint="e.g. an Entra ID / sign-in security visual, MFA prompt, or access governance dashboard"
  mediaIcon="lock"
  related={[
    { label: 'Microsoft 365 security', href: '/services/microsoft-365' },
    { label: 'Intune & endpoint management', href: '/services/intune' },
    { label: 'Microsoft services', href: '/microsoft' },
  ]}
/>
