---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getServicesByCategory } from '../../consts';

const services = getServicesByCategory('managed-security');

const title = "Managed Security Programs | 24/7 Protection | Waymark";
const description = "Enterprise-grade managed security services with 24/7 monitoring, threat detection, and incident response. Protect your business with our expert security team.";

const capabilities = [
  {
    title: "Threat Detection",
    description: "AI-powered monitoring identifies threats in real-time before they impact your business.",
    metric: "99.9%",
    metricLabel: "Detection Rate",
  },
  {
    title: "Incident Response",
    description: "Expert security team responds to incidents within hours, not days.",
    metric: "<4hr",
    metricLabel: "Response Time",
  },
  {
    title: "Vulnerability Management",
    description: "Continuous scanning and remediation keeps your attack surface minimal.",
    metric: "500+",
    metricLabel: "Checks Per Scan",
  },
  {
    title: "Compliance",
    description: "Stay audit-ready with automated reporting for SOC 2, HIPAA, GDPR, and more.",
    metric: "100%",
    metricLabel: "Audit Pass Rate",
  },
];

const benefits = [
  {
    title: "24/7 Security Operations",
    description: "Our SOC never sleeps. Round-the-clock monitoring means threats are caught and contained at 3am just as effectively as 3pm.",
    icon: "clock",
  },
  {
    title: "Proactive Threat Hunting",
    description: "We don't wait for alerts. Our team actively hunts for indicators of compromise across your environment.",
    icon: "search",
  },
  {
    title: "Rapid Incident Response",
    description: "When incidents occur, our response team is mobilized immediately with a proven playbook for containment and recovery.",
    icon: "bolt",
  },
];

const faqs = [
  {
    question: "What's included in managed security?",
    answer: "Our managed security programs include 24/7 monitoring, vulnerability scanning, threat detection, incident response, compliance reporting, and access to our security operations center (SOC). We integrate with your existing tools and provide a dedicated security team."
  },
  {
    question: "How quickly can you respond to incidents?",
    answer: "Our average incident response time is under 4 hours. Critical threats are escalated immediately to our on-call security team for rapid containment and remediation. We operate 24/7/365."
  },
  {
    question: "Which compliance frameworks do you support?",
    answer: "We support SOC 2 Type I & II, HIPAA, GDPR, PCI-DSS, ISO 27001, NIST CSF, and CIS Controls. We provide audit-ready documentation and work directly with your auditors."
  },
  {
    question: "How does onboarding work?",
    answer: "Onboarding typically takes 2-4 weeks. We start with a security assessment, then deploy monitoring tools, configure alerting thresholds, and establish incident response procedures tailored to your environment."
  },
  {
    question: "Can you work with our existing security tools?",
    answer: "Yes. We integrate with popular SIEM platforms, endpoint protection solutions, cloud security tools, and identity management systems. Our team will work with your existing stack to provide unified protection."
  },
];

const testimonials = [
  {
    quote: "Waymark's security team caught a sophisticated attack that our internal tools missed completely. Their rapid response prevented what could have been a devastating breach.",
    author: "Sarah Chen",
    role: "Chief Technology Officer",
    company: "TechScale Inc.",
    metric: "94%",
    metricLabel: "Threats Blocked"
  },
  {
    quote: "We went from zero security visibility to enterprise-grade protection in weeks. The ROI compared to building an internal team is incredible.",
    author: "Michael Rodriguez",
    role: "IT Director",
    company: "GrowthPath Solutions",
    metric: "<4hr",
    metricLabel: "Response Time"
  },
];

const partners = ["Microsoft Partner", "SOC 2 Certified", "ISO 27001"];

// JSON-LD Schema for SEO
const schemaData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Managed Security Programs",
  "provider": {
    "@type": "Organization",
    "name": "Waymark",
    "url": "https://waymark.io"
  },
  "description": description,
  "serviceType": "Managed Security Services",
  "areaServed": "Worldwide",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Managed Security Services",
    "itemListElement": services.map(s => ({
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": s.title,
        "description": s.description
      }
    }))
  }
};
---

<BaseLayout title={title} description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg">
      <div class="gradient-mesh">
        <div class="mesh-gradient mesh-1"></div>
        <div class="mesh-gradient mesh-2"></div>
      </div>
      <div class="hero-grid-lines"></div>
    </div>

    <div class="container-wide hero-container">
      <div class="hero-content">
        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span class="badge-text">Productized IT Security Services</span>
        </div>

        <h1 class="hero-title">
          <span class="title-line">Security that scales</span>
          <span class="title-gradient">with your business</span>
        </h1>

        <p class="hero-subtitle">
          From Microsoft 365 security to AI readiness, we deliver fixed-scope services with clear outcomes and predictable pricing. No hourly billing surprises.
        </p>

        <div class="hero-cta">
          <a href="/contact?service=managed-security" class="btn-primary">
            <span>Get Started</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="#services" class="btn-secondary">
            Browse Services
          </a>
        </div>

        <div class="hero-trust">
          {partners.map((partner) => (
            <span class="trust-badge">{partner}</span>
          ))}
        </div>
      </div>

      <div class="hero-visual">
        <div class="visual-container">
          <div class="float-card card-1">
            <div class="card-icon card-icon-blue">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <div class="card-content">
              <span class="card-title">Security Assessment</span>
              <span class="card-desc">M365 tenant review complete</span>
            </div>
            <span class="card-status status-done">Done</span>
          </div>

          <div class="float-card card-2">
            <div class="card-icon card-icon-purple">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
              </svg>
            </div>
            <div class="card-content">
              <span class="card-title">AI Readiness</span>
              <span class="card-desc">Copilot deployment ready</span>
            </div>
            <span class="card-status status-active">Active</span>
          </div>

          <div class="float-card card-3">
            <div class="card-icon card-icon-green">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 011.06 0z"/>
              </svg>
            </div>
            <div class="card-content">
              <span class="card-title">Network Deployed</span>
              <span class="card-desc">UniFi stack configured</span>
            </div>
            <span class="card-status status-done">Done</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Metrics Section -->
  <section class="metrics-section">
    <div class="container-wide">
      <div class="metrics-grid">
        <div class="metric-item">
          <span class="metric-value">24/7</span>
          <span class="metric-label">Security Monitoring</span>
        </div>
        <div class="metric-item">
          <span class="metric-value">99.9%</span>
          <span class="metric-label">Threat Detection</span>
        </div>
        <div class="metric-item">
          <span class="metric-value">&lt;4hr</span>
          <span class="metric-label">Response Time</span>
        </div>
        <div class="metric-item">
          <span class="metric-value">500+</span>
          <span class="metric-label">Clients Protected</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section id="services" class="services-section">
    <div class="container-wide">
      <div class="section-header">
        <span class="section-badge">Services</span>
        <h2 class="section-title">Everything you need to <span class="text-gradient">secure your business</span></h2>
        <p class="section-desc">Comprehensive security programs designed to protect, detect, and respond to threats across your entire organization.</p>
      </div>

      <div class="services-grid">
        {services.map((service, index) => (
          <a href={`/contact?service=${service.id || 'managed-security'}`} class="service-card" style={`--delay: ${index * 0.1}s`}>
            <div class="service-card-bg"></div>
            <div class="service-card-content">
              <div class="service-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
                </svg>
              </div>
              <div class="service-badges">
                {service.types.map((type) => (
                  <span class={`service-type-badge type-${type}`}>{type}</span>
                ))}
              </div>
              <h3 class="service-title">{service.title}</h3>
              <p class="service-desc">{service.description}</p>
              <div class="service-footer">
                {service.timeframe && <span class="service-timeframe">{service.timeframe}</span>}
                <span class="service-arrow">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Capabilities Section -->
  <section class="capabilities-section">
    <div class="container-wide">
      <div class="section-header">
        <span class="section-badge">Capabilities</span>
        <h2 class="section-title">Enterprise security, <span class="text-gradient">without the complexity</span></h2>
      </div>

      <div class="capabilities-grid">
        {capabilities.map((cap, index) => (
          <div class="capability-card" style={`--delay: ${index * 0.1}s`}>
            <div class="capability-metric">
              <span class="cap-metric-value">{cap.metric}</span>
              <span class="cap-metric-label">{cap.metricLabel}</span>
            </div>
            <h3 class="capability-title">{cap.title}</h3>
            <p class="capability-desc">{cap.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Section -->
  <section class="why-section">
    <div class="why-bg">
      <div class="why-gradient"></div>
    </div>
    <div class="container-wide">
      <div class="why-grid">
        <div class="why-content">
          <span class="section-badge">Why Waymark</span>
          <h2 class="why-title">Security done <span class="text-gradient">differently</span></h2>
          <p class="why-desc">We're not another IT consultancy billing by the hour. We're a productized security partner delivering clear outcomes with predictable costs.</p>

          <div class="why-features">
            {benefits.map((benefit) => (
              <div class="why-feature">
                <div class="feature-icon">
                  {benefit.icon === 'clock' && (
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  )}
                  {benefit.icon === 'search' && (
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/>
                    </svg>
                  )}
                  {benefit.icon === 'bolt' && (
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/>
                    </svg>
                  )}
                </div>
                <div class="feature-content">
                  <h4>{benefit.title}</h4>
                  <p>{benefit.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="why-visual">
          <div class="process-visual">
            <div class="process-step">
              <div class="step-number step-1">1</div>
              <div class="step-label">Discover</div>
            </div>
            <div class="process-step">
              <div class="step-number step-2">2</div>
              <div class="step-label">Design</div>
            </div>
            <div class="process-step">
              <div class="step-number step-3">3</div>
              <div class="step-label">Deliver</div>
            </div>
            <div class="process-step">
              <div class="step-number step-4">4</div>
              <div class="step-label">Sustain</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section id="pricing" class="pricing-section">
    <div class="container-wide">
      <div class="section-header">
        <span class="section-badge">Pricing</span>
        <h2 class="section-title">Transparent pricing. <span class="text-gradient">No surprises.</span></h2>
        <p class="section-desc">Choose the plan that fits your organization. All plans include 24/7 monitoring and expert support.</p>
      </div>

      <div class="pricing-grid">
        <div class="pricing-card">
          <div class="pricing-header">
            <h3 class="pricing-tier">Essential</h3>
            <p class="pricing-subtitle">For small teams getting started</p>
          </div>
          <div class="pricing-amount">
            <span class="currency">$</span>
            <span class="amount">2,500</span>
            <span class="period">/month</span>
          </div>
          <ul class="pricing-features">
            <li>24/7 monitoring</li>
            <li>Weekly vulnerability scans</li>
            <li>Email support</li>
            <li>Monthly reporting</li>
            <li>Up to 50 endpoints</li>
          </ul>
          <a href="/contact?plan=essential" class="pricing-cta secondary">Get Started</a>
        </div>

        <div class="pricing-card featured">
          <div class="pricing-badge">Most Popular</div>
          <div class="pricing-header">
            <h3 class="pricing-tier">Professional</h3>
            <p class="pricing-subtitle">For growing businesses</p>
          </div>
          <div class="pricing-amount">
            <span class="currency">$</span>
            <span class="amount">5,000</span>
            <span class="period">/month</span>
          </div>
          <ul class="pricing-features">
            <li>Everything in Essential</li>
            <li>Daily vulnerability scans</li>
            <li>4-hour incident response</li>
            <li>Compliance reporting</li>
            <li>Up to 200 endpoints</li>
            <li>Dedicated account manager</li>
          </ul>
          <a href="/contact?plan=professional" class="pricing-cta primary">Get Started</a>
        </div>

        <div class="pricing-card">
          <div class="pricing-header">
            <h3 class="pricing-tier">Enterprise</h3>
            <p class="pricing-subtitle">For large organizations</p>
          </div>
          <div class="pricing-amount">
            <span class="amount custom">Custom</span>
          </div>
          <ul class="pricing-features">
            <li>Everything in Professional</li>
            <li>Real-time threat hunting</li>
            <li>1-hour incident response</li>
            <li>Custom integrations</li>
            <li>Unlimited endpoints</li>
            <li>On-site support available</li>
          </ul>
          <a href="/contact?plan=enterprise" class="pricing-cta secondary">Contact Sales</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="testimonials-section">
    <div class="container-wide">
      <div class="section-header">
        <span class="section-badge">Client Stories</span>
        <h2 class="section-title">Trusted by <span class="text-gradient">security-conscious</span> teams</h2>
      </div>

      <div class="testimonials-grid">
        {testimonials.map((t, index) => (
          <div class="testimonial-card" style={`--delay: ${index * 0.1}s`}>
            <div class="testimonial-metric">
              <span class="t-metric-value">{t.metric}</span>
              <span class="t-metric-label">{t.metricLabel}</span>
            </div>
            <blockquote class="testimonial-quote">{t.quote}</blockquote>
            <div class="testimonial-author">
              <div class="author-avatar">{t.author.split(' ').map(n => n[0]).join('')}</div>
              <div>
                <div class="author-name">{t.author}</div>
                <div class="author-role">{t.role}, {t.company}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq-section">
    <div class="container-wide">
      <div class="faq-layout">
        <div class="faq-header">
          <span class="section-badge">FAQ</span>
          <h2 class="section-title">Common questions</h2>
          <p class="section-desc">Everything you need to know about our managed security services.</p>
          <a href="/contact" class="faq-contact">
            Still have questions?
            <span class="contact-link">
              Talk to us
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </a>
        </div>

        <div class="faq-list">
          {faqs.map((faq, index) => (
            <details class="faq-item" style={`--delay: ${index * 0.1}s`}>
              <summary class="faq-question">
                <span>{faq.question}</span>
                <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
                </svg>
              </summary>
              <div class="faq-answer">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="cta-bg">
      <div class="cta-gradient-1"></div>
      <div class="cta-gradient-2"></div>
    </div>
    <div class="container-wide">
      <div class="cta-content">
        <h2 class="cta-title">Ready to transform your security?</h2>
        <p class="cta-desc">Start with a free consultation. No pressure, no commitment.</p>
        <div class="cta-actions">
          <a href="/contact?service=managed-security" class="btn-primary btn-lg">
            <span>Schedule Consultation</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 8rem 0 4rem;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--bg-primary);
  }

  .gradient-mesh {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .mesh-gradient {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.5;
  }

  .mesh-1 {
    width: 60vw;
    height: 60vw;
    max-width: 800px;
    max-height: 800px;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.3), rgba(139, 92, 246, 0.2));
    top: -20%;
    right: -10%;
  }

  .mesh-2 {
    width: 40vw;
    height: 40vw;
    max-width: 500px;
    max-height: 500px;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.2), rgba(34, 211, 238, 0.15));
    bottom: -10%;
    left: -5%;
  }

  .hero-grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border-primary) 1px, transparent 1px),
      linear-gradient(90deg, var(--border-primary) 1px, transparent 1px);
    background-size: 80px 80px;
    opacity: 0.3;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 20%, transparent 70%);
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr 1fr;
    }
  }

  .hero-content {
    max-width: 600px;
  }

  /* Hero Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 1rem 0.5rem 0.75rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-primary);
    border-radius: 9999px;
    margin-bottom: 2rem;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 8px #22c55e;
    animation: dot-pulse 2s ease-in-out infinite;
  }

  @keyframes dot-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .badge-text {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  /* Hero Title */
  .hero-title {
    font-size: 3rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    .hero-title { font-size: 4rem; }
  }

  @media (min-width: 1024px) {
    .hero-title { font-size: 4.5rem; }
  }

  .title-line {
    display: block;
    color: var(--text-primary);
  }

  .title-gradient {
    display: block;
    background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 50%, #a855f7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .hero-subtitle { font-size: 1.25rem; }
  }

  /* Hero CTA */
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    background: var(--brand-primary);
    color: white;
    font-weight: 500;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary:hover {
    background: var(--brand-hover);
    transform: translateY(-1px);
  }

  .btn-primary.btn-lg {
    padding: 1rem 2rem;
    font-size: 1.0625rem;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    background: transparent;
    color: var(--text-primary);
    font-weight: 500;
    border: 1px solid var(--border-primary);
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-secondary:hover {
    border-color: var(--border-hover);
    background: var(--bg-secondary);
  }

  /* Hero Trust */
  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .trust-badge {
    padding: 0.5rem 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  /* Hero Visual */
  .hero-visual {
    display: none;
  }

  @media (min-width: 1024px) {
    .hero-visual {
      display: flex;
      justify-content: center;
      align-items: center;
    }
  }

  .visual-container {
    position: relative;
    width: 100%;
    max-width: 400px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Floating Cards */
  .float-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: 0.75rem;
    box-shadow: 0 4px 20px -4px rgba(0, 0, 0, 0.08);
    animation: float-card 6s ease-in-out infinite;
  }

  .card-1 { animation-delay: 0s; }
  .card-2 { animation-delay: -2s; margin-left: 2rem; }
  .card-3 { animation-delay: -4s; margin-left: 1rem; }

  @keyframes float-card {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .card-icon {
    width: 40px;
    height: 40px;
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .card-icon-blue {
    background: rgba(59, 130, 246, 0.1);
    color: #3b82f6;
  }

  .card-icon-purple {
    background: rgba(139, 92, 246, 0.1);
    color: #8b5cf6;
  }

  .card-icon-green {
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
  }

  .card-content {
    flex: 1;
    min-width: 0;
  }

  .card-title {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.125rem;
  }

  .card-desc {
    display: block;
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }

  .card-status {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    flex-shrink: 0;
  }

  .status-done {
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
  }

  .status-active {
    background: rgba(59, 130, 246, 0.1);
    color: #3b82f6;
  }

  /* Metrics Section */
  .metrics-section {
    padding: 3rem 0;
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-primary);
    border-bottom: 1px solid var(--border-primary);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .metrics-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .metric-item {
    text-align: center;
  }

  .metric-value {
    display: block;
    font-size: 2rem;
    font-weight: 700;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .metric-label {
    font-size: 0.875rem;
    color: var(--text-tertiary);
  }

  /* Section Styles */
  .services-section,
  .capabilities-section,
  .pricing-section,
  .testimonials-section {
    padding: 6rem 0;
  }

  @media (min-width: 1024px) {
    .services-section,
    .capabilities-section,
    .pricing-section,
    .testimonials-section {
      padding: 8rem 0;
    }
  }

  .section-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 4rem;
  }

  .section-badge {
    display: inline-block;
    padding: 0.375rem 1rem;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #3b82f6;
    margin-bottom: 1.5rem;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .section-title { font-size: 2.5rem; }
  }

  .text-gradient {
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .section-desc {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* Services Grid */
  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .services-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .services-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .service-card {
    position: relative;
    border-radius: 1rem;
    text-decoration: none;
    overflow: hidden;
    animation: fade-up 0.6s ease-out both;
    animation-delay: var(--delay);
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .service-card-bg {
    position: absolute;
    inset: 0;
    background: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: 1rem;
    transition: all 0.2s;
  }

  .service-card:hover .service-card-bg {
    border-color: var(--border-hover);
    box-shadow: 0 8px 30px -10px rgba(0, 0, 0, 0.1);
  }

  .service-card-content {
    position: relative;
    padding: 1.75rem;
    z-index: 1;
  }

  .service-icon {
    width: 48px;
    height: 48px;
    background: rgba(59, 130, 246, 0.1);
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #3b82f6;
    margin-bottom: 1rem;
    transition: all 0.2s;
  }

  .service-card:hover .service-icon {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(139, 92, 246, 0.15));
  }

  .service-badges {
    display: flex;
    gap: 0.375rem;
    margin-bottom: 1rem;
  }

  .service-type-badge {
    padding: 0.25rem 0.5rem;
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 0.25rem;
  }

  .type-assessment {
    background: rgba(59, 130, 246, 0.1);
    color: #3b82f6;
  }

  .type-implementation {
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
  }

  .type-managed {
    background: rgba(139, 92, 246, 0.1);
    color: #8b5cf6;
  }

  .service-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .service-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .service-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid var(--border-primary);
  }

  .service-timeframe {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }

  .service-arrow {
    color: var(--text-tertiary);
    transition: all 0.2s;
  }

  .service-card:hover .service-arrow {
    color: #3b82f6;
    transform: translateX(4px);
  }

  /* Capabilities */
  .capabilities-section {
    background: var(--bg-secondary);
  }

  .capabilities-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .capabilities-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .capabilities-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .capability-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: 1rem;
    padding: 2rem;
    animation: fade-up 0.6s ease-out both;
    animation-delay: var(--delay);
    transition: all 0.2s;
  }

  .capability-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }

  .capability-metric {
    margin-bottom: 1.5rem;
  }

  .cap-metric-value {
    display: block;
    font-size: 2.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
  }

  .cap-metric-label {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .capability-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .capability-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Why Section */
  .why-section {
    position: relative;
    padding: 6rem 0;
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .why-section { padding: 8rem 0; }
  }

  .why-bg {
    position: absolute;
    inset: 0;
  }

  .why-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.03) 0%, transparent 50%, rgba(139, 92, 246, 0.03) 100%);
  }

  .why-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .why-grid { grid-template-columns: 1fr 1fr; }
  }

  .why-content {
    max-width: 500px;
  }

  .why-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .why-title { font-size: 2.5rem; }
  }

  .why-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .why-features {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .why-feature {
    display: flex;
    gap: 1rem;
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    background: rgba(59, 130, 246, 0.1);
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #3b82f6;
    flex-shrink: 0;
  }

  .feature-content h4 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .feature-content p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Process Visual */
  .why-visual {
    display: none;
  }

  @media (min-width: 1024px) {
    .why-visual { display: block; }
  }

  .process-visual {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .process-step {
    text-align: center;
  }

  .step-number {
    width: 64px;
    height: 64px;
    margin: 0 auto 1rem;
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
    color: white;
  }

  .step-1 { background: #3b82f6; box-shadow: 0 8px 30px -10px rgba(59, 130, 246, 0.5); }
  .step-2 { background: #8b5cf6; box-shadow: 0 8px 30px -10px rgba(139, 92, 246, 0.5); }
  .step-3 { background: #10b981; box-shadow: 0 8px 30px -10px rgba(16, 185, 129, 0.5); }
  .step-4 { background: #f97316; box-shadow: 0 8px 30px -10px rgba(249, 115, 22, 0.5); }

  .step-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  /* Pricing Section */
  .pricing-section {
    background: var(--bg-secondary);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .pricing-grid {
      grid-template-columns: repeat(3, 1fr);
      align-items: start;
    }
  }

  .pricing-card {
    position: relative;
    background: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: 1rem;
    padding: 2rem;
  }

  .pricing-card.featured {
    border-color: var(--brand-primary);
    box-shadow: 0 0 0 1px var(--brand-primary);
  }

  @media (min-width: 768px) {
    .pricing-card.featured {
      transform: scale(1.05);
      z-index: 1;
    }
  }

  .pricing-badge {
    position: absolute;
    top: -0.75rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.375rem 1rem;
    background: var(--brand-primary);
    color: white;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 9999px;
  }

  .pricing-header {
    text-align: center;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-primary);
    margin-bottom: 1.5rem;
  }

  .pricing-tier {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .pricing-subtitle {
    font-size: 0.875rem;
    color: var(--text-tertiary);
  }

  .pricing-amount {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .currency {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text-tertiary);
    vertical-align: top;
  }

  .amount {
    font-size: 3rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .amount.custom {
    font-size: 2rem;
    background: linear-gradient(135deg, var(--brand-primary), #8b5cf6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .period {
    font-size: 1rem;
    color: var(--text-tertiary);
  }

  .pricing-features {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .pricing-features li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .pricing-features li::before {
    content: '';
    width: 18px;
    height: 18px;
    background: rgba(16, 185, 129, 0.1);
    border-radius: 50%;
    flex-shrink: 0;
    position: relative;
  }

  .pricing-features li::after {
    content: '';
    position: absolute;
    width: 5px;
    height: 8px;
    border: 2px solid #10b981;
    border-top: none;
    border-left: none;
    transform: rotate(45deg);
    margin-left: 6px;
    margin-top: -2px;
  }

  .pricing-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.875rem 1.5rem;
    font-weight: 500;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.2s;
  }

  .pricing-cta.primary {
    background: var(--brand-primary);
    color: white;
  }

  .pricing-cta.primary:hover {
    background: var(--brand-hover);
  }

  .pricing-cta.secondary {
    background: var(--bg-secondary);
    color: var(--text-primary);
    border: 1px solid var(--border-primary);
  }

  .pricing-cta.secondary:hover {
    border-color: var(--border-hover);
  }

  /* Testimonials */
  .testimonials-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .testimonials-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .testimonial-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: 1rem;
    padding: 2rem;
    animation: fade-up 0.6s ease-out both;
    animation-delay: var(--delay);
  }

  .testimonial-metric {
    margin-bottom: 1.5rem;
  }

  .t-metric-value {
    display: block;
    font-size: 2.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
  }

  .t-metric-label {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .testimonial-quote {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    font-style: italic;
    margin-bottom: 1.5rem;
  }

  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-primary);
  }

  .author-avatar {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 600;
    color: white;
  }

  .author-name {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 0.9375rem;
  }

  .author-role {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }

  /* FAQ Section */
  .faq-section {
    padding: 6rem 0;
    background: var(--bg-primary);
  }

  @media (min-width: 1024px) {
    .faq-section { padding: 8rem 0; }
  }

  .faq-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }

  @media (min-width: 1024px) {
    .faq-layout { grid-template-columns: 1fr 2fr; }
  }

  .faq-header {
    position: sticky;
    top: 6rem;
    align-self: start;
  }

  .faq-header .section-badge {
    margin-bottom: 1rem;
  }

  .faq-header .section-title {
    text-align: left;
    margin-bottom: 0.75rem;
  }

  .faq-header .section-desc {
    text-align: left;
  }

  .faq-contact {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 2rem;
    font-size: 0.875rem;
    color: var(--text-tertiary);
    text-decoration: none;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-weight: 500;
    color: var(--brand-primary);
    transition: gap 0.2s;
  }

  .faq-contact:hover .contact-link {
    gap: 0.625rem;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: 0.75rem;
    overflow: hidden;
    animation: fade-up 0.6s ease-out both;
    animation-delay: var(--delay);
  }

  .faq-item[open] {
    border-color: var(--border-hover);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    font-weight: 500;
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    flex-shrink: 0;
    color: var(--text-tertiary);
    transition: transform 0.2s;
  }

  .faq-item[open] .faq-chevron {
