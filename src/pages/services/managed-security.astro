---
import BuyerServicePage from '../../components/BuyerServicePage.astro';

const outcomes = [
  {
    title: 'Regular visibility',
    description: 'Security reviews, alerts, vulnerabilities, and improvement actions are tracked in a recurring cadence.',
    icon: 'monitor',
  },
  {
    title: 'Practical controls',
    description: 'Focus on identity, Microsoft 365, endpoints, email, backups, network access, and configuration risks.',
    icon: 'shield',
  },
  {
    title: 'Management reporting',
    description: 'Plain-English reporting helps owners and managers understand risk, progress, and decisions needed.',
    icon: 'compliance',
  },
];

const includes = [
  'Recurring Microsoft 365 and security configuration review',
  'Vulnerability and exposure follow-up',
  'Endpoint and email security review',
  'Backup and recovery control checks',
  'Incident readiness and contact review',
  'Security improvement roadmap',
  'Monthly or quarterly management summary',
  'Optional support for remediation tasks',
];

const process = [
  { title: 'Baseline', description: 'We establish the current state across Microsoft 365, devices, users, network access, backups, and documentation.' },
  { title: 'Prioritise', description: 'Centrix agrees the most important risks, quick wins, and controls to improve first.' },
  { title: 'Review', description: 'Recurring reviews track open actions, new issues, configuration drift, and evidence gaps.' },
  { title: 'Improve', description: 'The programme keeps security moving with practical recommendations and optional hands-on remediation.' },
];

const faqs = [
  {
    question: 'Is this a full security operations centre?',
    answer: 'No. It is a practical managed security service for businesses that need recurring visibility and improvement without overbuilding.',
  },
  {
    question: 'Can it include Microsoft 365?',
    answer: 'Yes. Microsoft 365, Defender, identity, devices, and email security are common parts of the review cadence.',
  },
  {
    question: 'Can this support compliance readiness?',
    answer: 'Yes. The recurring evidence and roadmap can support supplier, insurance, NIS2, GDPR, and management review conversations.',
  },
];
---

<BuyerServicePage
  mediaSrc="/products/managed-security.png"
  metaTitle="Managed Security Services"
  metaDescription="Practical managed security services for Irish businesses covering Microsoft 365, endpoints, email, backups, vulnerability follow-up, and management reporting."
  eyebrow="Managed Security"
  heading="Keep security improving after the initial project."
  lead="Centrix provides practical recurring security support for Irish businesses that need visibility, review cadence, remediation guidance, and management reporting."
  primaryCta={{ label: 'Discuss managed security', href: '/contact?service=managed-security' }}
  secondaryCta={{ label: 'View security services', href: '/security' }}
  proof={['Recurring control reviews', 'Security roadmap', 'Management reporting', 'Optional remediation support']}
  outcomes={outcomes}
  includes={includes}
  process={process}
  faqs={faqs}
  related={[
    { label: 'NIS2 and GDPR readiness', href: '/services/security/nis2-gdpr-readiness' },
    { label: 'Microsoft 365 security', href: '/services/microsoft-365' },
  ]}
/>
