---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = "Microsoft 365 Security Assessment | Waymark";
const description = "Comprehensive security evaluation of your Microsoft 365 tenant. Get actionable insights and a clear remediation roadmap in 5-10 days.";

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Microsoft 365 Security Assessment",
  "provider": {
    "@type": "Organization",
    "name": "Waymark"
  },
  "description": description,
  "serviceType": "Security Assessment",
  "areaServed": "Worldwide"
};

const assessmentAreas = [
  { title: "Identity & Access", description: "MFA, Conditional Access, privileged accounts, guest access policies", icon: "user", items: ["MFA enforcement gaps", "Conditional Access coverage", "Admin account hygiene", "Guest/external access review"] },
  { title: "Email Protection", description: "Anti-phishing, safe links, DMARC, email authentication", icon: "mail", items: ["Anti-phishing policies", "Safe Links & Attachments", "DMARC/DKIM/SPF config", "Mail flow rules review"] },
  { title: "Data Protection", description: "Sensitivity labels, DLP, external sharing, retention", icon: "lock", items: ["Sensitivity label usage", "DLP policy coverage", "External sharing exposure", "Retention compliance"] },
  { title: "Endpoint Security", description: "Defender configuration, device compliance, attack surface", icon: "device", items: ["Defender for Endpoint status", "Attack surface reduction", "Device compliance gaps", "Security baseline adherence"] },
  { title: "Cloud Apps", description: "OAuth apps, shadow IT, risky applications", icon: "cloud", items: ["OAuth consent inventory", "Risky app identification", "Shadow IT discovery", "App governance recommendations"] },
  { title: "Audit & Monitoring", description: "Logging, alerts, incident readiness", icon: "activity", items: ["Unified audit log status", "Alert policies review", "Log retention adequacy", "Incident response readiness"] },
];

const deliverables = [
  { title: "Executive Summary", description: "Board-ready overview with risk score and key findings", icon: "presentation" },
  { title: "Technical Report", description: "Detailed findings with evidence and impact analysis", icon: "document" },
  { title: "Top 20 Priorities", description: "Ranked remediation backlog with effort estimates", icon: "list" },
  { title: "30/60/90 Roadmap", description: "Phased implementation plan aligned to your resources", icon: "calendar" },
];

const packages = [
  {
    name: "Essential",
    price: "2,500",
    description: "For small tenants up to 50 users",
    features: [
      "Core security configuration review",
      "Identity & access assessment",
      "Email protection analysis",
      "Executive summary report",
      "Top 10 priority fixes",
      "30-minute findings call",
    ],
    featured: false,
  },
  {
    name: "Professional",
    price: "5,000",
    description: "For organizations with 50-500 users",
    features: [
      "Everything in Essential, plus:",
      "Full 6-area deep dive",
      "Data protection & DLP review",
      "Endpoint security assessment",
      "Detailed technical report",
      "Top 20 prioritized backlog",
      "30/60/90 day roadmap",
      "60-minute workshop",
    ],
    featured: true,
  },
  {
    name: "Enterprise",
    price: "Custom",
    description: "For complex multi-tenant environments",
    features: [
      "Everything in Professional, plus:",
      "Multi-tenant assessment",
      "Hybrid identity review",
      "Compliance mapping (SOC2, ISO)",
      "Custom policy templates",
      "Executive presentation",
      "Remediation support hours",
      "Quarterly reassessment option",
    ],
    featured: false,
  },
];

const faqs = [
  { q: "How long does the assessment take?", a: "Most assessments complete within 5-10 business days depending on tenant complexity. You'll receive preliminary findings within the first week." },
  { q: "Do you need admin access to our tenant?", a: "Yes, we require Global Reader access (read-only) to conduct the assessment. We never make changes to your environment during the assessment phase." },
  { q: "Will this disrupt our users?", a: "No. The assessment is entirely read-only and runs in the background. Your users won't notice anything different." },
  { q: "What if we've already done a Microsoft Secure Score review?", a: "Secure Score is a starting point, but misses context. Our assessment goes deeper into actual risk exposure, policy effectiveness, and provides prioritized remediation that Secure Score doesn't offer." },
  { q: "Can you help implement the recommendations?", a: "Absolutely. Most clients move forward with a remediation phase after the assessment. We offer fixed-scope implementation packages or can work on a time-and-materials basis." },
];

const testimonial = {
  quote: "The assessment revealed blind spots we didn't know existed. Within 60 days of implementing their recommendations, our Secure Score jumped from 42 to 78 and we closed critical gaps in our Conditional Access policies.",
  author: "Sarah Chen",
  role: "IT Director",
  company: "Meridian Financial Services",
};
---

<BaseLayout title={title} description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <section class="hero">
    <div class="hero-bg">
      <div class="hero-gradient"></div>
      <div class="hero-grid"></div>
      <div class="hero-orbs">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
      </div>
    </div>
    <div class="container-wide">
      <div class="hero-content">
        <nav class="breadcrumb">
          <a href="/services">Services</a>
          <span>/</span>
          <a href="/services/microsoft-365">Microsoft 365</a>
          <span>/</span>
          <span>Security Assessment</span>
        </nav>
        <h1 class="hero-title">Microsoft 365<br /><span class="hero-title-accent">Security Assessment</span></h1>
        <p class="hero-description">Know exactly where you stand. Get a comprehensive security evaluation of your Microsoft 365 tenant with actionable insights and a clear path forward.</p>
        <div class="hero-stats">
          <div class="hero-stat">
            <span class="hero-stat-value">5-10</span>
            <span class="hero-stat-label">Days</span>
          </div>
          <div class="hero-stat">
            <span class="hero-stat-value">6</span>
            <span class="hero-stat-label">Security Areas</span>
          </div>
          <div class="hero-stat">
            <span class="hero-stat-value">Zero</span>
            <span class="hero-stat-label">Disruption</span>
          </div>
        </div>
        <div class="hero-actions">
          <a href="#pricing" class="btn-hero-primary">
            See Pricing
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </a>
          <a href="/contact?service=m365-security-assessment" class="btn-hero-secondary">Book a Call</a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="score-card">
          <div class="score-header">
            <span class="score-label">Security Score</span>
            <span class="score-badge">Before Assessment</span>
          </div>
          <div class="score-ring">
            <svg viewBox="0 0 120 120">
              <circle cx="60" cy="60" r="54" fill="none" stroke="var(--border-primary)" stroke-width="8"/>
              <circle cx="60" cy="60" r="54" fill="none" stroke="#ef4444" stroke-width="8" stroke-dasharray="339.3" stroke-dashoffset="203.6" stroke-linecap="round" transform="rotate(-90 60 60)"/>
            </svg>
            <div class="score-value">
              <span class="score-number">42</span>
              <span class="score-percent">%</span>
            </div>
          </div>
          <div class="score-issues">
            <div class="issue-item issue-critical">
              <span class="issue-count">12</span>
              <span class="issue-label">Critical</span>
            </div>
            <div class="issue-item issue-high">
              <span class="issue-count">24</span>
              <span class="issue-label">High</span>
            </div>
            <div class="issue-item issue-medium">
              <span class="issue-count">31</span>
              <span class="issue-label">Medium</span>
            </div>
          </div>
        </div>
        <div class="score-arrow">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </div>
        <div class="score-card score-card-after">
          <div class="score-header">
            <span class="score-label">Security Score</span>
            <span class="score-badge score-badge-success">After Remediation</span>
          </div>
          <div class="score-ring">
            <svg viewBox="0 0 120 120">
              <circle cx="60" cy="60" r="54" fill="none" stroke="var(--border-primary)" stroke-width="8"/>
              <circle cx="60" cy="60" r="54" fill="none" stroke="#22c55e" stroke-width="8" stroke-dasharray="339.3" stroke-dashoffset="74.6" stroke-linecap="round" transform="rotate(-90 60 60)"/>
            </svg>
            <div class="score-value">
              <span class="score-number score-green">78</span>
              <span class="score-percent">%</span>
            </div>
          </div>
          <div class="score-issues">
            <div class="issue-item issue-resolved">
              <span class="issue-count">0</span>
              <span class="issue-label">Critical</span>
            </div>
            <div class="issue-item issue-resolved">
              <span class="issue-count">3</span>
              <span class="issue-label">High</span>
            </div>
            <div class="issue-item issue-resolved">
              <span class="issue-count">8</span>
              <span class="issue-label">Medium</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="assessment-section">
    <div class="container-wide">
      <div class="section-header">
        <span class="section-tag">What We Assess</span>
        <h2 class="section-title">Six critical security areas</h2>
        <p class="section-description">We examine every corner of your Microsoft 365 security configuration to identify gaps and provide prioritized recommendations.</p>
      </div>
      <div class="assessment-grid">
        {assessmentAreas.map((area, index) => (
          <div class="assessment-card" style={`animation-delay: ${index * 0.1}s`}>
            <div class="assessment-icon">
              {area.icon === 'user' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>}
              {area.icon === 'mail' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>}
              {area.icon === 'lock' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>}
              {area.icon === 'device' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>}
              {area.icon === 'cloud' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>}
              {area.icon === 'activity' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>}
            </div>
            <h3 class="assessment-title">{area.title}</h3>
            <p class="assessment-description">{area.description}</p>
            <ul class="assessment-items">
              {area.items.map((item) => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="deliverables-section">
    <div class="container-wide">
      <div class="section-header">
        <span class="section-tag">Deliverables</span>
        <h2 class="section-title">What you'll receive</h2>
        <p class="section-description">Clear, actionable outputs designed for both executives and technical teams.</p>
      </div>
      <div class="deliverables-grid">
        {deliverables.map((item, index) => (
          <div class="deliverable-card" style={`animation-delay: ${index * 0.1}s`}>
            <div class="deliverable-icon">
              {item.icon === 'presentation' && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>}
              {item.icon === 'document' && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>}
              {item.icon === 'list' && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>}
              {item.icon === 'calendar' && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>}
            </div>
            <h3 class="deliverable-title">{item.title}</h3>
            <p class="deliverable-description">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="testimonial-section">
    <div class="container-wide">
      <div class="testimonial-card">
        <div class="testimonial-quote">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" opacity="0.1">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
          </svg>
          <blockquote>{testimonial.quote}</blockquote>
        </div>
        <div class="testimonial-author">
          <div class="author-avatar">
            <span>{testimonial.author.split(' ').map(n => n[0]).join('')}</span>
          </div>
          <div class="author-info">
            <div class="author-name">{testimonial.author}</div>
            <div class="author-role">{testimonial.role}, {testimonial.company}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="pricing" class="pricing-section">
    <div class="container-wide">
      <div class="section-header section-header-center">
        <span class="section-tag">Pricing</span>
        <h2 class="section-title">Choose your assessment package</h2>
        <p class="section-description">Transparent pricing. No hidden fees. Fixed scope.</p>
      </div>
      <div class="pricing-grid">
        {packages.map((pkg, index) => (
          <div class={`pricing-card ${pkg.featured ? 'featured' : ''}`} style={`animation-delay: ${index * 0.1}s`}>
            {pkg.featured && <div class="pricing-badge">Most Popular</div>}
            <div class="pricing-header">
              <h3 class="pricing-name">{pkg.name}</h3>
              <p class="pricing-description">{pkg.description}</p>
              <div class="pricing-price">
                {pkg.price === 'Custom' ? (
                  <span class="price-custom">Custom</span>
                ) : (
                  <>
                    <span class="price-currency">$</span>
                    <span class="price-amount">{pkg.price}</span>
                  </>
                )}
              </div>
            </div>
            <ul class="pricing-features">
              {pkg.features.map((feature) => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                  {feature}
                </li>
              ))}
            </ul>
            <a href={`/contact?service=m365-security-assessment&package=${pkg.name.toLowerCase()}`} class={`pricing-btn ${pkg.featured ? 'pricing-btn-primary' : 'pricing-btn-secondary'}`}>
              {pkg.price === 'Custom' ? 'Contact Us' : 'Get Started'}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="container-wide">
      <div class="section-header section-header-center">
        <span class="section-tag">FAQ</span>
        <h2 class="section-title">Common questions</h2>
      </div>
      <div class="faq-grid">
        {faqs.map((faq, index) => (
          <div class="faq-item" style={`animation-delay: ${index * 0.05}s`}>
            <h3 class="faq-question">{faq.q}</h3>
            <p class="faq-answer">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container-wide">
      <div class="cta-card">
        <div class="cta-content">
          <h2 class="cta-title">Ready to understand your security posture?</h2>
          <p class="cta-description">Get clarity on your Microsoft 365 security with a comprehensive assessment. No disruption, clear outcomes.</p>
          <div class="cta-actions">
            <a href="/contact?service=m365-security-assessment" class="btn-cta-primary">
              Schedule Assessment
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
            </a>
            <a href="/services/microsoft-365" class="btn-cta-secondary">View All M365 Services</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :root {
    --accent: #0078d4;
    --accent-light: rgba(0, 120, 212, 0.1);
    --accent-glow: rgba(0, 120, 212, 0.3);
  }

  .hero {
    position: relative;
    padding: 6rem 0 4rem;
    overflow: hidden;
  }
  @media (min-width: 1024px) {
    .hero { padding: 8rem 0 6rem; }
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-primary) 50%, var(--bg-secondary) 100%);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(var(--border-primary) 1px, transparent 1px),
                      linear-gradient(90deg, var(--border-primary) 1px, transparent 1px);
    background-size: 60px 60px;
    opacity: 0.4;
    mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
  }

  .hero-orbs {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.4;
    animation: float 20s ease-in-out infinite;
  }

  .orb-1 {
    width: 400px;
    height: 400px;
    background: var(--accent-glow);
    top: -100px;
    right: 20%;
    animation-delay: 0s;
  }

  .orb-2 {
    width: 300px;
    height: 300px;
    background: rgba(139, 92, 246, 0.2);
    bottom: 0;
    left: 10%;
    animation-delay: -10s;
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(30px, -30px) scale(1.05); }
    50% { transform: translate(-20px, 20px) scale(0.95); }
    75% { transform: translate(20px, 10px) scale(1.02); }
  }

  .hero .container-wide {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero .container-wide {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-tertiary);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a {
    color: var(--text-tertiary);
    text-decoration: none;
    transition: color 0.2s;
  }
  .breadcrumb a:hover {
    color: var(--accent);
  }

  .hero-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }
  @media (min-width: 768px) {
    .hero-title { font-size: 3.5rem; }
  }

  .hero-title-accent {
    background: linear-gradient(135deg, var(--accent), #8b5cf6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-description {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .hero-stats {
    display: flex;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
  }

  .hero-stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .hero-stat-label {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    background: var(--accent);
    color: white;
    font-weight: 500;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.2s;
  }
  .btn-hero-primary:hover {
    background: #106ebe;
    transform: translateY(-1px);
    box-shadow: 0 10px 30px -10px var(--accent-glow);
  }

  .btn-hero-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    background: var(--bg-primary);
    color: var(--text-primary);
    font-weight: 500;
    border: 1px solid var(--border-primary);
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.2s;
  }
  .btn-hero-secondary:hover {
    border-color: var(--border-hover);
    background: var(--bg-secondary);
  }

  .hero-visual {
    display: none;
  }
