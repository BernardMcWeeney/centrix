---
import BuyerServicePage from '../../../components/BuyerServicePage.astro';

const outcomes = [
  {
    title: 'Safer sign-ins',
    description: 'MFA, Conditional Access, admin role review, break-glass accounts, and guest access controls.',
    icon: 'lock',
  },
  {
    title: 'Better protection',
    description: 'Defender, email security, device controls, anti-phishing, audit logging, and alert handling configured properly.',
    icon: 'shield',
  },
  {
    title: 'Clear roadmap',
    description: 'A practical improvement plan covering Microsoft 365 settings, users, devices, data, and ongoing governance.',
    icon: 'compliance',
  },
];

const includes = [
  'Microsoft 365 tenant security review',
  'Secure Score and priority control assessment',
  'MFA and Conditional Access baseline',
  'Admin roles and privileged access review',
  'Defender and email protection review',
  'SharePoint and external sharing review',
  'Device and Intune readiness check',
  'Remediation roadmap and handover documentation',
];

const process = [
  { title: 'Assess', description: 'We review your Microsoft 365 tenant, users, licensing, identity, devices, data sharing, and security settings.' },
  { title: 'Prioritise', description: 'Findings are grouped into practical actions based on risk, business impact, and implementation effort.' },
  { title: 'Harden', description: 'Centrix can implement agreed controls such as MFA, Conditional Access, Defender, sharing, and admin changes.' },
  { title: 'Maintain', description: 'We can provide recurring checks, management reporting, and support as users, devices, and threats change.' },
];

const faqs = [
  {
    question: 'Can this be done without disrupting users?',
    answer: 'Most controls can be staged and tested before wider rollout. We plan carefully around staff impact and business-critical access.',
  },
  {
    question: 'Do we need premium Microsoft licences?',
    answer: 'Some controls need specific licences. We review your licensing and recommend practical options before assuming upgrades.',
  },
  {
    question: 'Can you implement the fixes?',
    answer: 'Yes. We can provide a review only, or continue into implementation and ongoing Microsoft 365 support.',
  },
];
---

<BuyerServicePage
  metaTitle="Microsoft 365 Security And Management"
  metaDescription="Microsoft 365 security review, hardening, Defender, Conditional Access, identity, device, and data protection services for Irish businesses."
  eyebrow="Microsoft 365 Security"
  heading="Is your Microsoft 365 tenant configured securely?"
  lead="Centrix helps Irish businesses review, harden, and manage Microsoft 365 so email, identity, devices, files, and admin access are protected properly."
  primaryCta={{ label: 'Book a Microsoft 365 review', href: '/contact?service=microsoft-365-security' }}
  secondaryCta={{ label: 'Plan cloud migration', href: '/services/microsoft-365/cloud-migration' }}
  proof={['Tenant security review', 'MFA and Conditional Access baseline', 'Defender and email security checks', 'Practical remediation roadmap']}
  outcomes={outcomes}
  includes={includes}
  process={process}
  faqs={faqs}
  related={[
    { label: 'Cloud migration', href: '/services/microsoft-365/cloud-migration' },
    { label: 'Microsoft services', href: '/microsoft' },
  ]}
/>
