---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = "Microsoft 365 Security & Management | Waymark";
const description = "Enterprise Microsoft 365 security assessments, hardening, and managed services. Secure your cloud platform with expert guidance.";

const services = [
  {
    id: "security-assessment",
    title: "Security Assessment",
    description: "Comprehensive evaluation of your Microsoft 365 security posture with actionable remediation roadmap.",
    href: "/services/microsoft-365/security-assessment",
    icon: "search",
    color: "blue",
    featured: true,
    stats: "5-10 days"
  },
  {
    id: "conditional-access",
    title: "Conditional Access Hardening",
    description: "Zero-trust access controls with policy-based protection for your entire organization.",
    href: "/services/microsoft-365/conditional-access",
    icon: "lock",
    color: "purple",
    stats: "1-2 weeks"
  },
  {
    id: "defender",
    title: "Defender Suite Setup",
    description: "Full endpoint, email, and cloud app protection with Microsoft Defender.",
    href: "/services/microsoft-365/defender",
    icon: "shield",
    color: "green",
    stats: "1-2 weeks"
  },
  {
    id: "tenant-management",
    title: "Managed Tenant Operations",
    description: "Ongoing Microsoft 365 management with security monitoring and optimization.",
    href: "/contact?service=m365-tenant-management",
    icon: "settings",
    color: "orange",
    stats: "Monthly"
  },
];

const benefits = [
  { title: "Microsoft Certified", description: "Our team holds multiple Microsoft security certifications", icon: "badge" },
  { title: "Proven Methodology", description: "Battle-tested approach across hundreds of tenants", icon: "check" },
  { title: "Clear Deliverables", description: "Fixed scope, clear outcomes, no surprises", icon: "document" },
  { title: "Ongoing Support", description: "We're here for the long haul, not just the project", icon: "support" },
];
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-gradient"></div>
      <div class="hero-grid"></div>
      <div class="hero-orbs">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
      </div>
    </div>
    <div class="container-wide">
      <div class="hero-content">
        <div class="hero-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 3h12l4 6-10 13L2 9z"/>
          </svg>
          Microsoft Partner
        </div>
        <h1 class="hero-title">Microsoft 365<br /><span class="hero-title-accent">Security</span></h1>
        <p class="hero-description">Unlock the full security potential of your Microsoft 365 investment. From assessments to managed operations, we help you build a secure, compliant cloud platform.</p>
        <div class="hero-actions">
          <a href="/services/microsoft-365/security-assessment" class="btn-hero-primary">
            Start with Assessment
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
          <a href="#services" class="btn-hero-secondary">Explore Services</a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="m365-diagram">
          <div class="diagram-center">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M6 3h12l4 6-10 13L2 9z"/>
            </svg>
          </div>
          <div class="diagram-ring ring-1">
            <div class="ring-item" style="--angle: 0deg"><span>Identity</span></div>
            <div class="ring-item" style="--angle: 72deg"><span>Email</span></div>
            <div class="ring-item" style="--angle: 144deg"><span>Endpoints</span></div>
            <div class="ring-item" style="--angle: 216deg"><span>Data</span></div>
            <div class="ring-item" style="--angle: 288deg"><span>Apps</span></div>
          </div>
          <div class="diagram-ring ring-2">
            <div class="ring-pulse"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="stats-section">
    <div class="container-wide">
      <div class="stats-grid">
        <div class="stat-item">
          <div class="stat-value">500+</div>
          <div class="stat-label">Tenants Secured</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">94%</div>
          <div class="stat-label">Avg Score Improvement</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">48hr</div>
          <div class="stat-label">Report Delivery</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">Zero</div>
          <div class="stat-label">Downtime Required</div>
        </div>
      </div>
    </div>
  </section>

  <section id="services" class="services-section">
    <div class="container-wide">
      <div class="section-header">
        <span class="section-tag">Services</span>
        <h2 class="section-title">Microsoft 365 security services</h2>
        <p class="section-description">From one-time assessments to ongoing managed security, we've got your Microsoft 365 environment covered.</p>
      </div>
      <div class="services-grid">
        {services.map((service, index) => (
          <a href={service.href} class={`service-card service-card-${service.color} ${service.featured ? 'featured' : ''}`} style={`animation-delay: ${index * 0.1}s`}>
            {service.featured && <div class="featured-badge">Most Popular</div>}
            <div class="service-icon">
              {service.icon === 'search' && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>}
              {service.icon === 'lock' && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>}
              {service.icon === 'shield' && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>}
              {service.icon === 'settings' && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>}
            </div>
            <h3 class="service-title">{service.title}</h3>
            <p class="service-description">{service.description}</p>
            <div class="service-footer">
              <span class="service-stat">{service.stats}</span>
              <span class="service-arrow">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="benefits-section">
    <div class="container-wide">
      <div class="section-header">
        <span class="section-tag">Why Waymark</span>
        <h2 class="section-title">Microsoft 365 experts you can trust</h2>
      </div>
      <div class="benefits-grid">
        {benefits.map((benefit, index) => (
          <div class="benefit-card" style={`animation-delay: ${index * 0.1}s`}>
            <div class="benefit-icon">
              {benefit.icon === 'badge' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 15l-2 5 2-1 2 1-2-5z"/><circle cx="12" cy="8" r="6"/></svg>}
              {benefit.icon === 'check' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>}
              {benefit.icon === 'document' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>}
              {benefit.icon === 'support' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>}
            </div>
            <h3 class="benefit-title">{benefit.title}</h3>
            <p class="benefit-description">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container-wide">
      <div class="cta-card">
        <div class="cta-content">
          <h2 class="cta-title">Ready to secure your Microsoft 365?</h2>
          <p class="cta-description">Start with a security assessment to understand your current posture and get a clear remediation roadmap.</p>
          <div class="cta-actions">
            <a href="/services/microsoft-365/security-assessment" class="btn-cta-primary">
              Get Security Assessment
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
            </a>
            <a href="/contact" class="btn-cta-secondary">Talk to an Expert</a>
          </div>
        </div>
        <div class="cta-graphic">
          <div class="cta-shield">
            <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :root {
    --accent: #0078d4;
    --accent-light: rgba(0, 120, 212, 0.1);
    --accent-glow: rgba(0, 120, 212, 0.3);
  }

  .hero {
    position: relative;
    padding: 8rem 0 6rem;
    overflow: hidden;
  }
  @media (min-width: 1024px) {
    .hero { padding: 10rem 0 8rem; }
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-primary) 50%, var(--bg-secondary) 100%);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(var(--border-primary) 1px, transparent 1px),
                      linear-gradient(90deg, var(--border-primary) 1px, transparent 1px);
    background-size: 60px 60px;
    opacity: 0.4;
    mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
  }

  .hero-orbs {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.5;
    animation: float 20s ease-in-out infinite;
  }

  .orb-1 {
    width: 400px;
    height: 400px;
    background: var(--accent-glow);
    top: -100px;
    right: -100px;
    animation-delay: 0s;
  }

  .orb-2 {
    width: 300px;
    height: 300px;
    background: rgba(139, 92, 246, 0.2);
    bottom: -50px;
    left: -50px;
    animation-delay: -7s;
  }

  .orb-3 {
    width: 200px;
    height: 200px;
    background: rgba(34, 197, 94, 0.2);
    top: 50%;
    left: 30%;
    animation-delay: -14s;
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(30px, -30px) scale(1.05); }
    50% { transform: translate(-20px, 20px) scale(0.95); }
    75% { transform: translate(20px, 10px) scale(1.02); }
  }

  .hero .container-wide {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero .container-wide {
      grid-template-columns: 1fr 1fr;
    }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--accent-light);
    border: 1px solid var(--accent);
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: 3rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }
  @media (min-width: 768px) {
    .hero-title { font-size: 4rem; }
  }

  .hero-title-accent {
    background: linear-gradient(135deg, var(--accent), #8b5cf6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-description {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 2rem;
    max-width: 540px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    background: var(--accent);
    color: white;
    font-weight: 500;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.2s;
  }
  .btn-hero-primary:hover {
    background: #106ebe;
    transform: translateY(-1px);
    box-shadow: 0 10px 30px -10px var(--accent-glow);
  }

  .btn-hero-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    background: var(--bg-primary);
    color: var(--text-primary);
    font-weight: 500;
    border: 1px solid var(--border-primary);
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.2s;
  }
  .btn-hero-secondary:hover {
    border-color: var(--border-hover);
    background: var(--bg-secondary);
  }

  .hero-visual {
    display: none;
  }
  @media (min-width: 1024px) {
    .hero-visual {
      display: flex;
      justify-content: center;
      align-items: center;
    }
  }

  .m365-diagram {
    position: relative;
    width: 350px;
    height: 350px;
  }

  .diagram-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80px;
    height: 80px;
    background: var(--bg-primary);
    border: 2px solid var(--accent);
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    box-shadow: 0 0 40px var(--accent-glow);
    z-index: 2;
  }

  .diagram-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
  }

  .ring-1 {
    width: 280px;
    height: 280px;
    border: 1px dashed var(--border-secondary);
    animation: spin 60s linear infinite;
  }

  .ring-item {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 70px;
    height: 70px;
    margin: -35px;
    transform: rotate(var(--angle)) translateX(140px) rotate(calc(-1 * var(--angle)));
    background: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.3s;
  }
  .ring-item:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: rotate(var(--angle)) translateX(140px) rotate(calc(-1 * var(--angle))) scale(1.1);
  }

  .ring-2 {
    width: 320px;
    height: 320px;
    border: 1px solid transparent;
    background: linear-gradient(var(--bg-primary), var(--bg-primary)) padding-box,
                linear-gradient(135deg, var(--accent), transparent, #8b5cf6) border-box;
    opacity: 0.3;
  }

  .ring-pulse {
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    animation: pulse 3s ease-in-out infinite;
  }

  @keyframes spin {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  @keyframes pulse {
    0%, 100% { opacity: 0; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.05); }
  }

  .stats-section {
    padding: 3rem 0;
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-primary);
    border-bottom: 1px solid var(--border-primary);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .stats-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .stat-item { text-align: center; }

  .stat-value {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    margin-top: 0.5rem;
  }

  .services-section {
    padding: 6rem 0;
  }
  @media (min-width: 1024px) {
    .services-section { padding: 8rem 0; }
  }

  .section-header {
    max-width: 42rem;
    margin-bottom: 3rem;
  }

  .section-tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--accent-light);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 9999px;
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  @media (min-width: 768px) {
    .section-title { font-size: 2.75rem; }
  }

  .section-description {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .services-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .service-card {
    position: relative;
    background: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: 1rem;
    padding: 2rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: all 0.3s;
    animation: fadeInUp 0.5s ease-out both;
    overflow: hidden;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .service-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--card-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s;
  }

  .service-card:hover {
    border-color: var(--card-accent);
    transform: translateY(-4px);
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.15);
  }
  .service-card:hover::before {
    transform: scaleX(1);
  }

  .service-card.featured {
    border-color: var(--accent);
    background: linear-gradient(135deg, var(--bg-primary) 0%, var(--accent-light) 100%);
  }

  .service-card-blue { --card-accent: #0078d4; }
  .service-card-purple { --card-accent: #8b5cf6; }
  .service-card-green { --card-accent: #22c55e; }
  .service-card-orange { --card-accent: #f97316; }

  .featured-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.25rem 0.75rem;
    background: var(--accent);
    color: white;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 9999px;
  }

  .service-icon {
    width: 56px;
    height: 56px;
    background: var(--bg-secondary);
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--card-accent);
    margin-bottom: 1.5rem;
    transition: all 0.3s;
  }
  .service-card:hover .service-icon {
    background: var(--card-accent);
    color: white;
  }

  .service-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .service-description {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    flex: 1;
