---
import BuyerServicePage from '../../components/BuyerServicePage.astro';

const outcomes = [
  {
    title: 'Clear migration plan',
    description: 'Understand users, systems, data, domains, devices, and risks before moving platforms.',
    icon: 'cloud',
  },
  {
    title: 'Controlled changeover',
    description: 'Plan communication, cutover, support, and validation around the way the business operates.',
    icon: 'settings',
  },
  {
    title: 'Secure destination',
    description: 'Build identity, MFA, sharing, device, and recovery thinking into the migration rather than after it.',
    icon: 'shield',
  },
];

const includes = [
  'Migration discovery and readiness review',
  'Source and destination planning',
  'Email, files, users, and identity review',
  'Cutover and user communication guidance',
  'Security baseline recommendations',
  'Post-migration validation and handover',
];

const process = [
  { title: 'Discover', description: 'Review the current platform, users, data, devices, and business dependencies.' },
  { title: 'Plan', description: 'Create a practical migration sequence with risks, assumptions, and support steps.' },
  { title: 'Move', description: 'Carry out the agreed migration with testing, communication, and validation.' },
  { title: 'Improve', description: 'Tidy security, sharing, documentation, and support after the move.' },
];
---

<BuyerServicePage
  metaTitle="Migration Services"
  metaDescription="Business migration services for email, files, identity, Microsoft cloud, and platform moves."
  eyebrow="Migration Services"
  heading="Move systems, users, and data with a clear plan."
  lead="Centrix helps Irish businesses move email, files, identity, and platforms in a controlled way, with security and handover included."
  primaryCta={{ label: 'Discuss a migration', href: '/contact?service=migration' }}
  secondaryCta={{ label: 'Microsoft cloud migration', href: '/services/microsoft-365/cloud-migration' }}
  proof={['Discovery and readiness review', 'Cutover planning', 'Security baseline', 'Post-migration handover']}
  outcomes={outcomes}
  includes={includes}
  process={process}
/>
