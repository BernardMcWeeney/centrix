---
import BuyerServicePage from '../../../components/BuyerServicePage.astro';

const outcomes = [
  {
    title: 'Cleaner permissions',
    description: 'Review SharePoint, Teams, OneDrive, guest access, external sharing, and oversharing before Copilot is enabled.',
    icon: 'microsoft',
  },
  {
    title: 'Better data protection',
    description: 'Sensitivity labels, DLP thinking, data locations, and user guidance are planned before AI can surface content.',
    icon: 'shield',
  },
  {
    title: 'Controlled rollout',
    description: 'Start with a pilot group, clear use cases, staff guidance, success measures, and a support process.',
    icon: 'ai',
  },
];

const includes = [
  'Microsoft 365 Copilot readiness workshop',
  'SharePoint, Teams, and OneDrive permission review',
  'External sharing and guest access review',
  'Sensitive data and label readiness discussion',
  'Oversharing risk and remediation backlog',
  'Pilot group and rollout planning',
  'Staff guidance for safe Copilot use',
  'Management summary and next steps',
];

const process = [
  { title: 'Review', description: 'We review the Microsoft 365 environment, data locations, sharing, user access, and readiness for AI-assisted search and summarisation.' },
  { title: 'Prioritise', description: 'Centrix identifies permission, sharing, and data hygiene items that should be addressed before rollout.' },
  { title: 'Prepare', description: 'We help plan controls, pilot groups, staff guidance, and a practical rollout approach.' },
  { title: 'Roll out', description: 'Copilot can then be introduced to a controlled group with feedback, support, and measured outcomes.' },
];

const faqs = [
  {
    question: 'Why check permissions before Copilot?',
    answer: 'Copilot works with the access users already have. If files are over-shared, AI can make that problem easier to discover.',
  },
  {
    question: 'Can this be part of a broader AI introduction?',
    answer: 'Yes. Copilot readiness can sit alongside a wider AI introduction covering ChatGPT, Claude, governance, and staff guidance.',
  },
  {
    question: 'Do we need to buy licences first?',
    answer: 'No. It is often better to review readiness, select pilot users, and understand the business case before broad licensing decisions.',
  },
];
---

<BuyerServicePage
  mediaSrc="/products/copilot-ai.png"
  metaTitle="Microsoft 365 Copilot Readiness"
  metaDescription="Microsoft 365 Copilot readiness review covering SharePoint permissions, Teams, OneDrive, external sharing, sensitive data, pilot rollout, and staff guidance."
  eyebrow="Copilot Readiness"
  heading="Prepare Microsoft 365 before Copilot sees your business data."
  lead="Centrix helps Irish businesses check permissions, sharing, sensitive data, governance, and rollout plans before enabling Microsoft 365 Copilot."
  primaryCta={{ label: 'Book a Copilot readiness review', href: '/contact?service=copilot-readiness' }}
  secondaryCta={{ label: 'View AI services', href: '/services/ai-services' }}
  proof={['Permissions and sharing review', 'Sensitive data readiness', 'Pilot rollout plan', 'Staff guidance and handover']}
  outcomes={outcomes}
  includes={includes}
  process={process}
  faqs={faqs}
  related={[
    { label: 'AI introduction', href: '/services/ai-services' },
    { label: 'Business AI automation', href: '/services/ai-services/business-ai-automation' },
  ]}
/>
