---
import BuyerServicePage from '../../../components/BuyerServicePage.astro';

const outcomes = [
  {
    title: 'Useful priorities',
    description: 'Identify where AI can reduce admin, improve customer response, support reporting, or help internal knowledge work.',
    icon: 'ai',
  },
  {
    title: 'Clear governance',
    description: 'Define approved tools, data rules, review steps, ownership, and rollout boundaries before adoption spreads.',
    icon: 'compliance',
  },
  {
    title: 'Pilot roadmap',
    description: 'Turn ideas into a short, realistic roadmap with pilot users, success measures, and support expectations.',
    icon: 'settings',
  },
];

const includes = [
  'AI opportunity workshop',
  'ChatGPT, Claude, Copilot, and platform fit discussion',
  'Workflow and data risk review',
  'Use case scoring by value, effort, and risk',
  'Governance and staff guidance outline',
  'Pilot roadmap and rollout sequence',
  'Management summary',
  'Next-step implementation options',
];

const process = [
  { title: 'Map', description: 'We map workflows, pain points, information sources, user groups, and current Microsoft or cloud setup.' },
  { title: 'Score', description: 'Potential use cases are scored by business value, complexity, data risk, and ease of adoption.' },
  { title: 'Plan', description: 'Centrix creates a practical AI roadmap with governance, pilot options, and implementation sequence.' },
  { title: 'Act', description: 'The roadmap can feed into workshops, Copilot readiness, automation pilots, or wider AI adoption support.' },
];

const faqs = [
  {
    question: 'Is this for small businesses too?',
    answer: 'Yes. AI strategy for most businesses should be practical and lightweight, not an enterprise transformation document.',
  },
  {
    question: 'Will this include specific tools?',
    answer: 'Yes. We can discuss ChatGPT, Claude, Copilot, Cloudflare AI, Microsoft 365, and automation tools in the context of your business.',
  },
  {
    question: 'What is the output?',
    answer: 'A practical roadmap, use case shortlist, governance outline, and recommended next steps.',
  },
];
---

<BuyerServicePage
  mediaSrc="/products/ai-for-business.png"
  metaTitle="AI Strategy For Irish Businesses"
  metaDescription="Practical AI strategy for Irish businesses covering ChatGPT, Claude, Copilot, Cloudflare AI, governance, workflow use cases, and pilots."
  eyebrow="AI Strategy"
  heading="Build a practical AI roadmap for your business."
  lead="Centrix helps Irish businesses decide where AI fits, which tools to approve, what risks to control, and which workflow pilots should come first."
  primaryCta={{ label: 'Book an AI strategy workshop', href: '/contact?service=ai-strategy' }}
  secondaryCta={{ label: 'View AI services', href: '/services/ai-services' }}
  proof={['Use case shortlist', 'Tool and platform fit', 'Governance outline', 'Pilot roadmap']}
  outcomes={outcomes}
  includes={includes}
  process={process}
  faqs={faqs}
  related={[
    { label: 'AI introduction', href: '/services/ai-services' },
    { label: 'Copilot readiness', href: '/services/ai-services/copilot-readiness' },
  ]}
/>
