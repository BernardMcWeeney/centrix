---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = "AI Readiness & Strategy | Practical AI Planning | Centrix";
const description = "A practical AI plan tied to business workflows, not hype. Identify high-impact use cases, assess risks, and build a roadmap that delivers real results.";

const deliverables = [
  {
    title: "AI Roadmap Document",
    description: "Strategic plan for AI adoption aligned with your business goals and capabilities.",
    icon: "map",
  },
  {
    title: "Prioritized Use Cases",
    description: "Ranked list of AI opportunities based on impact, feasibility, and risk.",
    icon: "list",
  },
  {
    title: "Pilot Plan",
    description: "Detailed plan for your first AI pilot including scope, success metrics, and timeline.",
    icon: "beaker",
  },
  {
    title: "Risk Assessment",
    description: "Analysis of security, privacy, compliance, and operational risks with mitigation strategies.",
    icon: "shield",
  },
  {
    title: "Success Metrics",
    description: "KPIs and measurement framework to track AI impact and ROI.",
    icon: "chart",
  },
  {
    title: "Executive Presentation",
    description: "Board-ready materials to communicate AI strategy and secure buy-in.",
    icon: "presentation",
  },
];

const process = [
  {
    step: "01",
    title: "Discovery Workshop",
    description: "We meet with leadership and key stakeholders to understand business goals, pain points, and current technology landscape.",
    duration: "Days 1-3",
  },
  {
    step: "02",
    title: "Use Case Identification",
    description: "Interview teams across the organization to surface AI opportunities and document current workflows.",
    duration: "Days 4-8",
  },
  {
    step: "03",
    title: "Feasibility Analysis",
    description: "Assess each use case against your data, technology, and organizational readiness.",
    duration: "Days 9-12",
  },
  {
    step: "04",
    title: "Risk Assessment",
    description: "Evaluate security, privacy, compliance, and change management risks for top candidates.",
    duration: "Days 13-15",
  },
  {
    step: "05",
    title: "Roadmap Development",
    description: "Create prioritized implementation plan with quick wins, pilots, and long-term initiatives.",
    duration: "Days 16-20",
  },
];

const useCases = [
  {
    title: "Document Intelligence",
    description: "Automate document processing, extraction, and classification.",
    examples: ["Contract analysis", "Invoice processing", "Policy review"],
    icon: "document",
  },
  {
    title: "Knowledge & Search",
    description: "Make organizational knowledge accessible and actionable.",
    examples: ["Internal search", "FAQ automation", "Expertise finding"],
    icon: "search",
  },
  {
    title: "Customer Experience",
    description: "Enhance customer interactions with AI-powered assistance.",
    examples: ["Support automation", "Personalization", "Sentiment analysis"],
    icon: "users",
  },
  {
    title: "Operations & Analytics",
    description: "Improve decision-making with AI-driven insights.",
    examples: ["Forecasting", "Anomaly detection", "Process optimization"],
    icon: "chart",
  },
];

const pricing = {
  name: "AI Strategy Engagement",
  price: "From $8,000",
  description: "Comprehensive AI strategy development with executive-ready deliverables",
  features: [
    "Leadership workshop facilitation",
    "Cross-functional interviews",
    "Use case prioritization matrix",
    "Risk and readiness assessment",
    "AI roadmap (12-24 months)",
    "Pilot program design",
    "Executive presentation",
    "30-day follow-up support",
  ],
  timeline: "2-4 weeks",
};

const addOns = [
  { name: "Extended stakeholder interviews", price: "+$3,000" },
  { name: "Technical architecture review", price: "+$2,500" },
  { name: "Vendor selection support", price: "+$2,000" },
  { name: "Change management planning", price: "+$2,500" },
];

const faqs = [
  {
    question: "How is this different from consulting hype?",
    answer: "We focus on practical, implementable AI applications—not buzzwords. Every recommendation is grounded in your specific business context, technology capabilities, and organizational readiness. We only recommend what you can actually execute.",
  },
  {
    question: "What if we're not ready for AI?",
    answer: "That's valuable to know before investing in AI tools. Our assessment will identify readiness gaps and provide a roadmap to address them. Sometimes the answer is 'fix your data first'—and we'll tell you that honestly.",
  },
  {
    question: "Do you implement AI solutions?",
    answer: "We focus on strategy and planning, but we can help with Microsoft 365 Copilot readiness and implementation. For other AI implementations, we can recommend partners or provide oversight during vendor implementations.",
  },
  {
    question: "How do you measure AI ROI?",
    answer: "We establish clear metrics during the strategy phase—time savings, error reduction, cost avoidance, revenue impact. We help you build the measurement framework before you start so you can demonstrate value.",
  },
  {
    question: "What about AI governance and ethics?",
    answer: "Risk assessment and governance are core to our approach. We evaluate privacy, security, bias, and compliance implications for every use case and help you establish appropriate guardrails.",
  },
  {
    question: "How long until we see results from AI?",
    answer: "Quick wins can show value within weeks of implementation. Strategic initiatives typically take 3-6 months to demonstrate meaningful ROI. Our roadmap balances quick wins with longer-term transformation.",
  },
];

const testimonials = [
  {
    quote: "Centrix cut through the AI hype and helped us focus on what would actually move the needle. Our first pilot saved 200 hours per month.",
    author: "COO",
    company: "Financial Services Firm",
    metric: "200 hours/month saved",
  },
  {
    quote: "We thought we needed AI everywhere. The strategy showed us we needed it in three places—and that's where we're seeing real impact.",
    author: "VP of Operations",
    company: "Logistics Company",
    metric: "3 high-impact use cases",
  },
  {
    quote: "The executive presentation got immediate board approval. Clear, practical, and tied to business outcomes we actually care about.",
    author: "CTO",
    company: "Healthcare Provider",
    metric: "Board approval in 1 meeting",
  },
];
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-gradient"></div>
      <div class="hero-pattern"></div>
      <div class="hero-orb hero-orb-1"></div>
      <div class="hero-orb hero-orb-2"></div>
    </div>
    <div class="container">
      <div class="hero-content">
        <nav class="breadcrumb">
          <a href="/services">Services</a>
          <span class="separator">/</span>
          <a href="/services/ai-services">AI Services</a>
          <span class="separator">/</span>
          <span class="current">AI Strategy</span>
        </nav>

        <div class="hero-badge">
          <div class="badge-glow"></div>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5m.75-9l3-3 2.148 2.148A12.061 12.061 0 0116.5 7.605" />
          </svg>
          <span>Strategic Assessment</span>
        </div>

        <h1 class="hero-title">
          AI Readiness<br />
          <span class="hero-accent">& Strategy</span>
        </h1>

        <p class="hero-description">
          A practical AI plan tied to business workflows, not hype. We help you identify high-impact use cases, assess risks, and build a roadmap that delivers real results.
        </p>

        <div class="hero-outcome">
          <div class="outcome-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
            </svg>
          </div>
          <div class="outcome-text">
            <span class="outcome-label">Outcome</span>
            <span class="outcome-value">Clear AI roadmap with prioritized use cases and implementation plan.</span>
          </div>
        </div>

        <div class="hero-actions">
          <a href="/contact?service=ai-strategy" class="btn-primary">
            <span>Start Strategy Engagement</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
          <a href="#pricing" class="btn-secondary">View Pricing</a>
        </div>

        <div class="hero-meta">
          <div class="meta-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>2-4 weeks</span>
          </div>
          <div class="meta-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>Executive-ready deliverables</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Use Cases Section -->
  <section class="usecases-section">
    <div class="container">
      <div class="section-header centered">
        <span class="section-tag">AI Opportunities</span>
        <h2 class="section-title">Where AI creates real value</h2>
        <p class="section-description">We help you identify and prioritize AI use cases that matter for your business.</p>
      </div>

      <div class="usecases-grid">
        {useCases.map((usecase, i) => (
          <div class="usecase-card" style={`animation-delay: ${i * 0.1}s`}>
            <div class="usecase-icon">
              {usecase.icon === 'document' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>}
              {usecase.icon === 'search' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>}
              {usecase.icon === 'users' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>}
              {usecase.icon === 'chart' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5m.75-9l3-3 2.148 2.148A12.061 12.061 0 0116.5 7.605" /></svg>}
            </div>
            <h3 class="usecase-title">{usecase.title}</h3>
            <p class="usecase-description">{usecase.description}</p>
            <div class="usecase-examples">
              {usecase.examples.map((example) => (
                <span class="example-tag">{example}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables -->
  <section class="deliverables-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">What You Get</span>
        <h2 class="section-title">Executive-ready AI strategy</h2>
        <p class="section-description">Everything you need to make informed AI decisions and secure stakeholder buy-in.</p>
      </div>

      <div class="deliverables-grid">
        {deliverables.map((item, i) => (
          <div class="deliverable-card" style={`animation-delay: ${i * 0.1}s`}>
            <div class="deliverable-icon">
              {item.icon === 'map' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z" /></svg>}
              {item.icon === 'list' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" /></svg>}
              {item.icon === 'beaker' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" /></svg>}
              {item.icon === 'shield' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>}
              {item.icon === 'chart' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5m.75-9l3-3 2.148 2.148A12.061 12.061 0 0116.5 7.605" /></svg>}
              {item.icon === 'presentation' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6" /></svg>}
            </div>
            <h3 class="deliverable-title">{item.title}</h3>
            <p class="deliverable-description">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="process-section">
    <div class="container">
      <div class="section-header centered">
        <span class="section-tag">Our Process</span>
        <h2 class="section-title">From discovery to roadmap</h2>
        <p class="section-description">A structured approach that delivers actionable insights.</p>
      </div>

      <div class="process-timeline">
        {process.map((step, i) => (
          <div class="process-step" style={`animation-delay: ${i * 0.1}s`}>
            <div class="step-number">{step.step}</div>
            <div class="step-content">
              <div class="step-duration">{step.duration}</div>
              <h3 class="step-title">{step.title}</h3>
              <p class="step-description">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="pricing-section" id="pricing">
    <div class="container">
      <div class="section-header centered">
        <span class="section-tag">Investment</span>
        <h2 class="section-title">Transparent, fixed pricing</h2>
        <p class="section-description">Know exactly what you're getting and what it costs.</p>
      </div>

      <div class="pricing-card">
        <div class="pricing-glow"></div>
        <div class="pricing-header">
          <h3 class="pricing-name">{pricing.name}</h3>
          <div class="pricing-price">
            <span class="price-value">{pricing.price}</span>
          </div>
          <p class="pricing-description">{pricing.description}</p>
          <div class="pricing-timeline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>{pricing.timeline}</span>
          </div>
        </div>

        <div class="pricing-features">
          <h4 class="features-title">What's included:</h4>
          <ul class="features-list">
            {pricing.features.map((feature) => (
              <li class="feature-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="pricing-addons">
          <h4 class="addons-title">Optional add-ons:</h4>
          <ul class="addons-list">
            {addOns.map((addon) => (
              <li class="addon-item">
                <span class="addon-name">{addon.name}</span>
                <span class="addon-price">{addon.price}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="pricing-cta">
          <a href="/contact?service=ai-strategy" class="btn-pricing">
            <span>Start Strategy Engagement</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
          <p class="pricing-note">Free discovery call included. No commitment required.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="testimonials-section">
    <div class="container">
      <div class="section-header centered">
        <span class="section-tag">Results</span>
        <h2 class="section-title">AI strategies that deliver</h2>
        <p class="section-description">See how our clients turned AI strategy into measurable impact.</p>
      </div>

      <div class="testimonials-grid">
        {testimonials.map((testimonial, i) => (
          <div class="testimonial-card" style={`animation-delay: ${i * 0.15}s`}>
            <div class="testimonial-metric">{testimonial.metric}</div>
            <blockquote class="testimonial-quote">"{testimonial.quote}"</blockquote>
            <div class="testimonial-author">
              <div class="author-info">
                <div class="author-name">{testimonial.author}</div>
                <div class="author-company">{testimonial.company}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section">
    <div class="container">
      <div class="section-header centered">
        <span class="section-tag">FAQ</span>
        <h2 class="section-title">Common questions</h2>
        <p class="section-description">Everything you need to know about AI strategy.</p>
      </div>

      <div class="faq-grid">
        {faqs.map((faq, i) => (
          <div class="faq-item" style={`animation-delay: ${i * 0.1}s`}>
            <h3 class="faq-question">{faq.question}</h3>
            <p class="faq-answer">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-card">
        <div class="cta-glow"></div>
        <div class="cta-content">
          <h2 class="cta-title">Ready to develop your AI strategy?</h2>
          <p class="cta-description">Get a free discovery call to discuss your AI goals and how we can help you achieve them.</p>
          <div class="cta-actions">
            <a href="/contact?service=ai-strategy" class="btn-cta-primary">
              <span>Book Discovery Call</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
            </a>
