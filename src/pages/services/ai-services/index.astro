---
import BuyerServicePage from '../../../components/BuyerServicePage.astro';

const outcomes = [
  {
    title: 'Clear introduction',
    description: 'Staff understand what ChatGPT, Claude, Copilot, and Cloudflare AI can do, where they fit, and where they should not be used.',
    icon: 'ai',
  },
  {
    title: 'Safer adoption',
    description: 'Approved tools, data rules, prompts, human review, and governance are agreed before AI spreads informally.',
    icon: 'shield',
  },
  {
    title: 'Useful workflows',
    description: 'AI is applied to practical business tasks such as drafting, summarising, reporting, support, onboarding, and internal knowledge.',
    icon: 'settings',
  },
];

const includes = [
  'Business AI introduction workshop',
  'ChatGPT, Claude, Copilot, and Cloudflare AI overview',
  'Approved tool and data handling guidance',
  'AI usage policy in plain English',
  'Workflow and automation opportunity mapping',
  'Copilot readiness and Microsoft 365 data discussion',
  'Pilot use case shortlist',
  'Staff guidance and handover notes',
];

const process = [
  { title: 'Introduce', description: 'We explain AI tools in business terms, using examples relevant to your team and workflows.' },
  { title: 'Control', description: 'Centrix helps define safe use, approved tools, data boundaries, and human review expectations.' },
  { title: 'Pilot', description: 'We identify practical workflow pilots and build a small plan for testing them safely.' },
  { title: 'Improve', description: 'Successful pilots can become documented workflows with ownership, training, and support.' },
];

const faqs = [
  {
    question: 'Is this only Microsoft Copilot?',
    answer: 'No. Copilot is important for Microsoft 365 environments, but we can also cover ChatGPT, Claude, Cloudflare AI, and practical automation tools.',
  },
  {
    question: 'Can you help us write AI rules for staff?',
    answer: 'Yes. We help produce plain-English usage guidance covering approved tools, sensitive data, review, and acceptable use.',
  },
  {
    question: 'Do we need a large AI project?',
    answer: 'No. Most businesses should start with a short introduction, a small number of use cases, and a controlled pilot.',
  },
];
---

<BuyerServicePage
  mediaSrc="/products/ai-for-business.png"
  metaTitle="AI Services For Irish Businesses"
  metaDescription="Simple business AI introduction, ChatGPT, Claude, Copilot, Cloudflare AI, governance, and workflow automation services for Irish businesses."
  eyebrow="AI Services"
  heading="Introduce AI to your business in a simple, controlled way."
  lead="Centrix helps Irish businesses understand AI tools, create sensible rules, find practical use cases, and run safe workflow pilots without creating data risk."
  primaryCta={{ label: 'Book an AI introduction', href: '/contact?service=ai-introduction' }}
  secondaryCta={{ label: 'View Copilot readiness', href: '/services/ai-services/copilot-readiness' }}
  proof={['ChatGPT, Claude, Copilot, and Cloudflare AI overview', 'AI policy and data handling guidance', 'Workflow pilot shortlist', 'Staff handover notes']}
  outcomes={outcomes}
  includes={includes}
  process={process}
  faqs={faqs}
  related={[
    { label: 'Business AI automation', href: '/services/ai-services/business-ai-automation' },
    { label: 'AI strategy', href: '/services/ai-services/ai-strategy' },
  ]}
/>
