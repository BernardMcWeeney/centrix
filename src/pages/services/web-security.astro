---
import BuyerServicePage from '../../components/BuyerServicePage.astro';

const outcomes = [
  {
    title: 'Find the vulnerabilities',
    description: 'OWASP-based testing of your web applications to surface real, exploitable security issues.',
    icon: 'shield',
  },
  {
    title: 'Stay covered over time',
    description: 'Ongoing vulnerability monitoring so new issues and exposed services are caught early.',
    icon: 'monitor',
  },
  {
    title: 'Secure your pipeline',
    description: 'CI/CD and dependency reviews so security is built into how you ship, not bolted on after.',
    icon: 'settings',
  },
];

const includes = [
  'OWASP-based web application security testing',
  'Authenticated and unauthenticated test coverage',
  'Dependency and supply-chain checks',
  'CI/CD pipeline security review',
  'Continuous vulnerability monitoring (optional)',
  'Prioritised findings report with proof and impact',
  'Remediation guidance and retest',
  'Handover and developer debrief',
];

const process = [
  { title: 'Scope', description: 'We agree the applications, environments, and accounts in scope and rules of engagement.' },
  { title: 'Test', description: 'We test against the OWASP methodology, manually verifying findings to cut false positives.' },
  { title: 'Report', description: 'You get a prioritised report with evidence, impact, and clear remediation steps.' },
  { title: 'Retest', description: 'Once you have fixed the issues, we retest to confirm they are properly closed.' },
];

const faqs = [
  {
    question: 'How is this different from an automated scan?',
    answer: 'Automated scans are noisy and miss logic flaws. We combine tooling with manual testing and verify each finding, so you get real issues, not false positives.',
  },
  {
    question: 'Will testing affect our live site?',
    answer: 'We agree rules of engagement up front and can test against staging or carefully against production to avoid disruption.',
  },
  {
    question: 'Do you retest after we fix issues?',
    answer: 'Yes. A retest of the reported findings is included so you can confirm and evidence that they are resolved.',
  },
];
---

<BuyerServicePage
  hideMedia
  metaTitle="Web Security Services | Centrix"
  metaDescription="Web application security testing, vulnerability monitoring, and CI/CD security reviews using the OWASP methodology."
  eyebrow="Web Security"
  heading="Find and fix web application risks"
  lead="Web application security testing, vulnerability monitoring, and CI/CD security reviews using the OWASP methodology — real findings, verified and prioritised."
  primaryCta={{ label: 'Book a web security test', href: '/contact?service=web-security' }}
  secondaryCta={{ label: 'Managed security', href: '/services/managed-security' }}
  proof={['OWASP methodology', 'Manually verified findings', 'CI/CD and dependency review', 'Retest included']}
  outcomes={outcomes}
  includes={includes}
  process={process}
  faqs={faqs}
  mediaLabel="Web security imagery"
  mediaHint="e.g. a vulnerability report, secure code/pipeline visual, or application security testing screen"
  mediaIcon="shield"
  related={[
    { label: 'Managed security', href: '/services/managed-security' },
    { label: 'Configuration reviews', href: '/services/configuration-reviews' },
    { label: 'Security overview', href: '/security' },
  ]}
/>
