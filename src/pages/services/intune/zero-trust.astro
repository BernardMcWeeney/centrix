---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = "Zero Trust Starter Package | Device Compliance + Conditional Access | Centrix";
const description = "Device compliance integrated with Conditional Access for zero-trust enforcement. Trust nothing, verify everything—implemented practically for your organization.";

const deliverables = [
  {
    title: "Compliance Policies",
    description: "Device compliance rules for Windows, iOS, and Android that define what 'healthy' means.",
    icon: "check",
  },
  {
    title: "Conditional Access Integration",
    description: "CA policies that require device compliance before granting access to corporate resources.",
    icon: "lock",
  },
  {
    title: "Device Health Attestation",
    description: "Windows health attestation to verify boot integrity and security features.",
    icon: "shield",
  },
  {
    title: "Rollout Plan",
    description: "Phased deployment strategy that doesn't lock users out or break productivity.",
    icon: "map",
  },
  {
    title: "User Communication",
    description: "End-user guidance and self-remediation instructions for compliance issues.",
    icon: "message",
  },
  {
    title: "Admin Runbook",
    description: "Troubleshooting guide and escalation procedures for your IT team.",
    icon: "document",
  },
];

const pillars = [
  {
    title: "Verify Explicitly",
    description: "Always authenticate and authorize based on all available data points—identity, device, location, and more.",
    icon: "verify",
  },
  {
    title: "Least Privilege",
    description: "Limit user access with just-in-time and just-enough-access (JIT/JEA) to minimize blast radius.",
    icon: "minimize",
  },
  {
    title: "Assume Breach",
    description: "Minimize blast radius and segment access. Verify end-to-end encryption and use analytics to detect threats.",
    icon: "alert",
  },
];

const process = [
  {
    step: "01",
    title: "Requirements & Design",
    description: "Define what 'compliant' means for your organization and design policies that balance security with usability.",
    duration: "Days 1-3",
  },
  {
    step: "02",
    title: "Compliance Policy Build",
    description: "Create compliance policies for each device platform with appropriate grace periods and actions.",
    duration: "Days 4-7",
  },
  {
    step: "03",
    title: "Conditional Access Setup",
    description: "Configure CA policies that enforce compliance requirements for access to M365 and other apps.",
    duration: "Days 8-10",
  },
  {
    step: "04",
    title: "Pilot Deployment",
    description: "Test with a pilot group, gather feedback, and refine policies before wider rollout.",
    duration: "Days 11-14",
  },
  {
    step: "05",
    title: "Production Rollout",
    description: "Phased deployment to production with monitoring, support, and final documentation.",
    duration: "Days 15-21",
  },
];

const pricing = {
  name: "Zero Trust Starter Package",
  price: "From $5,500",
  description: "Device compliance + Conditional Access for zero-trust access control",
  features: [
    "Compliance policies (Windows, iOS, Android)",
    "Conditional Access policy set",
    "Device health attestation (Windows)",
    "Grace period configuration",
    "Non-compliance actions",
    "Pilot group deployment",
    "User communication templates",
    "Admin troubleshooting runbook",
    "14-day post-deployment support",
  ],
  timeline: "2-3 weeks",
};

const addOns = [
  { name: "App protection policies (MAM)", price: "+$1,500" },
  { name: "Risk-based Conditional Access", price: "+$2,000" },
  { name: "Named locations & trusted networks", price: "+$500" },
  { name: "Extended rollout support", price: "+$1,000" },
];

const faqs = [
  {
    question: "What's the difference between device compliance and Conditional Access?",
    answer: "Compliance policies define what makes a device 'healthy' (encrypted, updated, etc.). Conditional Access enforces those requirements—blocking access if the device isn't compliant. Together, they create zero-trust access control.",
  },
  {
    question: "Will this lock out our users?",
    answer: "We use grace periods, staged rollouts, and report-only mode to ensure users have time to remediate issues. The goal is security without productivity disruption.",
  },
  {
    question: "What happens when a device is non-compliant?",
    answer: "Users see a clear message explaining what's wrong and how to fix it. We configure self-remediation paths so users can resolve common issues themselves. IT only gets involved for complex cases.",
  },
  {
    question: "Do we need Intune already deployed?",
    answer: "Basic Intune enrollment is required for compliance policies to work. If you don't have Intune, we recommend our Intune Baseline Implementation first, or we can bundle both projects.",
  },
  {
    question: "What about BYOD devices?",
    answer: "For personal devices, we typically use App Protection Policies (MAM) instead of full device compliance. This protects corporate data without requiring personal device enrollment.",
  },
  {
    question: "How does this work with existing Conditional Access?",
    answer: "We audit your existing CA policies first and integrate compliance requirements into your current setup. No need to start from scratch.",
  },
];

const testimonials = [
  {
    quote: "The phased rollout was key. We went from 'no compliance' to 'full enforcement' without a single help desk ticket from locked-out users.",
    author: "IT Security Manager",
    company: "Financial Services",
    metric: "Zero lockout incidents",
  },
  {
    quote: "Finally, our security team can prove that every device accessing corporate data meets our standards. Audit passed with flying colors.",
    author: "CISO",
    company: "Healthcare Organization",
    metric: "100% audit compliance",
  },
  {
    quote: "Users actually appreciate knowing their device is secure. The self-remediation messages mean they fix issues before IT even knows.",
    author: "Helpdesk Manager",
    company: "Technology Company",
    metric: "80% self-remediation",
  },
];
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-gradient"></div>
      <div class="hero-pattern"></div>
      <div class="hero-orb hero-orb-1"></div>
      <div class="hero-orb hero-orb-2"></div>
    </div>
    <div class="container">
      <div class="hero-content">
        <nav class="breadcrumb">
          <a href="/services">Services</a>
          <span class="separator">/</span>
          <a href="/services/intune">Intune</a>
          <span class="separator">/</span>
          <span class="current">Zero Trust Starter</span>
        </nav>

        <div class="hero-badge">
          <div class="badge-glow"></div>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
          </svg>
          <span>Zero Trust Security</span>
        </div>

        <h1 class="hero-title">
          Zero Trust<br />
          <span class="hero-accent">Starter Package</span>
        </h1>

        <p class="hero-description">
          Device compliance integrated with Conditional Access for zero-trust enforcement. Trust nothing, verify everything—implemented practically for your organization.
        </p>

        <div class="hero-outcome">
          <div class="outcome-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
            </svg>
          </div>
          <div class="outcome-text">
            <span class="outcome-label">Outcome</span>
            <span class="outcome-value">Trust nothing, verify everything—implemented practically.</span>
          </div>
        </div>

        <div class="hero-actions">
          <a href="/contact?service=zero-trust" class="btn-primary">
            <span>Start Zero Trust Journey</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
          <a href="#pricing" class="btn-secondary">View Pricing</a>
        </div>

        <div class="hero-meta">
          <div class="meta-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>2-3 weeks</span>
          </div>
          <div class="meta-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>Fixed scope & price</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Zero Trust Pillars -->
  <section class="pillars-section">
    <div class="container">
      <div class="section-header centered">
        <span class="section-tag">Zero Trust Principles</span>
        <h2 class="section-title">Never trust, always verify</h2>
        <p class="section-description">Zero trust is a security framework that requires all users to be authenticated and continuously validated.</p>
      </div>

      <div class="pillars-grid">
        {pillars.map((pillar, i) => (
          <div class="pillar-card" style={`animation-delay: ${i * 0.15}s`}>
            <div class="pillar-icon">
              {pillar.icon === 'verify' && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" /></svg>}
              {pillar.icon === 'minimize' && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 9V4.5M9 9H4.5M9 9L3.75 3.75M9 15v4.5M9 15H4.5M9 15l-5.25 5.25M15 9h4.5M15 9V4.5M15 9l5.25-5.25M15 15h4.5M15 15v4.5m0-4.5l5.25 5.25" /></svg>}
              {pillar.icon === 'alert' && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg>}
            </div>
            <h3 class="pillar-title">{pillar.title}</h3>
            <p class="pillar-description">{pillar.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables -->
  <section class="deliverables-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">What You Get</span>
        <h2 class="section-title">Complete zero trust foundation</h2>
        <p class="section-description">Everything you need to implement device-based conditional access.</p>
      </div>

      <div class="deliverables-grid">
        {deliverables.map((item, i) => (
          <div class="deliverable-card" style={`animation-delay: ${i * 0.1}s`}>
            <div class="deliverable-icon">
              {item.icon === 'check' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>}
              {item.icon === 'lock' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg>}
              {item.icon === 'shield' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>}
              {item.icon === 'map' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z" /></svg>}
              {item.icon === 'message' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" /></svg>}
              {item.icon === 'document' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>}
            </div>
            <h3 class="deliverable-title">{item.title}</h3>
            <p class="deliverable-description">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="process-section">
    <div class="container">
      <div class="section-header centered">
        <span class="section-tag">Our Process</span>
        <h2 class="section-title">Safe path to zero trust</h2>
        <p class="section-description">A proven approach that delivers security without disruption.</p>
      </div>

      <div class="process-timeline">
        {process.map((step, i) => (
          <div class="process-step" style={`animation-delay: ${i * 0.1}s`}>
            <div class="step-number">{step.step}</div>
            <div class="step-content">
              <div class="step-duration">{step.duration}</div>
              <h3 class="step-title">{step.title}</h3>
              <p class="step-description">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="pricing-section" id="pricing">
    <div class="container">
      <div class="section-header centered">
        <span class="section-tag">Investment</span>
        <h2 class="section-title">Transparent, fixed pricing</h2>
        <p class="section-description">No surprises. Know exactly what you're getting and what it costs.</p>
      </div>

      <div class="pricing-card">
        <div class="pricing-glow"></div>
        <div class="pricing-header">
          <h3 class="pricing-name">{pricing.name}</h3>
          <div class="pricing-price">
            <span class="price-value">{pricing.price}</span>
          </div>
          <p class="pricing-description">{pricing.description}</p>
          <div class="pricing-timeline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>{pricing.timeline}</span>
          </div>
        </div>

        <div class="pricing-features">
          <h4 class="features-title">What's included:</h4>
          <ul class="features-list">
            {pricing.features.map((feature) => (
              <li class="feature-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="pricing-addons">
          <h4 class="addons-title">Optional add-ons:</h4>
          <ul class="addons-list">
            {addOns.map((addon) => (
              <li class="addon-item">
                <span class="addon-name">{addon.name}</span>
                <span class="addon-price">{addon.price}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="pricing-cta">
          <a href="/contact?service=zero-trust" class="btn-pricing">
            <span>Get Started</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
          <p class="pricing-note">Free consultation included. No commitment required.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="testimonials-section">
    <div class="container">
      <div class="section-header centered">
        <span class="section-tag">Results</span>
        <h2 class="section-title">Zero trust success stories</h2>
        <p class="section-description">See how organizations implemented zero trust without disruption.</p>
      </div>

      <div class="testimonials-grid">
        {testimonials.map((testimonial, i) => (
          <div class="testimonial-card" style={`animation-delay: ${i * 0.15}s`}>
            <div class="testimonial-metric">{testimonial.metric}</div>
            <blockquote class="testimonial-quote">"{testimonial.quote}"</blockquote>
            <div class="testimonial-author">
              <div class="author-info">
                <div class="author-name">{testimonial.author}</div>
                <div class="author-company">{testimonial.company}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section">
    <div class="container">
      <div class="section-header centered">
        <span class="section-tag">FAQ</span>
        <h2 class="section-title">Common questions</h2>
        <p class="section-description">Everything you need to know about zero trust implementation.</p>
      </div>

      <div class="faq-grid">
        {faqs.map((faq, i) => (
          <div class="faq-item" style={`animation-delay: ${i * 0.1}s`}>
            <h3 class="faq-question">{faq.question}</h3>
            <p class="faq-answer">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-card">
        <div class="cta-glow"></div>
        <div class="cta-content">
          <h2 class="cta-title">Ready for zero trust?</h2>
          <p class="cta-description">Get a free consultation and see how we can implement zero trust for your organization.</p>
          <div class="cta-actions">
            <a href="/contact?service=zero-trust" class="btn-cta-primary">
              <span>Book Free Consultation</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
            </a>
            <a href="/services/intune" class="btn-cta-secondary">View All Intune Services</a>
          </div>
        </div>
        <div class="cta-pattern"></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :root {
    --accent: #8b5cf6;
    --accent-secondary: #06b6d4;
    --accent-light: rgba(139, 92, 246, 0.1);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Hero */
  .hero {
    position: relative;
    padding: 8rem 0 6rem;
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .hero {
      padding: 10rem 0 8rem;
    }
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-primary) 50%, rgba(139, 92, 246, 0.03) 100%);
  }

  .hero-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--border-primary) 1px, transparent 1px);
    background-size: 32px 32px;
    opacity: 0.5;
    mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
  }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
  }

  .hero-orb-1 {
    top: 10%;
    right: 20%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.2) 0%, transparent 70%);
    animation: float 20s ease-in-out infinite;
  }

  .hero-orb-2 {
    bottom: 20%;
    left: 10%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(6, 182, 212, 0.15) 0%, transparent 70%);
    animation: float 15s ease-in-out infinite reverse;
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(30px, -30px); }
  }

  .hero-content {
    position: relative;
