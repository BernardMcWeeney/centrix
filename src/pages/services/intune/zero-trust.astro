---
import BuyerServicePage from '../../../components/BuyerServicePage.astro';

const outcomes = [
  {
    title: 'Clear device compliance',
    description: 'Compliance policies for Windows, iOS, and Android that define exactly what a “healthy” device means.',
    icon: 'check',
  },
  {
    title: 'Enforced access',
    description: 'Conditional Access policies that require a compliant device before granting access to corporate resources.',
    icon: 'lock',
  },
  {
    title: 'Verified device health',
    description: 'Windows health attestation to verify boot integrity and security features before access is allowed.',
    icon: 'shield',
  },
];

const includes = [
  'Device compliance policies for Windows, iOS, and Android',
  'Conditional Access policies that enforce device compliance',
  'Windows device health attestation',
  'Grace periods and non-compliance actions configured',
  'Pilot group deployment and report-only validation',
  'End-user communication and self-remediation guidance',
  'Admin troubleshooting runbook and post-deployment support',
];

const process = [
  { title: 'Requirements & design', description: 'Define what “compliant” means for your organisation and design policies that balance security with usability.' },
  { title: 'Build compliance policies', description: 'Create compliance policies for each device platform with appropriate grace periods and actions.' },
  { title: 'Configure Conditional Access', description: 'Set up Conditional Access policies that enforce compliance for access to Microsoft 365 and other apps.' },
  { title: 'Pilot & roll out', description: 'Test with a pilot group in report-only mode, refine, then phase into production with monitoring and docs.' },
];

const faqs = [
  {
    question: 'What is the difference between device compliance and Conditional Access?',
    answer: 'Compliance policies define what makes a device healthy (encrypted, updated, and so on). Conditional Access enforces those requirements, blocking access if a device is not compliant. Together they create zero-trust access control.',
  },
  {
    question: 'Will this lock out our users?',
    answer: 'No. We use grace periods, staged rollouts, and report-only mode so users have time to remediate. The goal is security without productivity disruption.',
  },
  {
    question: 'What happens when a device is non-compliant?',
    answer: 'Users see a clear message explaining what is wrong and how to fix it, with self-remediation paths for common issues. IT only gets involved for complex cases.',
  },
  {
    question: 'Do we need Intune deployed already?',
    answer: 'Basic Intune enrollment is required for compliance policies to work. If you do not have Intune yet, we recommend our Intune baseline implementation first, or we can bundle both.',
  },
];
---

<BuyerServicePage
  metaTitle="Zero Trust Starter Package | Device Compliance + Conditional Access | Centrix"
  metaDescription="Device compliance integrated with Conditional Access for zero-trust enforcement. Trust nothing, verify everything — implemented practically for your organisation."
  eyebrow="Zero Trust Starter"
  heading="Trust nothing, verify everything — practically"
  lead="Device compliance integrated with Conditional Access for zero-trust enforcement. We implement it practically, so access is secure without locking out your team."
  primaryCta={{ label: 'Book a zero-trust consultation', href: '/contact?service=zero-trust' }}
  secondaryCta={{ label: 'All Intune services', href: '/services/intune' }}
  proof={['Device compliance policies', 'Conditional Access enforcement', 'Phased, no-lockout rollout', 'Runbook and support']}
  outcomes={outcomes}
  includes={includes}
  process={process}
  faqs={faqs}
  mediaLabel="Zero trust & device compliance imagery"
  mediaHint="e.g. a Conditional Access policy screen, device compliance dashboard, or secure sign-in visual"
  mediaIcon="shield"
  related={[
    { label: 'Intune & endpoint management', href: '/services/intune' },
    { label: 'Intune baseline setup', href: '/services/intune/intune-setup' },
    { label: 'Microsoft 365 security', href: '/services/microsoft-365' },
  ]}
/>
