---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = "Intune Baseline Implementation | Modern Endpoint Management | Centrix";
const description = "Complete Microsoft Intune deployment with security baselines, compliance policies, and app management. Get modern endpoint management done right from day one.";

const deliverables = [
  {
    title: "Configured Intune Tenant",
    description: "Production-ready Intune environment with all core components configured and tested.",
    icon: "cloud",
  },
  {
    title: "Security Baselines",
    description: "Microsoft-recommended security settings applied across Windows, iOS, and Android devices.",
    icon: "shield",
  },
  {
    title: "Compliance Policies",
    description: "Device compliance rules that integrate with Conditional Access for zero-trust enforcement.",
    icon: "check",
  },
  {
    title: "App Deployment",
    description: "Core business applications configured for automatic deployment to enrolled devices.",
    icon: "apps",
  },
  {
    title: "Rollout Documentation",
    description: "Complete admin guide, user enrollment instructions, and troubleshooting runbook.",
    icon: "document",
  },
  {
    title: "Training Session",
    description: "Hands-on training for your IT team to manage Intune independently.",
    icon: "users",
  },
];

const process = [
  {
    step: "01",
    title: "Discovery & Design",
    description: "We assess your current environment, device inventory, and requirements to design your Intune architecture.",
    duration: "Days 1-3",
  },
  {
    step: "02",
    title: "Tenant Configuration",
    description: "Configure Intune tenant settings, enrollment restrictions, and core infrastructure components.",
    duration: "Days 4-6",
  },
  {
    step: "03",
    title: "Policy Development",
    description: "Build security baselines, compliance policies, and configuration profiles for your device types.",
    duration: "Days 7-10",
  },
  {
    step: "04",
    title: "App Packaging",
    description: "Package and configure business applications for deployment via Intune.",
    duration: "Days 11-13",
  },
  {
    step: "05",
    title: "Pilot & Rollout",
    description: "Test with pilot group, refine policies, and execute phased production rollout.",
    duration: "Days 14-20",
  },
];

const features = [
  {
    title: "Windows Autopilot",
    description: "Zero-touch device provisioning that configures new devices automatically.",
    icon: "autopilot",
  },
  {
    title: "BitLocker Management",
    description: "Centralized encryption management with key recovery in Entra ID.",
    icon: "lock",
  },
  {
    title: "Windows Hello for Business",
    description: "Passwordless authentication using biometrics or PIN.",
    icon: "fingerprint",
  },
  {
    title: "Attack Surface Reduction",
    description: "ASR rules to block common attack vectors on Windows devices.",
    icon: "shield",
  },
  {
    title: "App Protection Policies",
    description: "MAM policies to protect corporate data on personal devices.",
    icon: "app",
  },
  {
    title: "Update Management",
    description: "Windows Update for Business rings for controlled patching.",
    icon: "refresh",
  },
];

const pricing = {
  name: "Intune Baseline Implementation",
  price: "From $6,500",
  description: "Complete Intune deployment with security baselines and compliance policies",
  features: [
    "Intune tenant configuration",
    "Security baselines for Windows/iOS/Android",
    "Compliance policies (up to 5)",
    "App deployment (up to 10 apps)",
    "Windows Autopilot setup",
    "BitLocker configuration",
    "Rollout documentation",
    "IT team training session",
    "30-day post-deployment support",
  ],
  timeline: "2-4 weeks",
};

const addOns = [
  { name: "Additional compliance policies", price: "+$500 each" },
  { name: "Additional app packaging", price: "+$200 each" },
  { name: "Mac device support", price: "+$2,000" },
  { name: "Conditional Access integration", price: "+$1,500" },
  { name: "Managed operations (monthly)", price: "+$1,500/mo" },
];

const faqs = [
  {
    question: "Do we need any licenses before starting?",
    answer: "You'll need Microsoft Intune licenses (included in Microsoft 365 Business Premium, E3, E5, or standalone). We can help you assess your current licensing and recommend the right options during our discovery phase.",
  },
  {
    question: "Will this affect our users' productivity?",
    answer: "We use a phased rollout approach starting with a pilot group. Policies are tested thoroughly before wider deployment, and we time rollouts to minimize disruption. Most users experience minimal impact.",
  },
  {
    question: "What if we have devices that aren't enrolled yet?",
    answer: "We'll set up enrollment methods for both new and existing devices. For existing devices, we typically use bulk enrollment or user-driven enrollment depending on your environment.",
  },
  {
    question: "Can Intune manage BYOD devices?",
    answer: "Yes, we can configure App Protection Policies (MAM) that secure corporate data without requiring full device enrollment—perfect for personal devices.",
  },
  {
    question: "How does this integrate with our existing AD?",
    answer: "Intune works with Entra ID (Azure AD). If you have on-premises AD, we'll ensure proper sync via Entra Connect. Hybrid join scenarios are fully supported.",
  },
  {
    question: "What ongoing management is required?",
    answer: "Day-to-day management is minimal once deployed. We provide documentation and training. For organizations that want hands-off management, we offer managed operations services.",
  },
];

const testimonials = [
  {
    quote: "We went from zero endpoint management to full compliance in three weeks. The security baseline alone caught issues we didn't know existed.",
    author: "IT Manager",
    company: "Professional Services",
    metric: "100% device compliance",
  },
  {
    quote: "Autopilot changed everything. New hires get a laptop, sign in, and everything's configured automatically. No more imaging.",
    author: "IT Director",
    company: "Technology Company",
    metric: "Zero-touch provisioning",
  },
  {
    quote: "The training session was worth its weight in gold. Our team now manages Intune confidently without needing to call for help.",
    author: "Systems Administrator",
    company: "Healthcare Provider",
    metric: "Self-sufficient IT team",
  },
];
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-gradient"></div>
      <div class="hero-pattern"></div>
      <div class="hero-orb hero-orb-1"></div>
      <div class="hero-orb hero-orb-2"></div>
    </div>
    <div class="container">
      <div class="hero-content">
        <nav class="breadcrumb">
          <a href="/services">Services</a>
          <span class="separator">/</span>
          <a href="/services/intune">Intune</a>
          <span class="separator">/</span>
          <span class="current">Baseline Implementation</span>
        </nav>

        <div class="hero-badge">
          <div class="badge-glow"></div>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
          </svg>
          <span>Implementation</span>
        </div>

        <h1 class="hero-title">
          Intune Baseline<br />
          <span class="hero-accent">Implementation</span>
        </h1>

        <p class="hero-description">
          Complete Microsoft Intune deployment with security baselines, compliance policies, and app management. Get modern endpoint management done right from day one.
        </p>

        <div class="hero-outcome">
          <div class="outcome-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
            </svg>
          </div>
          <div class="outcome-text">
            <span class="outcome-label">Outcome</span>
            <span class="outcome-value">Managed endpoints with security-first configuration.</span>
          </div>
        </div>

        <div class="hero-actions">
          <a href="/contact?service=intune-setup" class="btn-primary">
            <span>Start Implementation</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
          <a href="#pricing" class="btn-secondary">View Pricing</a>
        </div>

        <div class="hero-meta">
          <div class="meta-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>2-4 weeks</span>
          </div>
          <div class="meta-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>Fixed scope & price</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="features-section">
    <div class="container">
      <div class="section-header centered">
        <span class="section-tag">What's Included</span>
        <h2 class="section-title">Enterprise-grade endpoint management</h2>
        <p class="section-description">Everything you need for modern device management, configured properly from the start.</p>
      </div>

      <div class="features-grid">
        {features.map((feature, i) => (
          <div class="feature-card" style={`animation-delay: ${i * 0.1}s`}>
            <div class="feature-icon">
              {feature.icon === 'autopilot' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>}
              {feature.icon === 'lock' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg>}
              {feature.icon === 'fingerprint' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M7.864 4.243A7.5 7.5 0 0119.5 10.5c0 2.92-.556 5.709-1.568 8.268M5.742 6.364A7.465 7.465 0 004.5 10.5a7.464 7.464 0 01-1.15 3.993m1.989 3.559A11.209 11.209 0 008.25 10.5a3.75 3.75 0 117.5 0c0 .527-.021 1.049-.064 1.565M12 10.5a14.94 14.94 0 01-3.6 9.75m6.633-4.596a18.666 18.666 0 01-2.485 5.33" /></svg>}
              {feature.icon === 'shield' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>}
              {feature.icon === 'app' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" /></svg>}
              {feature.icon === 'refresh' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>}
            </div>
            <h3 class="feature-title">{feature.title}</h3>
            <p class="feature-description">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables -->
  <section class="deliverables-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Deliverables</span>
        <h2 class="section-title">What you get</h2>
        <p class="section-description">Complete endpoint management solution, fully documented and ready to scale.</p>
      </div>

      <div class="deliverables-grid">
        {deliverables.map((item, i) => (
          <div class="deliverable-card" style={`animation-delay: ${i * 0.1}s`}>
            <div class="deliverable-icon">
              {item.icon === 'cloud' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z" /></svg>}
              {item.icon === 'shield' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>}
              {item.icon === 'check' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>}
              {item.icon === 'apps' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>}
              {item.icon === 'document' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>}
              {item.icon === 'users' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>}
            </div>
            <h3 class="deliverable-title">{item.title}</h3>
            <p class="deliverable-description">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="process-section">
    <div class="container">
      <div class="section-header centered">
        <span class="section-tag">Our Process</span>
        <h2 class="section-title">From zero to managed</h2>
        <p class="section-description">A proven implementation process that delivers results.</p>
      </div>

      <div class="process-timeline">
        {process.map((step, i) => (
          <div class="process-step" style={`animation-delay: ${i * 0.1}s`}>
            <div class="step-number">{step.step}</div>
            <div class="step-content">
              <div class="step-duration">{step.duration}</div>
              <h3 class="step-title">{step.title}</h3>
              <p class="step-description">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="pricing-section" id="pricing">
    <div class="container">
      <div class="section-header centered">
        <span class="section-tag">Investment</span>
        <h2 class="section-title">Transparent, fixed pricing</h2>
        <p class="section-description">No surprises. Know exactly what you're getting and what it costs.</p>
      </div>

      <div class="pricing-card">
        <div class="pricing-glow"></div>
        <div class="pricing-header">
          <h3 class="pricing-name">{pricing.name}</h3>
          <div class="pricing-price">
            <span class="price-value">{pricing.price}</span>
          </div>
          <p class="pricing-description">{pricing.description}</p>
          <div class="pricing-timeline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>{pricing.timeline}</span>
          </div>
        </div>

        <div class="pricing-features">
          <h4 class="features-title">What's included:</h4>
          <ul class="features-list">
            {pricing.features.map((feature) => (
              <li class="feature-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="pricing-addons">
          <h4 class="addons-title">Optional add-ons:</h4>
          <ul class="addons-list">
            {addOns.map((addon) => (
              <li class="addon-item">
                <span class="addon-name">{addon.name}</span>
                <span class="addon-price">{addon.price}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="pricing-cta">
          <a href="/contact?service=intune-setup" class="btn-pricing">
            <span>Get Started</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
          <p class="pricing-note">Free consultation included. No commitment required.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="testimonials-section">
    <div class="container">
      <div class="section-header centered">
        <span class="section-tag">Results</span>
        <h2 class="section-title">Trusted by IT teams</h2>
        <p class="section-description">See how organizations transformed their endpoint management.</p>
      </div>

      <div class="testimonials-grid">
        {testimonials.map((testimonial, i) => (
          <div class="testimonial-card" style={`animation-delay: ${i * 0.15}s`}>
            <div class="testimonial-metric">{testimonial.metric}</div>
            <blockquote class="testimonial-quote">"{testimonial.quote}"</blockquote>
            <div class="testimonial-author">
              <div class="author-info">
                <div class="author-name">{testimonial.author}</div>
                <div class="author-company">{testimonial.company}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section">
    <div class="container">
      <div class="section-header centered">
        <span class="section-tag">FAQ</span>
        <h2 class="section-title">Common questions</h2>
        <p class="section-description">Everything you need to know about Intune implementation.</p>
      </div>

      <div class="faq-grid">
        {faqs.map((faq, i) => (
          <div class="faq-item" style={`animation-delay: ${i * 0.1}s`}>
            <h3 class="faq-question">{faq.question}</h3>
            <p class="faq-answer">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-card">
        <div class="cta-glow"></div>
        <div class="cta-content">
          <h2 class="cta-title">Ready to modernize your endpoints?</h2>
          <p class="cta-description">Get a free consultation and see how Intune can transform your device management.</p>
          <div class="cta-actions">
            <a href="/contact?service=intune-setup" class="btn-cta-primary">
              <span>Book Free Consultation</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
            </a>
