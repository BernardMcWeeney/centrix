---
import BuyerServicePage from '../../../components/BuyerServicePage.astro';

const outcomes = [
  {
    title: 'A production-ready Intune tenant',
    description: 'A configured, tested Intune environment with enrollment, core infrastructure, and settings ready for rollout.',
    icon: 'cloud',
  },
  {
    title: 'Security baselines applied',
    description: 'Microsoft-recommended security settings across Windows, iOS, and Android, integrated with Conditional Access.',
    icon: 'shield',
  },
  {
    title: 'Compliance enforced',
    description: 'Device compliance policies that enforce zero-trust access so only healthy devices reach company data.',
    icon: 'check',
  },
];

const includes = [
  'Production-ready Intune tenant configuration',
  'Security baselines for Windows, iOS, and Android',
  'Compliance policies integrated with Conditional Access',
  'Windows Autopilot zero-touch provisioning',
  'BitLocker encryption with key recovery in Entra ID',
  'App deployment and app protection (MAM) policies',
  'Windows Update for Business rings for controlled patching',
  'Admin guide, user enrollment instructions, and troubleshooting runbook',
  'IT team training session and post-deployment support',
];

const process = [
  { title: 'Discover & design', description: 'We assess your current environment, device inventory, and requirements to design your Intune architecture.' },
  { title: 'Configure tenant', description: 'We configure Intune tenant settings, enrollment restrictions, and core infrastructure components.' },
  { title: 'Build policies & apps', description: 'We build security baselines, compliance policies, configuration profiles, and package business apps.' },
  { title: 'Pilot & roll out', description: 'We test with a pilot group, refine policies, and execute a phased production rollout with documentation.' },
];

const faqs = [
  {
    question: 'How long does an Intune implementation take?',
    answer: 'A typical baseline implementation runs over a few weeks, including discovery, configuration, policy development, a pilot, and phased rollout.',
  },
  {
    question: 'Will you train our IT team?',
    answer: 'Yes. We include a hands-on training session and documentation so your team can manage Intune independently, plus post-deployment support.',
  },
  {
    question: 'Can you support both company and personal devices?',
    answer: 'Yes. We configure enrollment for company-owned devices and app protection (MAM) policies for BYOD without managing the whole personal device.',
  },
];
---

<BuyerServicePage
  metaTitle="Intune Baseline Implementation | Modern Endpoint Management | Centrix"
  metaDescription="Complete Microsoft Intune deployment with security baselines, compliance policies, and app management. Get modern endpoint management done right from day one."
  eyebrow="Intune Baseline Implementation"
  heading="Intune, set up properly from day one"
  lead="A complete Microsoft Intune deployment with security baselines, compliance policies, and app management — modern endpoint management done right from the start."
  primaryCta={{ label: 'Book an Intune consultation', href: '/contact?service=intune' }}
  secondaryCta={{ label: 'All Intune services', href: '/services/intune' }}
  proof={['Production-ready Intune tenant', 'Security baselines and compliance', 'Autopilot and BitLocker', 'Documentation, training, and support']}
  outcomes={outcomes}
  includes={includes}
  process={process}
  faqs={faqs}
  mediaLabel="Intune setup imagery"
  mediaHint="e.g. the Intune admin console, Autopilot enrollment, or managed devices in a workplace"
  mediaIcon="device"
  related={[
    { label: 'Intune & endpoint management', href: '/services/intune' },
