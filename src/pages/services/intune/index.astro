---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = "Intune & Endpoint Management | Modern Device Security | Waymark";
const description = "Modern endpoint management with Microsoft Intune. Security baselines, compliance policies, and zero-trust device access for Windows, iOS, and Android.";

const services = [
  {
    id: "intune-setup",
    title: "Intune Baseline Implementation",
    description: "Complete Intune deployment with security baselines, compliance policies, and app management. Get modern endpoint management done right.",
    href: "/services/intune/intune-setup",
    icon: "device",
    features: ["Security Baselines", "Compliance Policies", "App Deployment", "Rollout Support"],
    color: "cyan",
    featured: true,
  },
  {
    id: "zero-trust",
    title: "Zero Trust Starter Package",
    description: "Device compliance integrated with Conditional Access. Trust nothing, verify everything—implemented practically.",
    href: "/services/intune/zero-trust",
    icon: "shield",
    features: ["Device Compliance", "CA Integration", "Health Attestation", "Phased Rollout"],
    color: "purple",
  },
  {
    id: "windows-hardening",
    title: "Windows 10/11 Hardening",
    description: "Security baseline for Windows endpoints. Reduce attack surface with BitLocker, LAPS, ASR rules, and hardened configurations.",
    href: "/contact?service=windows-hardening",
    icon: "windows",
    features: ["Attack Surface Reduction", "BitLocker Config", "LAPS Setup", "Security Baseline"],
    color: "blue",
  },
  {
    id: "mobile-security",
    title: "Device & Mobile Security",
    description: "Compliance and protection across all device types. Consistent security for iOS, Android, and Windows devices.",
    href: "/contact?service=mobile-security",
    icon: "mobile",
    features: ["iOS/Android MAM", "App Protection", "Lost Device Response", "BYOD Support"],
    color: "green",
  },
];

const stats = [
  { value: "1,000+", label: "Devices Managed" },
  { value: "99.5%", label: "Compliance Rate" },
  { value: "Zero", label: "Trust Architecture" },
  { value: "24/7", label: "Policy Enforcement" },
];

const whyUs = [
  {
    title: "Security-First Design",
    description: "Every configuration starts with security baselines, not convenience.",
    icon: "shield",
  },
  {
    title: "Practical Rollout",
    description: "Phased deployment that doesn't break productivity or overwhelm support.",
    icon: "layers",
  },
  {
    title: "Microsoft Expertise",
    description: "Deep knowledge of Intune, Defender, Entra ID, and the entire Microsoft stack.",
    icon: "microsoft",
  },
  {
    title: "Ongoing Support",
    description: "Managed operations options to keep your endpoints healthy and compliant.",
    icon: "support",
  },
];

const transformSteps = [
  {
    before: "Manual device setup",
    after: "Automated enrollment & config",
    icon: "autopilot",
  },
  {
    before: "Unknown device security",
    after: "Enforced compliance policies",
    icon: "compliance",
  },
  {
    before: "VPN for everything",
    after: "Zero-trust conditional access",
    icon: "zerotrust",
  },
  {
    before: "Local admin everywhere",
    after: "LAPS + least privilege",
    icon: "admin",
  },
];
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-gradient"></div>
      <div class="hero-pattern"></div>
      <div class="hero-orb hero-orb-1"></div>
      <div class="hero-orb hero-orb-2"></div>
    </div>
    <div class="container">
      <div class="hero-content">
        <div class="hero-badge">
          <div class="badge-glow"></div>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
          </svg>
          <span>Endpoint Management</span>
        </div>
        <h1 class="hero-title">
          Modern Endpoint<br />
          <span class="hero-accent">Management</span>
        </h1>
        <p class="hero-description">
          Take control of every device with Microsoft Intune. Security baselines, compliance policies, and zero-trust access—all managed from a single console.
        </p>
        <div class="hero-actions">
          <a href="/services/intune/intune-setup" class="btn-primary">
            <span>Get Started with Intune</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
          <a href="/contact?service=intune" class="btn-secondary">Book Consultation</a>
        </div>
      </div>

      <!-- Device Visual -->
      <div class="hero-visual">
        <div class="device-stack">
          <div class="device device-laptop">
            <div class="device-screen">
              <div class="screen-content">
                <div class="status-bar">
                  <div class="status-indicator compliant"></div>
                  <span>Compliant</span>
                </div>
                <div class="device-metrics">
                  <div class="metric"><span class="value">100%</span><span class="label">Encrypted</span></div>
                  <div class="metric"><span class="value">Active</span><span class="label">Defender</span></div>
                </div>
              </div>
            </div>
          </div>
          <div class="device device-tablet">
            <div class="device-screen">
              <div class="screen-content">
                <div class="status-indicator compliant"></div>
              </div>
            </div>
          </div>
          <div class="device device-phone">
            <div class="device-screen">
              <div class="screen-content">
                <div class="status-indicator compliant"></div>
              </div>
            </div>
          </div>
          <div class="shield-overlay">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="url(#shield-grad)" stroke-width="1.5">
              <defs>
                <linearGradient id="shield-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#06b6d4" />
                  <stop offset="100%" stop-color="#8b5cf6" />
                </linearGradient>
              </defs>
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats-section">
    <div class="container">
      <div class="stats-grid">
        {stats.map((stat) => (
          <div class="stat-item">
            <div class="stat-value">{stat.value}</div>
            <div class="stat-label">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Transformation -->
  <section class="transform-section">
    <div class="container">
      <div class="section-header centered">
        <span class="section-tag">The Transformation</span>
        <h2 class="section-title">From legacy to modern management</h2>
        <p class="section-description">See how Intune transforms your endpoint security posture.</p>
      </div>

      <div class="transform-grid">
        {transformSteps.map((step, i) => (
          <div class="transform-card" style={`animation-delay: ${i * 0.1}s`}>
            <div class="transform-icon">
              {step.icon === 'autopilot' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>}
              {step.icon === 'compliance' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>}
              {step.icon === 'zerotrust' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg>}
              {step.icon === 'admin' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" /></svg>}
            </div>
            <div class="transform-content">
              <div class="before-after">
                <div class="before">
                  <span class="label">Before</span>
                  <span class="text">{step.before}</span>
                </div>
                <div class="arrow">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
                </div>
                <div class="after">
                  <span class="label">After</span>
                  <span class="text">{step.after}</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="services-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Our Services</span>
        <h2 class="section-title">Intune & endpoint solutions</h2>
        <p class="section-description">From initial setup to ongoing management—we've got your endpoints covered.</p>
      </div>

      <div class="services-grid">
        {services.map((service, i) => (
          <a href={service.href} class={`service-card service-${service.color} ${service.featured ? 'featured' : ''}`} style={`animation-delay: ${i * 0.1}s`}>
            {service.featured && <div class="featured-badge">Most Popular</div>}
            <div class="service-icon">
              {service.icon === 'device' && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" /></svg>}
              {service.icon === 'shield' && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>}
              {service.icon === 'windows' && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>}
              {service.icon === 'mobile' && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" /></svg>}
            </div>
            <h3 class="service-title">{service.title}</h3>
            <p class="service-description">{service.description}</p>
            <div class="service-features">
              {service.features.map((feature) => (
                <span class="feature-tag">{feature}</span>
              ))}
            </div>
            <span class="service-link">
              Learn more
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Us -->
  <section class="why-section">
    <div class="container">
      <div class="section-header centered">
        <span class="section-tag">Why Waymark</span>
        <h2 class="section-title">Endpoint expertise you can trust</h2>
        <p class="section-description">We bring enterprise endpoint management to organizations of all sizes.</p>
      </div>

      <div class="why-grid">
        {whyUs.map((item, i) => (
          <div class="why-card" style={`animation-delay: ${i * 0.1}s`}>
            <div class="why-icon">
              {item.icon === 'shield' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>}
              {item.icon === 'layers' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0l4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0l-5.571 3-5.571-3" /></svg>}
              {item.icon === 'microsoft' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>}
              {item.icon === 'support' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" /></svg>}
            </div>
            <h3 class="why-title">{item.title}</h3>
            <p class="why-description">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-card">
        <div class="cta-glow"></div>
        <div class="cta-content">
          <h2 class="cta-title">Ready for modern endpoint management?</h2>
          <p class="cta-description">Get a free consultation and see how Intune can transform your device security.</p>
          <div class="cta-actions">
            <a href="/contact?service=intune" class="btn-cta-primary">
              <span>Book Free Consultation</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
            </a>
            <a href="/services" class="btn-cta-secondary">View All Services</a>
          </div>
        </div>
        <div class="cta-pattern"></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :root {
    --accent: #06b6d4;
    --accent-secondary: #8b5cf6;
    --accent-light: rgba(6, 182, 212, 0.1);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Hero */
  .hero {
    position: relative;
    padding: 8rem 0 6rem;
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .hero {
      padding: 10rem 0 8rem;
    }

    .hero .container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-primary) 50%, rgba(6, 182, 212, 0.03) 100%);
  }

  .hero-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--border-primary) 1px, transparent 1px);
    background-size: 32px 32px;
    opacity: 0.5;
    mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
  }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
  }

  .hero-orb-1 {
    top: 10%;
    right: 20%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(6, 182, 212, 0.2) 0%, transparent 70%);
    animation: float 20s ease-in-out infinite;
  }

  .hero-orb-2 {
    bottom: 20%;
    left: 10%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.15) 0%, transparent 70%);
    animation: float 15s ease-in-out infinite reverse;
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(30px, -30px); }
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 600px;
  }

  .hero-badge {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--accent-light);
    border: 1px solid rgba(6, 182, 212, 0.2);
    border-radius: 9999px;
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    overflow: hidden;
  }

  .badge-glow {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(6, 182, 212, 0.3), transparent);
    animation: shimmer 3s infinite;
  }

  @keyframes shimmer {
    0% { left: -100%; }
    100% { left: 200%; }
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 4rem;
    }
  }

  .hero-accent {
    background: linear-gradient(135deg, var(--accent), var(--accent-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-description {
    font-size: 1.25rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.75rem;
    background: linear-gradient(135deg, var(--accent), var(--accent-secondary));
    color: white;
    font-weight: 500;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.3s;
    box-shadow: 0 4px 15px rgba(6, 182, 212, 0.3);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(6, 182, 212, 0.4);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 1rem 1.75rem;
    background: var(--bg-primary);
    color: var(--text-primary);
    font-weight: 500;
    border: 1px solid var(--border-primary);
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-secondary:hover {
    border-color: var(--accent);
  }

  /* Hero Visual */
  .hero-visual {
    display: none;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 1024px) {
    .hero-visual {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }

  .device-stack {
    position: relative;
