---
import BuyerServicePage from '../../../components/BuyerServicePage.astro';

const outcomes = [
  {
    title: 'Every device enrolled and compliant',
    description: 'Automated enrollment, compliance policies, and configuration baselines for Windows, iOS, and Android devices.',
    icon: 'device',
  },
  {
    title: 'Zero-trust device access',
    description: 'Device compliance tied into Conditional Access so only healthy, trusted devices can reach company data.',
    icon: 'shield',
  },
  {
    title: 'Hardened endpoints',
    description: 'BitLocker, LAPS, attack surface reduction, and Defender baselines that reduce real-world risk.',
    icon: 'lock',
  },
];

const includes = [
  'Intune tenant setup and enrollment configuration',
  'Security baselines and compliance policies',
  'Conditional Access and device compliance integration',
  'App deployment and app protection (MAM) for iOS and Android',
  'Windows 10/11 hardening: BitLocker, LAPS, and ASR rules',
  'Phased rollout planning that protects productivity',
  'Documentation and handover for your team',
];

const process = [
  { title: 'Assess', description: 'We review your devices, licensing, current management, and security requirements.' },
  { title: 'Design', description: 'We define baselines, compliance policies, and a phased rollout that does not disrupt staff.' },
  { title: 'Deploy', description: 'We configure Intune enrollment, policies, app deployment, and Conditional Access integration.' },
  { title: 'Support', description: 'Managed operations options keep endpoints healthy, compliant, and up to date over time.' },
];

const faqs = [
  {
    question: 'Will this disrupt staff during rollout?',
    answer: 'No. We use phased enrollment and test policies on a pilot group before wider rollout to avoid productivity impact.',
  },
  {
    question: 'Which devices can Intune manage?',
    answer: 'Windows, macOS, iOS, and Android — including company-owned devices and BYOD with app protection policies.',
  },
  {
    question: 'Do we need specific Microsoft licences?',
    answer: 'Intune needs the right Microsoft 365 / Entra licensing. We review your current licences and recommend practical options before assuming upgrades.',
  },
];
---

<BuyerServicePage
  metaTitle="Intune & Endpoint Management | Modern Device Security | Centrix"
  metaDescription="Modern endpoint management with Microsoft Intune. Security baselines, compliance policies, and zero-trust device access for Windows, iOS, and Android."
  eyebrow="Intune & Endpoint Management"
  heading="Modern endpoint management for every device"
  lead="Take control of every device with Microsoft Intune. Security baselines, compliance policies, and zero-trust access — all managed from a single console."
  primaryCta={{ label: 'Book an Intune consultation', href: '/contact?service=intune' }}
  secondaryCta={{ label: 'Intune baseline setup', href: '/services/intune/intune-setup' }}
  proof={['Automated enrollment and compliance', 'Zero-trust Conditional Access', 'Windows hardening baselines', 'Phased, low-disruption rollout']}
  outcomes={outcomes}
  includes={includes}
  process={process}
  faqs={faqs}
  mediaLabel="Endpoint management imagery"
  mediaHint="e.g. managed laptops and phones, an Intune compliance dashboard, or a device enrollment visual"
  mediaIcon="device"
  related={[
    { label: 'Intune baseline setup', href: '/services/intune/intune-setup' },
    { label: 'Zero Trust starter', href: '/services/intune/zero-trust' },
    { label: 'Microsoft services', href: '/microsoft' },
  ]}
/>
