---
import BuyerServicePage from '../../components/BuyerServicePage.astro';

const outcomes = [
  {
    title: 'Know your real exposure',
    description: 'A focused review of how Microsoft 365, SharePoint, Teams, VPN, and network settings are actually configured.',
    icon: 'shield',
  },
  {
    title: 'Clear remediation steps',
    description: 'Findings ranked by risk with plain, practical fixes your team (or ours) can action straight away.',
    icon: 'check',
  },
  {
    title: 'Fast turnaround',
    description: 'A short, fixed-scope engagement that gives you answers in days, not weeks.',
    icon: 'compliance',
  },
];

const includes = [
  'Microsoft 365 configuration and security review',
  'SharePoint and Teams external sharing review',
  'Identity, MFA, and Conditional Access check',
  'VPN and firewall rule review',
  'Network segmentation and access review',
  '20+ point configuration checklist',
  'Prioritised remediation steps',
  'Findings report and handover',
];

const process = [
  { title: 'Scope', description: 'We agree which platforms and systems are in scope and gather read-only access.' },
  { title: 'Review', description: 'We assess configuration against security best practice across the agreed systems.' },
  { title: 'Report', description: 'You get a clear, prioritised findings report with practical remediation steps.' },
  { title: 'Remediate', description: 'We can implement the fixes for you, or support your team to action them.' },
];

const faqs = [
  {
    question: 'How long does a configuration review take?',
    answer: 'Most reviews are a fixed 2–3 day engagement depending on the number of systems in scope, with the report delivered shortly after.',
  },
  {
    question: 'Is the review safe to run on live systems?',
    answer: 'Yes. Reviews are read-only — we assess configuration and access without changing your environment.',
  },
  {
    question: 'Can you fix the issues you find?',
    answer: 'Yes. You can take the report and act on it yourself, or we can implement the agreed remediation and re-check.',
  },
];
---

<BuyerServicePage
  hideMedia
  metaTitle="Security Configuration Reviews | Centrix"
  metaDescription="Quick, focused security configuration assessments for Microsoft 365, SharePoint, Teams, VPN, and network infrastructure, with clear remediation steps."
  eyebrow="Security Configuration Reviews"
  heading="Fast, focused security configuration reviews"
  lead="Quick, focused security configuration assessments for Microsoft 365, SharePoint, Teams, VPN, and network infrastructure — with clear, prioritised remediation steps."
  primaryCta={{ label: 'Book a configuration review', href: '/contact?service=configuration-review' }}
  secondaryCta={{ label: 'Managed security', href: '/services/managed-security' }}
  proof={['2–3 day turnaround', '20+ point checklist', 'Prioritised remediation', 'Read-only and non-disruptive']}
  outcomes={outcomes}
  includes={includes}
  process={process}
  faqs={faqs}
  mediaLabel="Security configuration review imagery"
  mediaHint="e.g. a security settings/audit dashboard or a reviewer working through a configuration checklist"
  mediaIcon="shield"
  related={[
    { label: 'Managed security', href: '/services/managed-security' },
    { label: 'Microsoft 365 security', href: '/services/microsoft-365' },
    { label: 'Web security', href: '/services/web-security' },
  ]}
/>
