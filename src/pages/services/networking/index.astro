---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = "Enterprise Networking Solutions | UniFi & Site Technology | Waymark";
const description = "Professional network design, deployment, and management. UniFi certified partner delivering enterprise-grade Wi-Fi, switching, cameras, and access control.";

const services = [
  {
    id: "unifi",
    title: "UniFi Solutions",
    description: "Complete network infrastructure with Wi-Fi, switching, security gateways, cameras, and access control—all in one unified platform.",
    href: "/services/networking/unifi",
    icon: "network",
    features: ["Wi-Fi 6/6E Coverage", "PoE+ Switching", "Security Cameras", "Access Control"],
    color: "orange",
  },
  {
    id: "managed",
    title: "Managed Network Operations",
    description: "Ongoing network management with 24/7 monitoring, firmware updates, configuration backups, and proactive maintenance.",
    href: "/contact?service=managed-network",
    icon: "settings",
    features: ["24/7 Monitoring", "Firmware Updates", "Monthly Reports", "Priority Support"],
    color: "blue",
  },
];

const stats = [
  { value: "500+", label: "Networks Deployed" },
  { value: "99.9%", label: "Uptime Guarantee" },
  { value: "24/7", label: "Support Available" },
  { value: "UniFi", label: "Certified Partner" },
];

const whyUs = [
  {
    title: "Certified Expertise",
    description: "UniFi certified engineers with hundreds of deployments across industries.",
    icon: "badge",
  },
  {
    title: "End-to-End Delivery",
    description: "From site survey to ongoing support—we handle the complete lifecycle.",
    icon: "cycle",
  },
  {
    title: "Unified Platform",
    description: "One console for networking, cameras, access control, and phones.",
    icon: "grid",
  },
  {
    title: "Scalable Design",
    description: "Architecture that grows with your business, from 10 to 10,000 users.",
    icon: "scale",
  },
];
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-gradient"></div>
      <div class="hero-pattern"></div>
      <div class="hero-orb"></div>
    </div>
    <div class="container">
      <div class="hero-content">
        <div class="hero-badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 011.06 0z" />
          </svg>
          <span>Network Infrastructure</span>
        </div>
        <h1 class="hero-title">
          Enterprise<br />
          <span class="hero-accent">Networking</span>
        </h1>
        <p class="hero-description">
          Professional network design and deployment powered by UniFi. From Wi-Fi coverage to security cameras—one unified platform, expertly configured.
        </p>
        <div class="hero-actions">
          <a href="/services/networking/unifi" class="btn-primary">
            <span>Explore UniFi Solutions</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
          <a href="/contact?service=networking" class="btn-secondary">Get a Quote</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats-section">
    <div class="container">
      <div class="stats-grid">
        {stats.map((stat) => (
          <div class="stat-item">
            <div class="stat-value">{stat.value}</div>
            <div class="stat-label">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="services-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Our Services</span>
        <h2 class="section-title">Networking solutions</h2>
        <p class="section-description">Choose from full-stack UniFi deployments or ongoing managed operations.</p>
      </div>

      <div class="services-grid">
        {services.map((service, i) => (
          <a href={service.href} class={`service-card service-${service.color}`} style={`animation-delay: ${i * 0.15}s`}>
            <div class="service-icon">
              {service.icon === 'network' && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 011.06 0z" /></svg>}
              {service.icon === 'settings' && <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>}
            </div>
            <h3 class="service-title">{service.title}</h3>
            <p class="service-description">{service.description}</p>
            <div class="service-features">
              {service.features.map((feature) => (
                <span class="feature-tag">{feature}</span>
              ))}
            </div>
            <span class="service-link">
              Learn more
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Us -->
  <section class="why-section">
    <div class="container">
      <div class="section-header centered">
        <span class="section-tag">Why Waymark</span>
        <h2 class="section-title">Network expertise you can trust</h2>
        <p class="section-description">We bring enterprise networking capabilities to businesses of all sizes.</p>
      </div>

      <div class="why-grid">
        {whyUs.map((item, i) => (
          <div class="why-card" style={`animation-delay: ${i * 0.1}s`}>
            <div class="why-icon">
              {item.icon === 'badge' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" /></svg>}
              {item.icon === 'cycle' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 00-3.7-3.7 48.678 48.678 0 00-7.324 0 4.006 4.006 0 00-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3l-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 003.7 3.7 48.656 48.656 0 007.324 0 4.006 4.006 0 003.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3l-3 3" /></svg>}
              {item.icon === 'grid' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>}
              {item.icon === 'scale' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6" /></svg>}
            </div>
            <h3 class="why-title">{item.title}</h3>
            <p class="why-description">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-card">
        <div class="cta-glow"></div>
        <div class="cta-content">
          <h2 class="cta-title">Ready to upgrade your network?</h2>
          <p class="cta-description">Get a free consultation and custom quote for your networking project.</p>
          <div class="cta-actions">
            <a href="/contact?service=networking" class="btn-cta-primary">
              <span>Get Free Consultation</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
            </a>
            <a href="/services" class="btn-cta-secondary">View All Services</a>
          </div>
        </div>
        <div class="cta-pattern"></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :root {
    --accent: #f97316;
    --accent-light: rgba(249, 115, 22, 0.1);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Hero */
  .hero {
    position: relative;
    padding: 8rem 0 6rem;
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .hero {
      padding: 10rem 0 8rem;
    }
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-primary) 50%, rgba(249, 115, 22, 0.03) 100%);
  }

  .hero-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--border-primary) 1px, transparent 1px);
    background-size: 32px 32px;
    opacity: 0.5;
    mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
  }

  .hero-orb {
    position: absolute;
    top: 10%;
    right: 10%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(249, 115, 22, 0.15) 0%, transparent 70%);
    filter: blur(60px);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 600px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--accent-light);
    border: 1px solid rgba(249, 115, 22, 0.2);
    border-radius: 9999px;
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 4.5rem;
    }
  }

  .hero-accent {
    background: linear-gradient(135deg, var(--accent), #fb923c);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-description {
    font-size: 1.25rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.75rem;
    background: linear-gradient(135deg, var(--accent), #fb923c);
    color: white;
    font-weight: 500;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.3s;
    box-shadow: 0 4px 15px rgba(249, 115, 22, 0.3);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(249, 115, 22, 0.4);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 1rem 1.75rem;
    background: var(--bg-primary);
    color: var(--text-primary);
    font-weight: 500;
    border: 1px solid var(--border-primary);
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-secondary:hover {
    border-color: var(--accent);
  }

  /* Stats */
  .stats-section {
    padding: 3rem 0;
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-primary);
    border-bottom: 1px solid var(--border-primary);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat-item {
    text-align: center;
  }

  .stat-value {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    margin-top: 0.25rem;
  }

  /* Section Styles */
  .section-header {
    max-width: 560px;
    margin-bottom: 4rem;
  }

  .section-header.centered {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  .section-tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--accent-light);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 9999px;
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .section-title {
      font-size: 2.5rem;
    }
  }

  .section-description {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* Services */
  .services-section {
    padding: 6rem 0;
  }

  @media (min-width: 1024px) {
    .services-section {
      padding: 8rem 0;
    }
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .service-card {
    display: flex;
    flex-direction: column;
    padding: 2.5rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: 1.5rem;
    text-decoration: none;
    transition: all 0.3s;
    animation: fadeInUp 0.5s ease-out both;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .service-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
  }

  .service-card.service-orange:hover {
    border-color: #f97316;
    box-shadow: 0 25px 50px -12px rgba(249, 115, 22, 0.2);
  }

  .service-card.service-blue:hover {
    border-color: #3b82f6;
    box-shadow: 0 25px 50px -12px rgba(59, 130, 246, 0.2);
  }

  .service-icon {
    width: 4rem;
    height: 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 1rem;
    margin-bottom: 1.5rem;
    transition: all 0.3s;
  }

  .service-orange .service-icon {
    background: rgba(249, 115, 22, 0.1);
    color: #f97316;
  }

  .service-blue .service-icon {
    background: rgba(59, 130, 246, 0.1);
    color: #3b82f6;
  }

  .service-card:hover .service-icon {
    transform: scale(1.1);
  }

  .service-orange:hover .service-icon {
    background: linear-gradient(135deg, #f97316, #fb923c);
    color: white;
  }

  .service-blue:hover .service-icon {
    background: linear-gradient(135deg, #3b82f6, #6366f1);
    color: white;
  }

  .service-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .service-description {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .service-features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .feature-tag {
    padding: 0.375rem 0.75rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: 9999px;
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-weight: 500;
    transition: gap 0.2s;
  }

  .service-orange .service-link { color: #f97316; }
  .service-blue .service-link { color: #3b82f6; }

  .service-card:hover .service-link {
    gap: 0.625rem;
  }

  /* Why Us */
  .why-section {
    padding: 6rem 0;
    background: var(--bg-secondary);
  }

  @media (min-width: 1024px) {
    .why-section {
      padding: 8rem 0;
    }
  }

  .why-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .why-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .why-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .why-card {
    background: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: 1rem;
    padding: 2rem;
    text-align: center;
    transition: all 0.3s;
    animation: fadeInUp 0.5s ease-out both;
  }

  .why-card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
  }

  .why-icon {
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-light);
    color: var(--accent);
    border-radius: 0.75rem;
    margin: 0 auto 1.25rem;
    transition: all 0.3s;
  }

  .why-card:hover .why-icon {
    background: linear-gradient(135deg, var(--accent), #fb923c);
    color: white;
  }

  .why-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .why-description {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* CTA */
  .cta-section {
    padding: 6rem 0;
  }

  @media (min-width: 1024px) {
    .cta-section {
      padding: 8rem 0;
    }
  }

  .cta-card {
    position: relative;
    background: var(--bg-primary);
    border: 1px solid var(--border-primary);
