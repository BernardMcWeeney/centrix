---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteIcon from '../../../components/SiteIcon.astro';

const title = 'Business Networking Services';
const description = 'Business networking, Wi-Fi, CCTV, IP cameras, switching, routing, VPNs, VoIP, backup connectivity, and managed support for Irish businesses.';

const services = [
  {
    title: 'UniFi networks',
    description: 'UniFi Wi-Fi, switching, gateways, guest networks, CCTV, VLANs, and managed support.',
    href: '/unifi-installer-ireland',
    icon: 'network',
  },
  {
    title: 'UniFi network audit',
    description: 'Review Wi-Fi, VLANs, firewall rules, cameras, admin access, backups, firmware, and support risk.',
    href: '/unifi-network-audit',
    icon: 'compliance',
  },
  {
    title: 'Business network design',
    description: 'Routing, switching, PoE, Wi-Fi, VLANs, firewalls, VPN readiness, voice networks, cameras, and documentation.',
    href: '/services/networking/business-networking',
    icon: 'network',
  },
  {
    title: 'VPN and remote access',
    description: 'Point-to-point, site-to-site, and remote-user VPNs with routing, firewall rules, testing, and handover.',
    href: '/services/networking/vpn-remote-access',
    icon: 'lock',
  },
  {
    title: 'Backup and resilience',
    description: 'Backup internet, failover planning, configuration backups, recovery runbooks, and DR readiness checks.',
    href: '/services/networking/backup-resilience',
    icon: 'cloud',
  },
  {
    title: 'VoIP and business phones',
    description: 'Business telephone setup with handsets, users, call flows, voice VLANs, PoE, and support.',
    href: '/services/networking/voip-business-phones',
    icon: 'phone',
  },
  {
    title: 'Business Wi-Fi',
    description: 'Fast, reliable Wi-Fi with access point planning, guest access, roaming, and secure network separation.',
    href: '/services/networking/business-wifi',
    icon: 'wifi',
  },
  {
    title: 'CCTV and IP cameras',
    description: 'Camera systems with mobile app, web viewer, local recording, access roles, and support.',
    href: '/services/networking/cctv-ip-cameras',
    icon: 'camera',
  },
];
---

<BaseLayout title={title} description={description}>
  <main class="consult-page">
    <section class="consult-subhero">
      <div class="container-wide">
        <div class="consult-subhero-grid">
          <div>
            <div class="consult-eyebrow">Business Networking</div>
            <h1 class="consult-subhero-title">Reliable networks and site technology for Irish business premises.</h1>
            <p class="consult-lead">
              Centrix designs, installs, secures, documents, and supports business networks covering UniFi, Wi-Fi, switching, routing, VPNs, CCTV, IP cameras, VoIP, backup links, VLANs, and guest access.
            </p>
            <div class="consult-actions">
              <a href="/services/networking/business-networking" class="consult-btn consult-btn-primary">
                Start with networking
                <SiteIcon name="arrow-right" size={18} />
              </a>
              <a href="/contact?service=networking" class="consult-btn consult-btn-secondary">Discuss a site project</a>
            </div>
          </div>
          <aside class="consult-proof-panel">
            <h2>Typical projects</h2>
            <ul>
              <li><SiteIcon name="check" size={18} /><span>Poor Wi-Fi coverage or unreliable roaming</span></li>
              <li><SiteIcon name="check" size={18} /><span>UniFi network audits, installation, and managed support</span></li>
              <li><SiteIcon name="check" size={18} /><span>New office, unit, school, retail, or warehouse fit-out</span></li>
              <li><SiteIcon name="check" size={18} /><span>VPNs between sites, staff, suppliers, or cloud systems</span></li>
              <li><SiteIcon name="check" size={18} /><span>VoIP, CCTV, backup connectivity, and managed support</span></li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    <section class="consult-section">
      <div class="container-wide">
        <div class="consult-section-heading">
          <span class="consult-kicker">Services</span>
          <h2>Choose the networking service that matches the problem.</h2>
        </div>
        <div class="consult-card-grid three">
          {services.map((service) => (
            <a href={service.href} class="consult-card">
              <div class="consult-card-icon"><SiteIcon name={service.icon} size={24} /></div>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              <span class="consult-card-link">
                View service
                <SiteIcon name="arrow-right" size={16} />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
