---
import BuyerServicePage from '../../../components/BuyerServicePage.astro';

const outcomes = [
  {
    title: 'One managed network',
    description: 'Routing, switching, Wi-Fi, cameras, phones, VPNs, and monitoring can be planned as one coherent site network.',
    icon: 'network',
  },
  {
    title: 'Secure site design',
    description: 'Separate staff, guest, IoT, camera, voice, and management networks so devices only reach what they should.',
    icon: 'shield',
  },
  {
    title: 'Documented handover',
    description: 'Network diagrams, equipment list, VLAN plan, admin access, and support process are documented for future changes.',
    icon: 'compliance',
  },
];

const includes = [
  'Site requirements and current network review',
  'Gateway, switch, access point, and camera planning',
  'VLAN, firewall, guest access, VPN, and management design',
  'Point-to-point, site-to-site, and remote-access VPN planning where required',
  'VoIP and business telephone network readiness',
  'Backup internet, failover, and recovery considerations',
  'Equipment configuration and deployment support',
  'Performance testing and basic security checks',
  'Camera integration where required',
  'Network documentation and admin handover',
  'Optional monitoring, updates, backups, and support',
];

const process = [
  { title: 'Survey', description: 'We review the site, existing cabling, internet, cabinets, users, business systems, and areas that need coverage.' },
  { title: 'Design', description: 'Centrix creates a practical network design covering equipment, segmentation, VPNs, voice, cameras, guest access, and support.' },
  { title: 'Deploy', description: 'We configure, install, test, secure, and document the agreed network platform.' },
  { title: 'Manage', description: 'Ongoing support can cover monitoring, updates, backup configs, troubleshooting, and regular health checks.' },
];

const faqs = [
  {
    question: 'Can this support a full business premises?',
    answer: 'Yes, when the design is matched to the building and workload. We review switching, PoE, cabling, Wi-Fi density, internet, cameras, and segmentation before specifying hardware.',
  },
  {
    question: 'Can you add VPNs or phone systems to the network?',
    answer: 'Yes. Centrix can plan point-to-point VPNs, remote-user access, voice VLANs, PoE switching, call-flow requirements, and the firewall rules needed to support them.',
  },
  {
    question: 'Can you work with our electrician or cabling contractor?',
    answer: 'Yes. Centrix can provide the network design and work with existing contractors on cable routes, cabinet layout, device placement, and commissioning.',
  },
  {
    question: 'Can you manage the system after installation?',
    answer: 'Yes. Managed support can include monitoring, firmware planning, configuration backups, issue response, and periodic reviews.',
  },
];
---

<BuyerServicePage
  metaTitle="Full Business Network Design And Deployment"
  metaDescription="Full business network design, deployment, Wi-Fi, switching, routing, cameras, VPNs, VoIP readiness, segmentation, documentation, and managed support for Irish businesses."
  eyebrow="Full Business Network"
  heading="Do you need a complete network for your business premises?"
  lead="Centrix designs and deploys full business networks for Irish premises that need reliable Wi-Fi, switching, routing, cameras, VPNs, guest access, voice readiness, network separation, and clear support."
  primaryCta={{ label: 'Discuss a network project', href: '/contact?service=business-networking' }}
  secondaryCta={{ label: 'View business Wi-Fi', href: '/services/networking/business-wifi' }}
  proof={['Wi-Fi, switching, routing, VPNs, and cameras', 'Secure VLAN and guest network design', 'Voice and backup connectivity planning', 'Configuration documentation and optional support']}
  outcomes={outcomes}
  includes={includes}
  process={process}
  faqs={faqs}
  related={[
    { label: 'Business networking', href: '/services/networking/business-networking' },
    { label: 'VPN and remote access', href: '/services/networking/vpn-remote-access' },
    { label: 'Backup and resilience', href: '/services/networking/backup-resilience' },
    { label: 'VoIP and business phones', href: '/services/networking/voip-business-phones' },
    { label: 'Business Wi-Fi', href: '/services/networking/business-wifi' },
    { label: 'CCTV and IP cameras', href: '/services/networking/cctv-ip-cameras' },
  ]}
/>
