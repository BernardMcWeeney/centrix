---
import BuyerServicePage from '../../components/BuyerServicePage.astro';

const outcomes = [
  {
    title: 'Contain it fast',
    description: 'Rapid triage and containment to stop an active incident spreading and limit the damage.',
    icon: 'shield',
  },
  {
    title: 'Understand what happened',
    description: 'Investigation to establish scope, root cause, and what data or accounts were affected.',
    icon: 'monitor',
  },
  {
    title: 'Be ready next time',
    description: 'Retainers and tabletop exercises so your team knows exactly what to do under pressure.',
    icon: 'check',
  },
];

const includes = [
  'Breach triage and containment',
  'Forensic investigation and scoping',
  'Incident response retainer with response SLA',
  'Tabletop exercises and readiness drills',
  'Microsoft 365 / Entra compromise investigation',
  'Post-incident report and root-cause analysis',
  'Recovery, hardening, and lessons learned',
  'Stakeholder and breach-notification support',
];

const process = [
  { title: 'Contain', description: 'We triage the incident, isolate affected systems and accounts, and stop the bleeding.' },
  { title: 'Investigate', description: 'We establish scope, timeline, and root cause using logs and forensic evidence.' },
  { title: 'Recover', description: 'We restore safely, reset credentials, and harden against the same attack path.' },
  { title: 'Learn', description: 'We deliver a post-incident report and improvements so it is far less likely to recur.' },
];

const faqs = [
  {
    question: 'Do we need a retainer to call you in an incident?',
    answer: 'A retainer guarantees a faster, contracted response, but we can also help on a best-effort basis during an active incident.',
  },
  {
    question: 'What is a tabletop exercise?',
    answer: 'A guided walk-through of a realistic incident scenario with your team, so everyone knows their role before a real event.',
  },
  {
    question: 'Can you handle Microsoft 365 account compromise?',
    answer: 'Yes. Business email compromise and Entra ID account takeover are among the most common incidents we investigate and remediate.',
  },
];
---

<BuyerServicePage
  metaTitle="Incident Response Services | Centrix"
  metaDescription="Rapid incident response including breach assessment, IR retainers, and tabletop exercises to contain, investigate, and recover from security incidents."
  eyebrow="Incident Response"
  heading="Rapid, practical incident response"
  lead="Breach assessment, incident response retainers, and tabletop exercises to contain, investigate, and recover from security incidents — calmly and quickly."
  primaryCta={{ label: 'Talk to us about IR', href: '/contact?service=incident-response' }}
  secondaryCta={{ label: 'Managed security', href: '/services/managed-security' }}
  proof={['Triage and containment', 'Forensic investigation', 'IR retainers', 'Tabletop exercises']}
  outcomes={outcomes}
  includes={includes}
  process={process}
  faqs={faqs}
  mediaLabel="Incident response imagery"
  mediaHint="e.g. a SOC / monitoring screen, an investigation timeline, or an incident response team at work"
  mediaIcon="shield"
  related={[
    { label: 'Managed security', href: '/services/managed-security' },
    { label: 'Configuration reviews', href: '/services/configuration-reviews' },
    { label: 'Microsoft 365 security', href: '/services/microsoft-365' },
  ]}
/>
