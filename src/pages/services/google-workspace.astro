---
import BuyerServicePage from '../../components/BuyerServicePage.astro';

const outcomes = [
  {
    title: 'A hardened admin console',
    description: 'Google Workspace admin settings reviewed and secured — 2-step verification, admin roles, and access controls.',
    icon: 'lock',
  },
  {
    title: 'Controlled sharing',
    description: 'Drive and external sharing locked down so company data is not over-exposed to outside accounts.',
    icon: 'shield',
  },
  {
    title: 'Trusted email',
    description: 'SPF, DKIM, and DMARC configured so your domain authenticates properly and is harder to spoof.',
    icon: 'check',
  },
];

const includes = [
  'Google Workspace admin and security review',
  '2-step verification (2SV) enforcement',
  'Admin role and privileged access review',
  'Drive and external sharing controls',
  'SPF, DKIM, and DMARC email authentication',
  'Mobile device management policies',
  'Data retention and Vault review',
  'Ongoing managed administration (optional)',
];

const process = [
  { title: 'Assess', description: 'We review your Workspace configuration, users, sharing, email authentication, and admin access.' },
  { title: 'Harden', description: 'We apply 2SV, sharing controls, DMARC, and admin hardening with minimal disruption.' },
  { title: 'Document', description: 'You get a clear record of changes, policies, and recommendations.' },
  { title: 'Manage', description: 'We can provide ongoing managed administration, monitoring, and support.' },
];

const faqs = [
  {
    question: 'Do you offer a one-off review or ongoing management?',
    answer: 'Both. We can deliver a one-off security assessment and hardening, or provide ongoing managed Google Workspace administration.',
  },
  {
    question: 'Can you help us move between Google Workspace and Microsoft 365?',
    answer: 'Yes. We handle migrations in both directions, including email, files, and identity, as part of our cloud migration service.',
  },
  {
    question: 'Will changes disrupt staff?',
    answer: 'We stage and communicate changes like 2SV enforcement so users have time to enrol, avoiding lockouts.',
  },
];
---

<BuyerServicePage
  mediaSrc="/products/google-workspace.png"
  metaTitle="Google Workspace Security | Centrix"
  metaDescription="Google Workspace security assessments and managed administration — 2SV, sharing controls, DMARC, and admin hardening for Irish businesses."
  eyebrow="Google Workspace"
  heading="Secure and manage Google Workspace properly"
  lead="Google Workspace security assessments and managed administration — 2-step verification, sharing controls, DMARC, and admin hardening for Irish businesses."
  primaryCta={{ label: 'Book a Workspace review', href: '/contact?service=google-workspace' }}
  secondaryCta={{ label: 'Microsoft 365 security', href: '/services/microsoft-365' }}
  proof={['Admin and 2SV hardening', 'Drive sharing controls', 'SPF/DKIM/DMARC', 'Optional managed administration']}
  outcomes={outcomes}
  includes={includes}
  process={process}
  faqs={faqs}
  mediaLabel="Google Workspace imagery"
  mediaHint="e.g. the Google Workspace admin console, Gmail security settings, or Drive sharing controls"
  mediaIcon="cloud"
  related={[
    { label: 'Microsoft 365 security', href: '/services/microsoft-365' },
    { label: 'Identity & access', href: '/services/identity' },
    { label: 'Managed security', href: '/services/managed-security' },
  ]}
/>
