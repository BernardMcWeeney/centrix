---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteIcon from '../components/SiteIcon.astro';

const title = 'Business Networking, Wi-Fi, CCTV, VPN And VoIP Services';
const description = 'Business networking, Wi-Fi, CCTV, IP cameras, switching, routing, VPNs, VoIP, backup connectivity, and managed network support for Irish businesses.';

const services = [
  {
    title: 'Business network design',
    description: 'Routing, switching, PoE, Wi-Fi, VLANs, firewalls, cabinets, and documentation for reliable business premises.',
    href: '/services/networking/business-networking',
    icon: 'network',
  },
  {
    title: 'VPN and remote access',
    description: 'Point-to-point, site-to-site, and remote-user VPNs with routing, firewall rules, testing, and handover.',
    href: '/services/networking/vpn-remote-access',
    icon: 'lock',
  },
  {
    title: 'Backup and resilience',
    description: 'Backup internet, failover planning, configuration backups, recovery runbooks, and DR readiness checks.',
    href: '/services/networking/backup-resilience',
    icon: 'cloud',
  },
  {
    title: 'VoIP and business phones',
    description: 'Business telephone setup with handsets, users, call flows, voice VLANs, PoE, and support.',
    href: '/services/networking/voip-business-phones',
    icon: 'phone',
  },
  {
    title: 'Business Wi-Fi',
    description: 'Wireless survey, access point placement, guest Wi-Fi, roaming, VLANs, and performance tuning.',
    href: '/services/networking/business-wifi',
    icon: 'wifi',
  },
  {
    title: 'CCTV and IP cameras',
    description: 'Camera coverage planning, local recording, mobile and web viewing, access roles, and support.',
    href: '/services/networking/cctv-ip-cameras',
    icon: 'camera',
  },
];

const environments = [
  'Offices and professional services',
  'Retail and hospitality',
  'Schools and community facilities',
  'Warehouses and industrial units',
  'Multi-site businesses',
  'Guest Wi-Fi and visitor access',
  'CCTV coverage for yards and entrances',
  'Point-to-point VPNs between locations',
  'Remote staff and supplier access',
  'VoIP and business telephone networks',
  'Backup internet and failover planning',
  'Secure staff, guest, voice, camera, and IoT separation',
];
---

<BaseLayout title={title} description={description}>
  <main class="consult-page">
    <section class="consult-subhero">
      <div class="container-wide">
        <div class="consult-subhero-grid">
          <div>
            <div class="consult-eyebrow">Business Networking</div>
            <h1 class="consult-subhero-title">Does your business need more than Wi-Fi from its network?</h1>
            <p class="consult-lead">
              Centrix designs, installs, secures, and supports business networks for Irish premises, covering Wi-Fi, routing, switching, VPNs, CCTV, VoIP, backup connectivity, and ongoing support.
            </p>
            <div class="consult-actions">
              <a href="/services/networking/business-networking" class="consult-btn consult-btn-primary">
                View networking services
                <SiteIcon name="arrow-right" size={18} />
              </a>
              <a href="/services/networking/vpn-remote-access" class="consult-btn consult-btn-secondary">View VPN options</a>
            </div>
          </div>
          <aside class="consult-proof-panel">
            <h2>Centrix can cover</h2>
            <ul>
              <li><SiteIcon name="check" size={18} /><span>Wi-Fi, switching, routing, and firewall rules</span></li>
              <li><SiteIcon name="check" size={18} /><span>Point-to-point, site-to-site, and remote-user VPNs</span></li>
              <li><SiteIcon name="check" size={18} /><span>CCTV, IP cameras, and simple remote viewing</span></li>
              <li><SiteIcon name="check" size={18} /><span>VoIP, phone networks, backup links, and DR planning</span></li>
              <li><SiteIcon name="check" size={18} /><span>Monitoring, configuration backups, updates, and support</span></li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    <section class="consult-section">
      <div class="container-wide">
        <div class="consult-section-heading">
          <span class="consult-kicker">Networking Services</span>
          <h2>Business premises technology from survey to support.</h2>
        </div>
        <div class="consult-card-grid four">
          {services.map((service) => (
            <a href={service.href} class="consult-card">
              <div class="consult-card-icon"><SiteIcon name={service.icon} size={24} /></div>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              <span class="consult-card-link">
                View service
                <SiteIcon name="arrow-right" size={16} />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="consult-section consult-section-muted">
      <div class="container-wide">
        <div class="consult-split">
          <div>
            <span class="consult-kicker">Where It Fits</span>
            <h2>Built for busy premises, not just tidy network diagrams.</h2>
            <p>
              We design around the building, the users, the equipment, and the business risk. Coverage, reliability, security, and usability all matter.
            </p>
          </div>
          <div class="consult-check-list">
            {environments.map((item) => (
              <div class="consult-check-item">
                <SiteIcon name="check" size={18} />
                <span>{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="consult-cta">
      <div class="container-wide">
        <div class="consult-cta-inner">
          <div>
            <span class="consult-kicker">Next Step</span>
            <h2>Book a networking, VPN, VoIP, CCTV, or resilience consultation for your premises.</h2>
          </div>
          <a href="/contact" class="consult-btn consult-btn-primary">
            Talk about networking
            <SiteIcon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
