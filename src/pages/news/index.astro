---
import NewsListing from '../../components/NewsListing.astro';
import { getNewsListing, NEWS_PAGE_SIZE } from '../../lib/news';
const { featuredPost, posts, totalPages } = await getNewsListing();
---
<NewsListing featuredPost={featuredPost} recentPosts={posts.slice(0, NEWS_PAGE_SIZE)} currentPage={1} totalPages={totalPages} totalPosts={posts.length} />
