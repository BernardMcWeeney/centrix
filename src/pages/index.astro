---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteIcon from '../components/SiteIcon.astro';
import PlatformLogo from '../components/PlatformLogo.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';

const title = 'Irish Business IT & Technology Consultancy';
const description = 'Centrix helps Irish businesses with Microsoft cloud, UniFi networks, business Wi-Fi, CCTV, VLANs, VPNs, VoIP, security, compliance readiness, and practical AI consultancy.';

const pillars = [
  {
    title: 'Microsoft cloud',
    description: 'Microsoft 365, Azure, Intune, Defender, email migration, identity, and cloud modernisation for Irish businesses.',
    href: '/microsoft',
    icon: 'microsoft',
  },
  {
    title: 'Business networking',
    description: 'UniFi networks, Wi-Fi, switching, routing, VLANs, VPNs, CCTV, VoIP, backup connectivity, and managed network support.',
    href: '/networks',
    icon: 'network',
  },
  {
    title: 'Security & compliance',
    description: 'Practical security controls, vulnerability work, NIS2 readiness, GDPR support, incident response, and monitoring.',
    href: '/security',
    icon: 'shield',
  },
  {
    title: 'AI & automation',
    description: 'Claude, ChatGPT, Copilot, Cloudflare AI, AI policy, workflow automation, data hygiene, and safe adoption plans.',
    href: '/ai',
    icon: 'ai',
  },
];

const networkingQuestions = [
  {
    title: 'Do you need a UniFi installer in Ireland?',
    description: 'UniFi Wi-Fi, switching, gateways, CCTV, guest networks, VLANs, documentation, and managed support.',
    href: '/unifi-installer-ireland',
    icon: 'network',
  },
  {
    title: 'Is your UniFi network slow or undocumented?',
    description: 'Audit Wi-Fi coverage, VLANs, firewall rules, cameras, admin access, firmware, backups, and support risk.',
    href: '/unifi-network-audit',
    icon: 'compliance',
  },
  {
    title: 'Do you need UniFi Protect CCTV?',
    description: 'Camera planning, local recording, app access, retention planning, camera VLANs, and support.',
    href: '/unifi-protect-cctv-ireland',
    icon: 'camera',
  },
  {
    title: 'Do you need point-to-point or remote access VPNs?',
    description: 'Connect sites, staff, suppliers, and trusted systems with scoped VPN access, routing, firewall rules, and documentation.',
    href: '/services/networking/vpn-remote-access',
    icon: 'lock',
  },
  {
    title: 'Do you need backup internet and DR readiness?',
    description: 'Backup connectivity, config backups, failover checks, recovery runbooks, and practical resilience planning.',
    href: '/services/networking/backup-resilience',
    icon: 'cloud',
  },
  {
    title: 'Do you need business phones and VoIP?',
    description: 'Handsets, users, call flows, voice VLANs, PoE readiness, voicemail, opening hours, and support.',
    href: '/services/networking/voip-business-phones',
    icon: 'phone',
  },
];

const microsoftServices = [
  {
    title: 'Moving to the cloud',
    description: 'Email, files, identity, devices, and business systems moved to Microsoft cloud with a controlled migration plan.',
    href: '/services/microsoft-365/cloud-migration',
    icon: 'cloud',
  },
  {
    title: 'Microsoft 365 security',
    description: 'Secure Score review, MFA, Conditional Access, Defender, email protection, data retention, and practical hardening.',
    href: '/services/microsoft-365',
    icon: 'lock',
  },
  {
    title: 'Modern device management',
    description: 'Intune setup for Windows, macOS, iOS, and Android, with compliance policies and app deployment.',
    href: '/services/intune',
    icon: 'device',
  },
  {
    title: 'NIS2 and GDPR readiness',
    description: 'Control mapping, evidence gathering, technical safeguards, incident process, and data protection support.',
    href: '/services/security/nis2-gdpr-readiness',
    icon: 'compliance',
  },
];

const process = [
  { title: 'Understand', description: 'We learn your premises, staff, systems, risks, and business priorities before recommending technology.' },
  { title: 'Design', description: 'You get a clear scope, plain-English options, a practical roadmap, and realistic rollout sequencing.' },
  { title: 'Deliver', description: 'We configure, migrate, install, test, document, and hand over with minimal disruption to your team.' },
  { title: 'Support', description: 'Centrix can stay involved through monitoring, monthly reviews, security checks, and ongoing improvement.' },
];

const caseStudies = [
  {
    title: 'Microsoft cloud move for a growing office',
    description: 'A staged move covering email, shared files, identity, MFA, and device controls without turning the project into a big-bang changeover.',
    href: '/case-studies/microsoft-cloud/',
    icon: 'microsoft',
  },
  {
    title: 'Business networking for a busy premises',
    description: 'A practical premises upgrade combining wireless coverage, guest access, cameras, VPN access, phone readiness, and documented support.',
    href: '/case-studies/networking-premises/',
    icon: 'network',
  },
  {
    title: 'AI introduction for business teams',
    description: 'A plain-English introduction to ChatGPT, Claude, Copilot, and safe AI use, followed by workflow ideas staff could actually use.',
    href: '/case-studies/ai-introduction/',
    icon: 'ai',
  },
];
---

<BaseLayout title={title} description={description} image="/duleek-aerial-view.webp">
  <div class="consult-page">
    <section class="consult-home-hero" style="--hero-image: url('/duleek-aerial-view.webp');">
      <div class="container-wide">
        <div class="consult-hero-content">
          <div class="consult-eyebrow">Duleek, County Meath</div>
          <h1 class="consult-hero-title">Trusted IT, technology, and consultancy for Irish business.</h1>
          <p class="consult-hero-lead">
            Centrix helps businesses move to Microsoft cloud, build secure UniFi and business networks, improve security, prepare for compliance, and adopt AI safely.
          </p>
          <div class="consult-actions">
            <a href="/contact" class="consult-btn consult-btn-primary">
              Book a consultation
              <SiteIcon name="arrow-right" size={18} />
            </a>
            <a href="#services" class="consult-btn consult-btn-secondary">Explore services</a>
          </div>
          <div class="consult-hero-meta" aria-label="Centrix focus areas">
            <span>Microsoft</span>
            <span>UniFi</span>
            <span>Networking</span>
            <span>Cloudflare</span>
            <span>Security</span>
            <span>AI</span>
          </div>
        </div>
      </div>
    </section>

    <section class="consult-band" aria-label="Centrix service promise">
      <div class="container-wide">
        <div class="consult-band-grid">
          <div class="consult-band-item">
            <strong>Irish business focus</strong>
            <span>Local, practical, and built around how your team works.</span>
          </div>
          <div class="consult-band-item">
            <strong>Blue-chip platforms</strong>
            <span>Microsoft, Defender, Intune, Copilot, secure networks, and cloud tooling.</span>
          </div>
          <div class="consult-band-item">
            <strong>Clear scopes</strong>
            <span>Plain deliverables, known priorities, and documented handover.</span>
          </div>
          <div class="consult-band-item">
            <strong>Ongoing support</strong>
            <span>Stay covered after the project with managed services and reviews.</span>
          </div>
        </div>
      </div>
    </section>

    <section class="consult-section compact">
      <div class="container-wide">
        <div class="consult-section-heading centered">
          <span class="consult-kicker">Platforms</span>
          <h2>Trusted tools, introduced and managed properly.</h2>
          <p>Centrix helps businesses understand, choose, configure, and support the platforms that now sit behind everyday work.</p>
        </div>
        <div class="platform-strip">
          <PlatformLogo name="microsoft" />
          <PlatformLogo name="google" />
          <PlatformLogo name="unifi" />
          <PlatformLogo name="cloudflare" />
          <PlatformLogo name="chatgpt" />
          <PlatformLogo name="claude" />
        </div>
      </div>
    </section>

    <section id="services" class="consult-section">
      <div class="container-wide">
        <div class="consult-section-heading">
          <span class="consult-kicker">What Centrix Does</span>
          <h2>Technology that supports the business, not just the IT room.</h2>
          <p>Start with the area that is causing pain today, then build a roadmap across cloud, premises technology, security, and AI.</p>
        </div>
        <div class="consult-card-grid four">
          {pillars.map((pillar) => (
            <a href={pillar.href} class="consult-card">
              <div class="consult-card-icon"><SiteIcon name={pillar.icon} size={24} /></div>
              <h3>{pillar.title}</h3>
              <p>{pillar.description}</p>
              <span class="consult-card-link">
                Learn more
                <SiteIcon name="arrow-right" size={16} />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="consult-section consult-section-muted">
      <div class="container-wide">
        <div class="consult-section-heading">
          <span class="consult-kicker">Networking For Your Premises</span>
          <h2>UniFi networks, VPNs, phones, cameras, and resilience without complexity.</h2>
        </div>
        <div class="consult-section-media">
          <ImagePlaceholder
            label="Business networking imagery"
            src="/products/business-networking.png"
            icon="network"
            ratio="16 / 6"
          />
        </div>
        <div class="consult-card-grid four">
          {networkingQuestions.map((question) => (
            <a href={question.href} class="consult-card">
              <div class="consult-card-icon"><SiteIcon name={question.icon} size={24} /></div>
              <h3>{question.title}</h3>
              <p>{question.description}</p>
              <span class="consult-card-link">
                View service page
                <SiteIcon name="arrow-right" size={16} />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="consult-section">
      <div class="container-wide">
        <div class="consult-section-heading">
          <span class="consult-kicker">Microsoft, Cloud, And Compliance</span>
          <h2>Move, secure, and manage your Microsoft environment properly.</h2>
        </div>
        <div class="consult-section-media">
          <ImagePlaceholder
            label="Microsoft 365 & cloud migration imagery"
            src="/products/cloud-migration.png"
            icon="cloud"
            ratio="16 / 6"
          />
        </div>
        <div class="consult-card-grid four">
          {microsoftServices.map((service) => (
            <a href={service.href} class="consult-card">
              <div class="consult-card-icon"><SiteIcon name={service.icon} size={24} /></div>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              <span class="consult-card-link">
                Read more
                <SiteIcon name="arrow-right" size={16} />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="consult-section consult-section-muted">
      <div class="container-wide">
        <div class="consult-split">
          <div>
            <span class="consult-kicker">AI For Real Work</span>
            <h2>Simplify your business introduction to AI.</h2>
            <p>
              Centrix helps teams understand Claude, ChatGPT, Microsoft Copilot, Cloudflare AI, and practical automation without hype. We focus on safe use, approved tools, useful prompts, and workflows that save time.
            </p>
            <div class="consult-check-list">
              <div class="consult-check-item"><SiteIcon name="check" size={18} /><span>Copilot readiness and SharePoint permissions review</span></div>
              <div class="consult-check-item"><SiteIcon name="check" size={18} /><span>Claude, ChatGPT, and Copilot introduction for staff</span></div>
              <div class="consult-check-item"><SiteIcon name="check" size={18} /><span>AI usage policy, prompt guidance, and approved tool list</span></div>
              <div class="consult-check-item"><SiteIcon name="check" size={18} /><span>Data protection and governance controls</span></div>
            </div>
            <div class="consult-actions">
              <a href="/ai" class="consult-btn consult-btn-primary">
                Explore AI services
                <SiteIcon name="arrow-right" size={18} />
              </a>
            </div>
          </div>
          <ImagePlaceholder
            label="AI for business imagery"
            src="/products/ai-for-business.png"
            icon="ai"
            ratio="4 / 5"
          />
        </div>
      </div>
    </section>

    <section class="consult-section">
      <div class="container-wide">
        <div class="consult-section-heading">
          <span class="consult-kicker">Case Studies</span>
          <h2>Selected work patterns Centrix can deliver.</h2>
          <p>These examples are intentionally anonymised until client-approved details are ready to publish.</p>
        </div>
        <div class="consult-card-grid three">
          {caseStudies.map((study) => (
            <a href={study.href} class="consult-card">
              <div class="consult-card-icon"><SiteIcon name={study.icon} size={24} /></div>
              <h3>{study.title}</h3>
              <p>{study.description}</p>
              <span class="consult-card-link">
                View case study
                <SiteIcon name="arrow-right" size={16} />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="consult-section">
      <div class="container-wide">
        <div class="consult-section-heading centered">
          <span class="consult-kicker">How We Work</span>
          <h2>Clear consultancy, practical delivery, documented support.</h2>
        </div>
        <div class="consult-steps">
          {process.map((step, index) => (
            <div class="consult-step">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="consult-cta">
      <div class="container-wide">
        <div class="consult-cta-inner">
          <div>
            <span class="consult-kicker">Start A Conversation</span>
            <h2>Tell us what you are trying to improve, secure, migrate, or automate.</h2>
          </div>
          <a href="/contact" class="consult-btn consult-btn-primary">
            Contact Centrix
            <SiteIcon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
