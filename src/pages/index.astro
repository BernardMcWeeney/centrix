---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION, RECURRING_PLANS } from '../consts';

// 4 Pillars - Primary navigation/categorization
const pillars = [
  {
    title: 'Security',
    description: 'Pen testing, vulnerability management, and incident response',
    href: '/security',
    icon: 'shield',
    color: 'green'
  },
  {
    title: 'Microsoft',
    description: 'M365 security, Intune, Defender, and Conditional Access',
    href: '/microsoft',
    icon: 'microsoft',
    color: 'blue'
  },
  {
    title: 'AI',
    description: 'Copilot readiness, AI governance, and safe enablement',
    href: '/ai',
    icon: 'ai',
    color: 'purple'
  },
  {
    title: 'Networks',
    description: 'UniFi deployments with security-first design',
    href: '/networks',
    icon: 'network',
    color: 'orange'
  },
];

// 6 Hero Offers - The money-makers
const heroOffers = [
  {
    id: 'penetration-testing',
    title: 'Penetration Testing',
    description: 'Find vulnerabilities before attackers do. External, web app, and M365 identity testing.',
    href: '/security/penetration-testing',
    timeframe: '1-2 weeks',
    color: 'green',
    deliverables: ['Executive report', 'Technical findings', 'Remediation roadmap', 'Retest option'],
  },
  {
    id: 'm365-security-assessment',
    title: 'M365 Security Assessment',
    description: 'Comprehensive evaluation of your Microsoft 365 security posture with actionable recommendations.',
    href: '/services/microsoft-365',
    timeframe: '5-10 days',
    color: 'blue',
    deliverables: ['Risk score', 'Top 20 fixes', '30/60/90 roadmap'],
  },
  {
    id: 'conditional-access',
    title: 'Conditional Access Hardening',
    description: 'Zero-trust access controls with properly configured policies.',
    href: '/services/microsoft-365/conditional-access',
    timeframe: '1-2 weeks',
    color: 'blue',
    deliverables: ['CA policy set', 'Emergency access', 'Testing docs'],
  },
  {
    id: 'intune-baseline',
    title: 'Intune Baseline Setup',
    description: 'Modern endpoint management with security-first configuration.',
    href: '/services/intune',
    timeframe: '2-4 weeks',
    color: 'blue',
    deliverables: ['Security baselines', 'Compliance policies', 'App deployment'],
  },
  {
    id: 'copilot-prep',
    title: 'Copilot Readiness',
    description: 'Prepare your environment for safe and effective Copilot deployment.',
    href: '/services/ai-services/copilot',
    timeframe: '2-3 weeks',
    color: 'purple',
    deliverables: ['Permissions review', 'Data hygiene', 'Pilot plan'],
  },
  {
    id: 'unifi-deploy',
    title: 'UniFi Network Deploy',
    description: 'Enterprise-grade UniFi infrastructure with VLAN segmentation and security.',
    href: '/services/networking/unifi',
    timeframe: '1-2 weeks',
    color: 'orange',
    deliverables: ['Network design', 'VLAN setup', 'Documentation'],
  },
];

// Testimonials
const testimonials = [
  {
    quote: "Centrix transformed our security posture. We went from firefighting alerts to proactive threat prevention.",
    author: "IT Director",
    company: "Financial Services Firm",
  },
  {
    quote: "Fixed scope, clear deliverables, no surprises. Exactly what we needed from a security partner.",
    author: "CTO",
    company: "Manufacturing Company",
  },
];

// Process steps
const processSteps = [
  {
    step: 1,
    title: 'Scope',
    description: 'Fixed requirements, clear deliverables, agreed price',
  },
  {
    step: 2,
    title: 'Deliver',
    description: 'We execute with regular updates and no surprises',
  },
  {
    step: 3,
    title: 'Handover',
    description: 'Documentation, knowledge transfer, and support',
  },
  {
    step: 4,
    title: 'Support',
    description: 'Optional ongoing management or on-demand help',
  },
];

// FAQs
const faqs = [
  {
    question: 'How does fixed-scope pricing work?',
    answer: 'We agree on deliverables, timeline, and price upfront. No hourly billing, no scope creep. If requirements change, we discuss it openly and adjust together.',
  },
  {
    question: 'What if we need something not listed?',
    answer: 'Our catalogue covers the most common needs, but we regularly handle custom requests. Book a call and we\'ll scope it properly.',
  },
  {
    question: 'How quickly can you start?',
    answer: 'Most projects can start within 1-2 weeks. For urgent security needs like incident response, we offer priority scheduling.',
  },
  {
    question: 'Do you work with businesses outside Ireland?',
    answer: 'Yes. While we\'re based in Ireland, we work with clients across the UK and EU. Network deployments require on-site presence.',
  },
];
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="container-wide">
      <div class="hero-content">
        <h1 class="hero-title">
          Security, Microsoft, AI & Networks.<br/>
          <span class="gradient-text">Fixed scope. Clear outcomes.</span>
        </h1>
        <p class="hero-description">
          We help Irish businesses secure their technology with productized services.
          Know exactly what you'll get, what it costs, and when it's done.
        </p>
        <div class="hero-actions">
          <a href="/contact" class="btn btn-primary btn-lg">
            Book a 15-Minute Fit Check
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="#pricing" class="btn btn-secondary btn-lg">View Pricing</a>
        </div>
      </div>

      <!-- 4 Pillars Grid -->
      <div class="pillars-grid">
        {pillars.map((pillar) => (
          <a href={pillar.href} class={`pillar-card pillar-${pillar.color}`}>
            <div class={`pillar-icon icon-box icon-box-${pillar.color}`}>
              {pillar.icon === 'shield' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
                </svg>
              )}
              {pillar.icon === 'microsoft' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="8" height="8" rx="1"/>
                  <rect x="13" y="3" width="8" height="8" rx="1"/>
                  <rect x="3" y="13" width="8" height="8" rx="1"/>
                  <rect x="13" y="13" width="8" height="8" rx="1"/>
                </svg>
              )}
              {pillar.icon === 'ai' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z"/>
                </svg>
              )}
              {pillar.icon === 'network' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 011.06 0z"/>
                </svg>
              )}
            </div>
            <div class="pillar-content">
              <h3 class="pillar-title">{pillar.title}</h3>
              <p class="pillar-desc">{pillar.description}</p>
            </div>
            <svg class="pillar-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 6 Hero Offers Section -->
  <section class="offers-section">
    <div class="container-wide">
      <div class="section-header">
        <div class="section-eyebrow">Featured Services</div>
        <h2 class="section-title">Start here</h2>
        <p class="section-desc">Our most popular engagements. Fixed scope, clear deliverables, predictable pricing.</p>
      </div>

      <div class="offers-grid">
        {heroOffers.map((offer) => (
          <a href={offer.href} class="offer-card">
            <div class="offer-header">
              <span class={`offer-badge offer-badge-${offer.color}`}>{offer.timeframe}</span>
            </div>
            <h3 class="offer-title">{offer.title}</h3>
            <p class="offer-desc">{offer.description}</p>
            <ul class="offer-deliverables">
              {offer.deliverables.map((d) => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
                  {d}
                </li>
              ))}
            </ul>
            <span class="offer-link">
              Learn more
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>

      <div class="offers-cta">
        <a href="/services" class="btn btn-secondary">View All Services</a>
      </div>
    </div>
  </section>

  <!-- Proof Section -->
  <section class="proof-section">
    <div class="container-wide">
      <div class="proof-grid">
        <!-- Partner Badges -->
        <div class="proof-partners">
          <h3 class="proof-label">Certified Partner</h3>
          <div class="partner-badges">
            <div class="partner-badge">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="8" height="8" rx="1"/>
                <rect x="13" y="3" width="8" height="8" rx="1"/>
                <rect x="3" y="13" width="8" height="8" rx="1"/>
                <rect x="13" y="13" width="8" height="8" rx="1"/>
              </svg>
              <span>Microsoft Partner</span>
            </div>
            <div class="partner-badge">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0"/>
              </svg>
              <span>UniFi Certified</span>
            </div>
          </div>
        </div>

        <!-- Testimonials -->
        <div class="proof-testimonials">
          {testimonials.map((t) => (
            <div class="testimonial-card">
              <div class="testimonial-rating">
                {[...Array(5)].map(() => (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                ))}
              </div>
              <blockquote class="testimonial-quote">"{t.quote}"</blockquote>
              <div class="testimonial-author">
                <span class="author-role">{t.author}</span>
                <span class="author-company">{t.company}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="process-section">
    <div class="container-wide">
      <div class="section-header">
        <div class="section-eyebrow">How It Works</div>
        <h2 class="section-title">Productized projects, not open-ended consulting</h2>
        <p class="section-desc">Every engagement follows the same clear pattern. You know what you're getting before we start.</p>
      </div>

      <div class="process-grid">
        {processSteps.map((step) => (
          <div class="process-step">
            <div class="step-number">{step.step}</div>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing Plans Section -->
  <section class="plans-section" id="pricing">
    <div class="container-wide">
      <div class="section-header">
        <div class="section-eyebrow">Recurring Plans</div>
        <h2 class="section-title">Ongoing security management</h2>
        <p class="section-desc">For organizations that want continuous protection, not just one-off projects.</p>
      </div>

      <div class="plans-grid">
        {RECURRING_PLANS.map((plan) => (
          <div class={`plan-card ${plan.featured ? 'plan-featured' : ''}`}>
            {plan.featured && <div class="plan-badge">Most Popular</div>}
            <div class="plan-header">
              <h3 class="plan-name">{plan.name}</h3>
              <p class="plan-tagline">{plan.tagline}</p>
            </div>
            <p class="plan-description">{plan.description}</p>
            <ul class="plan-includes">
              {plan.includes.slice(0, 6).map((item) => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
                  {item}
                </li>
              ))}
              {plan.includes.length > 6 && (
                <li class="plan-more">+ {plan.includes.length - 6} more</li>
              )}
            </ul>
            <a href="/contact" class="btn btn-secondary btn-full">Get a Quote</a>
          </div>
        ))}
      </div>

      <p class="plans-note">
        Not sure which plan? <a href="/contact">Book a call</a> and we'll help you choose.
      </p>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq-section">
    <div class="container-wide">
      <div class="section-header">
        <div class="section-eyebrow">FAQ</div>
        <h2 class="section-title">Common questions</h2>
      </div>

      <div class="faq-grid">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">
              {faq.question}
              <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <p class="faq-answer">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container-wide">
      <div class="cta-card">
        <div class="cta-glow"></div>
        <div class="cta-content">
          <h2 class="cta-title">Ready to get started?</h2>
          <p class="cta-description">Book a 15-minute call. We'll discuss your needs and recommend the right approach.</p>
          <div class="cta-actions">
            <a href="/contact" class="btn btn-primary btn-lg">
              Book Consultation
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/contact" class="btn btn-secondary btn-lg">Request a Quote</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding: 6rem 0 3rem;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .hero { padding: 8rem 0 4rem; }
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 50% at 50% -20%, rgba(37, 99, 235, 0.12), transparent),
      radial-gradient(ellipse 60% 40% at 100% 50%, rgba(139, 92, 246, 0.08), transparent);
    z-index: -1;
  }

  .hero-content {
    text-align: center;
    max-width: 48rem;
    margin: 0 auto 3rem;
  }

  .hero-title {
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .hero-title { font-size: 3rem; }
  }

  @media (min-width: 1024px) {
    .hero-title { font-size: 3.5rem; }
  }

  .hero-description {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 2rem;
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  /* Pillars Grid */
  .pillars-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .pillars-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .pillars-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .pillar-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: 0.75rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .pillar-card:hover {
    border-color: var(--brand-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .pillar-icon {
    flex-shrink: 0;
  }

  .pillar-content {
    flex: 1;
    min-width: 0;
  }

  .pillar-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .pillar-desc {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    line-height: 1.4;
    display: none;
  }

  @media (min-width: 1024px) {
    .pillar-card {
      flex-direction: column;
      text-align: center;
      padding: 1.5rem;
    }
    .pillar-desc { display: block; }
    .pillar-arrow { display: none; }
  }

  .pillar-arrow {
    flex-shrink: 0;
    color: var(--text-tertiary);
    transition: transform 0.2s ease;
  }

  .pillar-card:hover .pillar-arrow {
    transform: translateX(4px);
  }

  /* Offers Section */
  .offers-section {
    padding: 4rem 0;
    background-color: var(--bg-secondary);
  }

  @media (min-width: 768px) {
    .offers-section { padding: 5rem 0; }
  }

  .offers-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .offers-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .offers-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .offer-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: 1rem;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .offer-card:hover {
    border-color: var(--brand-primary);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .offer-header {
    margin-bottom: 0.75rem;
  }

  .offer-badge {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 500;
    border-radius: 9999px;
    background-color: var(--bg-tertiary);
    color: var(--text-secondary);
  }

  .offer-badge-green {
    background-color: rgba(34, 197, 94, 0.1);
    color: var(--success);
  }

  .offer-badge-blue {
    background-color: rgba(37, 99, 235, 0.1);
    color: var(--brand-primary);
  }

  .offer-badge-purple {
    background-color: rgba(139, 92, 246, 0.1);
    color: var(--accent-purple);
  }

  .offer-badge-orange {
    background-color: rgba(249, 115, 22, 0.1);
    color: var(--accent-orange);
  }

  .offer-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .offer-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .offer-deliverables {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    flex: 1;
  }

  .offer-deliverables li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    padding: 0.25rem 0;
  }

  .offer-deliverables svg {
    flex-shrink: 0;
    color: var(--success);
  }

  .offer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--brand-primary);
    transition: gap 0.2s ease;
  }

  .offer-card:hover .offer-link {
    gap: 0.625rem;
  }

  .offers-cta {
    text-align: center;
    margin-top: 2rem;
  }

  /* Proof Section */
  .proof-section {
    padding: 4rem 0;
    border-top: 1px solid var(--border-primary);
    border-bottom: 1px solid var(--border-primary);
  }

  .proof-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .proof-grid { grid-template-columns: 1fr 2fr; gap: 4rem; }
  }

  .proof-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-tertiary);
    margin-bottom: 1rem;
  }

  .partner-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .partner-badge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1.25rem;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: 0.5rem;
    color: var(--text-secondary);
  }

  .partner-badge span {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .proof-testimonials {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .proof-testimonials { grid-template-columns: repeat(2, 1fr); }
  }

  .testimonial-card {
    padding: 1.5rem;
    background-color: var(--bg-primary);
