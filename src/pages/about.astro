---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteIcon from '../components/SiteIcon.astro';

const title = 'About Centrix';
const description = 'Centrix is an Irish business IT, technology, and consultancy company based in Duleek, County Meath.';

const values = [
  {
    title: 'Practical advice',
    description: 'Recommendations are tied to business impact, budget, risk, and what your team can operate.',
    icon: 'check',
  },
  {
    title: 'Trusted platforms',
    description: 'Centrix focuses on proven technology including Microsoft cloud, UniFi, Google, secure network platforms, Cloudflare, ChatGPT, Claude, Defender, Intune, and Copilot.',
    icon: 'microsoft',
  },
  {
    title: 'Security by default',
    description: 'Identity, devices, data, networks, backups, and incident response are considered in every project.',
    icon: 'shield',
  },
  {
    title: 'Clear handover',
    description: 'Work is documented so your business understands what changed, why it changed, and how to support it.',
    icon: 'compliance',
  },
];

const facts = [
  { label: 'Established', value: '2018' },
  { label: 'Base', value: 'Duleek, Co. Meath' },
  { label: 'Focus', value: 'UniFi, Microsoft, Security, AI' },
  { label: 'Approach', value: 'Practical consultancy' },
];
---

<BaseLayout title={title} description={description}>
  <main class="consult-page">
    <section class="consult-subhero">
      <div class="container-wide">
        <div class="consult-subhero-grid">
          <div>
            <div class="consult-eyebrow">About Centrix</div>
            <h1 class="consult-subhero-title">Irish business IT, technology, and consultancy since 2018.</h1>
            <p class="consult-lead">
              Based in Duleek, County Meath, Centrix helps businesses make better technology decisions, modernise Microsoft environments, improve premises networks, strengthen security, and adopt AI in a controlled way.
            </p>
            <div class="consult-actions">
              <a href="/contact" class="consult-btn consult-btn-primary">
                Work with Centrix
                <SiteIcon name="arrow-right" size={18} />
              </a>
              <a href="/services" class="consult-btn consult-btn-secondary">View services</a>
            </div>
          </div>
          <aside class="consult-proof-panel">
            <h2>Focus areas</h2>
            <ul>
              <li><SiteIcon name="check" size={18} /><span>Microsoft cloud and modern work</span></li>
              <li><SiteIcon name="check" size={18} /><span>UniFi, business networking, VPNs, VoIP, Wi-Fi, and CCTV</span></li>
              <li><SiteIcon name="check" size={18} /><span>Security and compliance readiness</span></li>
              <li><SiteIcon name="check" size={18} /><span>Practical AI and automation</span></li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    <section class="consult-band" aria-label="Centrix facts">
      <div class="container-wide">
        <div class="consult-band-grid">
          {facts.map((fact) => (
            <div class="consult-band-item">
              <strong>{fact.value}</strong>
              <span>{fact.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="consult-section">
      <div class="container-wide">
        <div class="consult-section-heading">
          <span class="consult-kicker">How We Think</span>
          <h2>Good technology should be reliable, secure, understandable, and useful.</h2>
          <p>
            The goal is not to add more tools. The goal is to make the right tools work properly for the business.
          </p>
        </div>
        <div class="consult-card-grid four">
          {values.map((value) => (
            <div class="consult-card">
              <div class="consult-card-icon"><SiteIcon name={value.icon} size={24} /></div>
              <h3>{value.title}</h3>
              <p>{value.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="consult-section consult-section-muted">
      <div class="container-wide">
        <div class="consult-split">
          <div>
            <span class="consult-kicker">Local And Capable</span>
            <h2>Support for the full technology picture.</h2>
            <p>
              Centrix can help when a business is moving to Microsoft cloud, opening or upgrading a premises, improving security controls, responding to supplier requirements, or exploring AI.
            </p>
          </div>
          <div class="consult-check-list">
            <div class="consult-check-item"><SiteIcon name="check" size={18} /><span>Cloud consultancy and migration planning</span></div>
            <div class="consult-check-item"><SiteIcon name="check" size={18} /><span>UniFi, network, VPN, VoIP, resilience, and CCTV design for business premises</span></div>
            <div class="consult-check-item"><SiteIcon name="check" size={18} /><span>Microsoft 365 security and device management</span></div>
            <div class="consult-check-item"><SiteIcon name="check" size={18} /><span>Security improvement roadmaps and readiness evidence</span></div>
            <div class="consult-check-item"><SiteIcon name="check" size={18} /><span>ChatGPT, Claude, Copilot, AI policy, and automation pilots</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="consult-cta">
      <div class="container-wide">
        <div class="consult-cta-inner">
          <div>
            <span class="consult-kicker">Talk To Us</span>
            <h2>Bring Centrix into the conversation before the next technology decision becomes urgent.</h2>
          </div>
          <a href="/contact" class="consult-btn consult-btn-primary">
            Contact Centrix
            <SiteIcon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
