---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from './FormattedDate.astro';
import SiteIcon from './SiteIcon.astro';
import { NEWS_PAGE_SIZE, newsPageUrl } from '../lib/news';

interface Props {
  featuredPost?: CollectionEntry<'news'>;
  recentPosts: CollectionEntry<'news'>[];
  currentPage: number;
  totalPages: number;
  totalPosts: number;
}
const { featuredPost, recentPosts, currentPage, totalPages, totalPosts } = Astro.props;
const title = currentPage === 1 ? 'Centrix Insights & News' : `Centrix Insights & News – Page ${currentPage}`;
const description = 'Centrix follows the latest AI, cybersecurity and networking developments to help businesses of every size choose and implement practical technology improvements.';
---

<BaseLayout title={title} description={description}>
  <main class="consult-page">
    <section class="consult-subhero">
      <div class="container-wide">
        <div class="consult-subhero-grid">
          <div>
            <div class="consult-eyebrow">Centrix Insights &amp; News</div>
            <h1 class="consult-subhero-title">Centrix brings the latest technology to your business.</h1>
            <p class="consult-lead">
              Centrix keeps a close eye on the market, from the latest AI tools and Microsoft security to UniFi networking and Irish cyber policy. We turn cutting-edge developments into practical improvements for businesses of every size, helping you choose what fits, plan the change, and put it to work.
            </p>
          </div>
          <aside class="consult-proof-panel">
            <h2>How Centrix can help</h2>
            <ul>
              <li><SiteIcon name="check" size={18} /><span>Strengthen Microsoft 365 security and cloud services</span></li>
              <li><SiteIcon name="check" size={18} /><span>Improve business networks, Wi-Fi, and CCTV</span></li>
              <li><SiteIcon name="check" size={18} /><span>Prepare for cyber risks and build staff awareness</span></li>
              <li><SiteIcon name="check" size={18} /><span>Introduce AI with clear goals and sensible controls</span></li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    {currentPage === 1 && featuredPost && (
      <section class="consult-section">
        <div class="container-wide">
          <a href={`/news/${featuredPost.id}/`} class="news-featured">
            <div class="news-featured-image">
              {featuredPost.data.heroImage && <img src={featuredPost.data.heroImage} alt={featuredPost.data.title} loading="eager" />}
            </div>
            <div class="news-featured-content">
              <span class="consult-kicker">Featured</span>
              <h2>{featuredPost.data.title}</h2>
              <p>{featuredPost.data.description}</p>
              <span class="news-meta">
                {featuredPost.data.sourceLogo && <img src={featuredPost.data.sourceLogo} alt="" loading="lazy" />}
                {featuredPost.data.sourceName && <span>{featuredPost.data.sourceName}</span>}
                <FormattedDate date={featuredPost.data.pubDate} />
              </span>
              <span class="consult-card-link">
                Read article
                <SiteIcon name="arrow-right" size={16} />
              </span>
            </div>
          </a>
        </div>
      </section>
    )}

    <section id="news-articles" class={`consult-section ${currentPage === 1 && featuredPost ? 'consult-section-muted' : ''}`}>
      <div class="container-wide">
        <div class="consult-section-heading">
          <span class="consult-kicker">Latest</span>
          <h2>{currentPage === 1 ? "Latest insights and updates" : "More insights and updates"}</h2>
          <p>Showing {(currentPage - 1) * NEWS_PAGE_SIZE + 1}–{Math.min(currentPage * NEWS_PAGE_SIZE, totalPosts)} of {totalPosts} articles</p>
        </div>
        <div class="consult-card-grid three">
          {recentPosts.map((post) => (
            <a href={`/news/${post.id}/`} class="consult-card news-card">
              {post.data.heroImage && (
                <img src={post.data.heroImage} alt={post.data.title} loading="lazy" />
              )}
              <span class="news-meta">
                {post.data.sourceLogo && <img src={post.data.sourceLogo} alt="" loading="lazy" />}
                {post.data.sourceName && <span>{post.data.sourceName}</span>}
                <FormattedDate date={post.data.pubDate} />
              </span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="consult-card-link">
                Read more
                <SiteIcon name="arrow-right" size={16} />
              </span>
            </a>
          ))}
        </div>
        {totalPages > 1 && (
          <nav class="news-pagination" aria-label="News pagination">
            {currentPage > 1 && <a href={`${newsPageUrl(currentPage - 1)}#news-articles`} rel="prev" class="news-page-link">Previous</a>}
            <div class="news-page-numbers">
              {Array.from({ length: totalPages }, (_, index) => index + 1).map((number) => (
                <a href={`${newsPageUrl(number)}#news-articles`} class="news-page-link" aria-label={`Page ${number}`} aria-current={number === currentPage ? 'page' : undefined}>{number}</a>
              ))}
            </div>
            {currentPage < totalPages && <a href={`${newsPageUrl(currentPage + 1)}#news-articles`} rel="next" class="news-page-link">Next</a>}
          </nav>
        )}
      </div>
    </section>

    <section class="consult-cta">
      <div class="container-wide">
        <div class="consult-cta-inner">
          <div>
            <span class="consult-kicker">Need Advice?</span>
            <h2>Find the right next step for your business.</h2>
          </div>
          <a href="/contact" class="consult-btn consult-btn-primary">
            Talk to Centrix
            <SiteIcon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .news-featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid var(--border-primary);
    border-radius: 0.5rem;
    background: var(--bg-primary);
    color: var(--text-secondary);
    text-decoration: none;
    box-shadow: var(--shadow-xs);
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
  }

  .news-featured:hover {
    border-color: var(--brand-primary);
    color: var(--text-secondary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .news-featured-image {
    position: relative;
    min-width: 0;
    min-height: 22rem;
    background: #0c323e;
  }

  .news-featured-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .news-card > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .news-featured-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem;
  }

  .news-featured-content h2 {
    margin: 0.65rem 0 0.8rem;
    color: var(--text-primary);
    font-size: clamp(1.65rem, 3vw, 2.5rem);
    line-height: 1.16;
    letter-spacing: 0;
  }

  .news-featured-content p {
    margin: 0;
    color: var(--text-secondary);
  }

  .news-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    margin-top: 1rem;
    color: var(--text-tertiary);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .news-meta img {
    width: 1.15rem;
    height: 1.15rem;
    object-fit: contain;
  }

  .news-card {
    padding: 0;
    overflow: hidden;
  }

  .news-card > img {
    aspect-ratio: 16 / 10;
    height: auto;
    border-bottom: 1px solid var(--border-primary);
  }

  .news-card .news-meta,
  .news-card h3,
  .news-card p,
  .news-card .consult-card-link {
    margin-left: 1.25rem;
    margin-right: 1.25rem;
  }

  .news-card .consult-card-link {
    margin-bottom: 1.25rem;
  }

  #news-articles { scroll-margin-top: calc(var(--header-height) + 1rem); }

  .news-pagination, .news-page-numbers { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 0.5rem; }
  .news-pagination { margin-top: 2.5rem; gap: 1rem; }
  .news-page-link { display: inline-flex; align-items: center; justify-content: center; min-width: 2.75rem; min-height: 2.75rem; padding: 0.5rem 0.85rem; border: 1px solid var(--border-primary); border-radius: 0.5rem; background: var(--bg-primary); color: var(--text-primary); text-decoration: none; font-weight: 600; }
  .news-page-link:hover { border-color: var(--brand-primary); }
  .news-page-link[aria-current="page"] { background: var(--brand-primary); border-color: var(--brand-primary); color: white; }
  .news-page-link:focus-visible { outline: 2px solid var(--brand-primary); outline-offset: 3px; }

  @media (max-width: 820px) {
    .news-featured {
      grid-template-columns: 1fr;
    }

    .news-featured-image {
      min-height: 14rem;
    }

    .news-featured-content {
      padding: 1.35rem;
    }
  }
</style>
