---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImagePlaceholder from './ImagePlaceholder.astro';
import SiteIcon from './SiteIcon.astro';
import { COMPANY_INFO } from '../consts';
import type { UniFiLandingPageData } from '../data/unifiPages';

interface Props {
  page: UniFiLandingPageData;
}

const { page } = Astro.props;
const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const organizationId = new URL('/#organization', siteOrigin).toString();

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: COMPANY_INFO.name,
      url: new URL('/', siteOrigin).toString(),
      email: COMPANY_INFO.email,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Duleek',
        addressRegion: 'County Meath',
        addressCountry: 'IE',
      },
      areaServed: {
        '@type': 'Country',
        name: 'Ireland',
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: page.metaTitle,
      description: page.metaDescription,
      isPartOf: {
        '@type': 'WebSite',
        name: 'Centrix',
        url: new URL('/', siteOrigin).toString(),
      },
      about: {
        '@id': `${canonicalUrl}#service`,
      },
    },
    {
      '@type': 'Service',
      '@id': `${canonicalUrl}#service`,
      name: page.heading,
      serviceType: page.serviceType,
      description: page.lead,
      provider: {
        '@id': organizationId,
      },
      areaServed: {
        '@type': 'Country',
        name: 'Ireland',
      },
      brand: {
        '@type': 'Brand',
        name: 'Ubiquiti UniFi',
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: page.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: new URL('/', siteOrigin).toString(),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Networking',
          item: new URL('/networks', siteOrigin).toString(),
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: page.eyebrow,
          item: canonicalUrl,
        },
      ],
    },
  ],
};
---

<BaseLayout title={page.metaTitle} description={page.metaDescription} image="/products/unifi.png">
  <article class="consult-page">
    <section class="consult-subhero">
      <div class="container-wide">
        <div class="consult-subhero-grid">
          <div>
            <div class="consult-eyebrow">{page.eyebrow}</div>
            <h1 class="consult-subhero-title">{page.heading}</h1>
            <p class="consult-lead">{page.lead}</p>
            <div class="consult-actions">
              <a href={page.primaryCta.href} class="consult-btn consult-btn-primary">
                {page.primaryCta.label}
                <SiteIcon name="arrow-right" size={18} />
              </a>
              <a href={page.secondaryCta.href} class="consult-btn consult-btn-secondary">{page.secondaryCta.label}</a>
            </div>
          </div>

          <aside class="consult-proof-panel" aria-label="UniFi service highlights">
            <h2>{page.proofTitle ?? 'What Centrix can cover'}</h2>
            <ul>
              {page.proof.map((item) => (
                <li>
                  <SiteIcon name="check" size={18} />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </aside>
        </div>
      </div>
    </section>

    <section class="consult-section compact">
      <div class="container-wide">
        <ImagePlaceholder
          label={`${page.eyebrow} imagery`}
          src="/products/unifi.png"
          icon="network"
          ratio="16 / 6"
        />
      </div>
    </section>

    <section class="consult-section">
      <div class="container-wide">
        <div class="consult-section-heading">
          <span class="consult-kicker">Outcomes</span>
          <h2>{page.outcomesTitle}</h2>
          {page.outcomesIntro && <p>{page.outcomesIntro}</p>}
        </div>
        <div class="consult-card-grid three">
          {page.outcomes.map((outcome) => (
            <div class="consult-card">
              <div class="consult-card-icon"><SiteIcon name={outcome.icon || 'network'} size={24} /></div>
              <h3>{outcome.title}</h3>
              <p>{outcome.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="consult-section consult-section-muted">
      <div class="container-wide">
        <div class="consult-split">
          <div>
            <span class="consult-kicker">Included</span>
            <h2>{page.includedTitle}</h2>
            <p>{page.includedText}</p>
            <p class="consult-note">
              Centrix is an independent Irish IT consultancy. Ubiquiti and UniFi are third-party product names; this page does not claim official distributor or authorised reseller status.
            </p>
          </div>
          <div class="consult-check-list">
            {page.includes.map((item) => (
              <div class="consult-check-item">
                <SiteIcon name="check" size={18} />
                <span>{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="consult-section">
      <div class="container-wide">
        <div class="consult-split">
          <div>
            <span class="consult-kicker">Best Fit</span>
            <h2>{page.fitTitle}</h2>
            <p>{page.fitText}</p>
          </div>
          <div class="consult-pill-list">
            {page.fitItems.map((item) => (
              <div class="consult-pill-item">
                <SiteIcon name="check" size={17} />
                <span>{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="consult-section consult-section-muted">
      <div class="container-wide">
        <div class="consult-section-heading">
          <span class="consult-kicker">Process</span>
          <h2>How the work runs</h2>
        </div>
        <div class="consult-steps">
          {page.process.map((step, index) => (
            <div class="consult-step">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="consult-section">
      <div class="container-wide">
        <div class="consult-section-heading">
          <span class="consult-kicker">Questions</span>
          <h2>Common questions</h2>
        </div>
        <div class="consult-faq-grid">
          {page.faqs.map((faq) => (
            <div class="consult-faq">
              <h3>{faq.question}</h3>
              <p>{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="consult-cta">
      <div class="container-wide">
        <div class="consult-cta-inner">
          <div>
            <span class="consult-kicker">Next Step</span>
            <h2>Talk to Centrix about secure UniFi Wi-Fi, CCTV, VLANs, guest networks, and support.</h2>
          </div>
          <a href={page.primaryCta.href} class="consult-btn consult-btn-primary">
            {page.primaryCta.label}
            <SiteIcon name="arrow-right" size={18} />
          </a>
        </div>
        <div class="consult-related">
          {page.related.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </div>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </article>
</BaseLayout>
