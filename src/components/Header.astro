---
import ThemeToggle from './ThemeToggle.astro';
import MegaMenu from './MegaMenu.astro';
---

<header class="header" id="main-header">
  <div class="header-container">
    <!-- Logo -->
    <a href="/" class="logo" aria-label="Centrix Home">
      <svg class="logo-icon" width="24" height="24" viewBox="0 0 24 24" fill="none">
        <rect width="24" height="24" rx="4" fill="currentColor"/>
        <path d="M6 9l6-3 6 3v6l-6 3-6-3V9z" stroke="white" stroke-width="1.5" fill="none"/>
        <path d="M12 6v12M6 9l12 6M18 9l-12 6" stroke="white" stroke-width="1.5" stroke-opacity="0.5"/>
      </svg>
      <span class="logo-text">Centrix</span>
    </a>

    <!-- Desktop Navigation with Mega Menu -->
    <MegaMenu />

    <!-- Actions -->
    <div class="header-actions">
      <ThemeToggle />
      <a href="/contact" class="header-cta">
        Get Started
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--header-bg);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid transparent;
    height: 3.5rem;
    transition: border-color 0.15s ease;
  }

  .header.scrolled {
    border-bottom-color: var(--header-border);
  }

  .header-container {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .header-container {
      padding: 0 2rem;
    }
  }

  /* Logo */
  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    flex-shrink: 0;
    color: var(--brand-primary);
  }

  .logo:hover {
    text-decoration: none;
  }

  .logo-icon {
    transition: transform 0.15s ease;
  }

  .logo:hover .logo-icon {
    transform: scale(1.05);
  }

  .logo-text {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  /* Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .header-cta {
    display: none;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 500;
    border-radius: 0.375rem;
    text-decoration: none;
    background-color: var(--brand-primary);
    color: white;
    transition: background-color 0.15s ease;
  }

  .header-cta:hover {
    background-color: var(--brand-hover);
    color: white;
  }

  @media (min-width: 640px) {
    .header-cta {
      display: inline-flex;
    }
  }
</style>

<script>
  function initHeader() {
    const header = document.getElementById('main-header');

    function handleScroll() {
      if (window.scrollY > 10) {
        header?.classList.add('scrolled');
      } else {
        header?.classList.remove('scrolled');
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  initHeader();
  document.addEventListener('astro:after-swap', initHeader);
</script>
