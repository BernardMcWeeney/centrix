---
import SiteIcon from './SiteIcon.astro';

const serviceGroups = [
  {
    title: 'Microsoft & Cloud',
    links: [
      { label: 'Microsoft Services', description: 'M365, Azure, Intune, Defender', href: '/microsoft', icon: 'microsoft' },
      { label: 'Cloud Migration', description: 'Email, files, identity, devices', href: '/services/microsoft-365/cloud-migration', icon: 'cloud' },
      { label: 'Microsoft 365 Security', description: 'MFA, Conditional Access, Defender', href: '/services/microsoft-365', icon: 'lock' },
    ],
  },
  {
    title: 'Networking & Premises',
    links: [
      { label: 'Business Networking', description: 'Wi-Fi, VPNs, voice, CCTV', href: '/networks', icon: 'network' },
      { label: 'VPN & Remote Access', description: 'Point-to-point and remote users', href: '/services/networking/vpn-remote-access', icon: 'lock' },
      { label: 'Backup & Resilience', description: 'Failover, backups, and DR', href: '/services/networking/backup-resilience', icon: 'cloud' },
      { label: 'VoIP & Phones', description: 'Business telephone setup', href: '/services/networking/voip-business-phones', icon: 'phone' },
    ],
  },
  {
    title: 'Security & AI',
    links: [
      { label: 'Security', description: 'Controls, reviews, incident readiness', href: '/security', icon: 'shield' },
      { label: 'NIS2 & GDPR Readiness', description: 'Technical controls and evidence', href: '/services/security/nis2-gdpr-readiness', icon: 'compliance' },
      { label: 'AI Introduction', description: 'Claude, ChatGPT, Copilot, Cloudflare', href: '/ai', icon: 'ai' },
    ],
  },
];

const primaryLinks = [
  { label: 'Microsoft', href: '/microsoft' },
  { label: 'Networking', href: '/networks' },
  { label: 'Security', href: '/security' },
  { label: 'AI', href: '/ai' },
  { label: 'Case Studies', href: '/case-studies' },
  { label: 'News', href: '/news' },
];
---

<div class="mega-menu">
  <nav class="desktop-nav" aria-label="Primary navigation">
    <div class="nav-group">
      <button class="nav-link nav-trigger" type="button" aria-haspopup="true" aria-expanded="false">
        Services
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>

      <div class="mega-panel" role="region" aria-label="Services menu">
        <div class="mega-shell">
          <div class="mega-grid">
            {serviceGroups.map((group) => (
              <div class="mega-column">
                <h3>{group.title}</h3>
                <div class="mega-list">
                  {group.links.map((link) => (
                    <a href={link.href} class="mega-card">
                      <span class="mega-icon"><SiteIcon name={link.icon} size={20} /></span>
                      <span class="mega-text">
                        <strong>{link.label}</strong>
                        <small>{link.description}</small>
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
          <div class="mega-footer">
            <a href="/services">
              View all services
              <SiteIcon name="arrow-right" size={16} />
            </a>
            <a href="/contact">
              Book a consultation
              <SiteIcon name="arrow-right" size={16} />
            </a>
          </div>
        </div>
      </div>
    </div>

    {primaryLinks.map((link) => (
      <a href={link.href} class="nav-link">{link.label}</a>
    ))}
  </nav>

  <details class="mobile-nav">
    <summary aria-label="Open navigation menu">
      <svg class="icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
      </svg>
      <svg class="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12" stroke-linecap="round"></path>
      </svg>
    </summary>

    <div class="mobile-panel">
      <a href="/services" class="mobile-section-link">Services</a>
      {serviceGroups.map((group) => (
        <div class="mobile-group">
          <span>{group.title}</span>
          {group.links.map((link) => (
            <a href={link.href}>
              <SiteIcon name={link.icon} size={18} />
              <span>
                <strong>{link.label}</strong>
                <small>{link.description}</small>
              </span>
            </a>
          ))}
        </div>
      ))}
      <div class="mobile-primary-list">
        {primaryLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </div>
      <a href="/contact" class="mobile-contact">Book a consultation</a>
    </div>
  </details>
</div>

<style>
  .mega-menu {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    justify-content: center;
  }

  .desktop-nav {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
  }

  .nav-group {
    position: relative;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 2.25rem;
    padding: 0.45rem 0.62rem;
    border: 0;
    border-radius: 0.375rem;
    background: transparent;
    color: var(--text-secondary);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    background: var(--bg-secondary);
    color: var(--text-primary);
    text-decoration: none;
    outline: none;
  }

  .nav-group:hover .nav-trigger,
  .nav-group:focus-within .nav-trigger {
    background: var(--bg-secondary);
    color: var(--text-primary);
  }

  .mega-panel {
    position: absolute;
    top: 100%;
    left: 50%;
    z-index: 150;
    width: min(58rem, calc(100vw - 2rem));
    padding-top: 0.65rem;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 0.25rem);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .nav-group:hover .mega-panel,
  .nav-group:focus-within .mega-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .mega-shell {
    overflow: hidden;
    border: 1px solid var(--border-primary);
    border-radius: 0.5rem;
    background: var(--bg-elevated);
    box-shadow: var(--shadow-xl);
  }

  .mega-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    padding: 1rem;
  }

  .mega-column {
    min-width: 0;
    padding: 0 0.75rem;
    border-right: 1px solid var(--border-primary);
  }

  .mega-column:last-child {
    border-right: 0;
  }

  .mega-column h3 {
    margin: 0 0 0.65rem;
    color: var(--text-tertiary);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mega-list {
    display: grid;
    gap: 0.25rem;
  }

  .mega-card {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    min-width: 0;
    padding: 0.68rem;
    border-radius: 0.45rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .mega-card:hover,
  .mega-card:focus-visible {
    background: var(--bg-secondary);
    color: var(--text-secondary);
    text-decoration: none;
    outline: none;
  }

  .mega-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    flex: 0 0 auto;
    border-radius: 0.45rem;
    background: var(--brand-light);
    color: var(--brand-primary);
  }

  .mega-text {
    min-width: 0;
  }

  .mega-card strong {
    display: block;
    color: var(--text-primary);
    font-size: 0.88rem;
    line-height: 1.25;
  }

  .mega-card small {
    display: block;
    margin-top: 0.22rem;
    color: var(--text-tertiary);
    font-size: 0.75rem;
    line-height: 1.35;
  }

  .mega-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border-top: 1px solid var(--border-primary);
    background: var(--bg-secondary);
  }

  .mega-footer a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--brand-primary);
    font-size: 0.85rem;
    font-weight: 800;
    text-decoration: none;
  }

  .mobile-nav {
    display: block;
  }

  .mobile-nav summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid var(--border-primary);
    border-radius: 0.4rem;
    color: var(--text-primary);
    background: var(--bg-primary);
    cursor: pointer;
    list-style: none;
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav summary:hover,
  .mobile-nav summary:focus-visible {
    border-color: var(--border-secondary);
    background: var(--bg-secondary);
    outline: none;
  }

  .icon-close,
  .mobile-nav[open] .icon-open {
    display: none;
  }

  .mobile-nav[open] .icon-close {
    display: block;
  }

  .mobile-panel {
    position: fixed;
    top: 4rem;
    left: 1rem;
    right: 1rem;
    z-index: 160;
    max-height: calc(100svh - 5rem);
    overflow-y: auto;
    padding: 0.85rem;
    border: 1px solid var(--border-primary);
    border-radius: 0.5rem;
    background: var(--bg-elevated);
    box-shadow: var(--shadow-xl);
  }

  .mobile-section-link,
  .mobile-primary-list a,
  .mobile-contact {
    display: flex;
    align-items: center;
    min-height: 2.55rem;
    padding: 0.65rem 0.75rem;
    border-radius: 0.4rem;
    color: var(--text-primary);
    font-size: 0.95rem;
    font-weight: 800;
    text-decoration: none;
  }

  .mobile-section-link:hover,
  .mobile-primary-list a:hover {
    background: var(--bg-secondary);
    text-decoration: none;
  }

  .mobile-group {
    display: grid;
    gap: 0.2rem;
    margin-top: 0.55rem;
  }

  .mobile-group > span {
    padding: 0.5rem 0.75rem 0.25rem;
    color: var(--text-tertiary);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mobile-group a {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.65rem 0.75rem;
    border-radius: 0.4rem;
    color: var(--text-secondary);
    text-decoration: none;
  }

  .mobile-group a:hover {
    background: var(--bg-secondary);
    text-decoration: none;
  }

  .mobile-group svg {
    flex: 0 0 auto;
    margin-top: 0.1rem;
    color: var(--brand-primary);
  }

  .mobile-group strong {
    display: block;
    color: var(--text-primary);
    font-size: 0.9rem;
    line-height: 1.25;
  }

  .mobile-group small {
    display: block;
    margin-top: 0.18rem;
    color: var(--text-tertiary);
    font-size: 0.75rem;
    line-height: 1.35;
  }

  .mobile-primary-list {
    display: grid;
    gap: 0.1rem;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-primary);
  }

  .mobile-contact {
    justify-content: center;
    margin-top: 0.75rem;
    background: var(--brand-primary);
    color: #ffffff;
  }

  .mobile-contact:hover {
    background: var(--brand-hover);
    color: #ffffff;
  }

  @media (min-width: 1040px) {
    .desktop-nav {
      display: flex;
    }

    .mobile-nav {
      display: none;
    }
  }
</style>
